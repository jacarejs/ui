import { pulse } from '@jacare/core'
import { docsNav, docsSiteUrl, uiRepoUrl, coreRepoUrl } from './nav-data.js'
import { docsHref } from './navigate.js'
import ThemeToggle from '@jacare/ui/components/ThemeToggle.jcr'
import CommandPalette from './ui/CommandPalette.jcr'
import JacareLogo from './ui/JacareLogo.jcr'

const menuOpen = pulse(false)
const cmdOpen = pulse(false)

function toggleMenu() {
  menuOpen.update((open) => !open)
}

function closeMenu() {
  menuOpen.set(false)
}

function openSearch() {
  cmdOpen.set(true)
}

if (typeof window !== 'undefined') {
  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault()
      cmdOpen.set(true)
    }
    if (event.key === 'Escape' && menuOpen()) {
      menuOpen.set(false)
    }
  })
}

export <view>
  <a class="skip-link" href="#docs-content">Skip to content</a>

  <div class="docs-shell">
    <header class="docs-topbar">
      <button
        type="button"
        class="docs-menu-btn"
        class-is-open=${menuOpen}
        aria-label=${() => (menuOpen() ? 'Close menu' : 'Open menu')}
        aria-expanded=${menuOpen}
        aria-controls="docs-sidebar"
        on-click=${toggleMenu}
      >
        <span class="docs-menu-btn__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <a class="docs-brand docs-brand--top" jacare-go="/" href=${docsHref('/')} aria-label="Jacaré UI home">
        <JacareLogo />
        <span class="docs-brand__copy">
          <span class="docs-brand__name">Jacaré <strong>UI</strong></span>
          <span class="docs-brand__tag">Build with pulse</span>
        </span>
      </a>

      <button type="button" class="docs-search-pill" on-click=${openSearch}>
        <span>Search docs…</span>
        <kbd>⌘K</kbd>
      </button>

      <div class="docs-topbar-actions">
        <span class="docs-version">v0.1.1</span>
        <ThemeToggle />
        <a class="docs-github" href=${() => docsSiteUrl} target="_blank" rel="noreferrer">Docs</a>
        <a class="docs-github" href=${() => uiRepoUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a class="docs-github" href=${() => coreRepoUrl} target="_blank" rel="noreferrer">Core</a>
      </div>
    </header>

    <div class="docs-body">
      <aside id="docs-sidebar" class="docs-sidebar" class-is-open=${menuOpen} aria-label="Documentation">
        <button type="button" class="docs-search-trigger" on-click=${openSearch}>
          <span>Search docs</span>
          <kbd>⌘K</kbd>
        </button>

        <nav class="docs-nav">
          #for docsNav as section (section.title)
            <div class="docs-nav-group">
              <p class="docs-nav-title">${section.title}</p>
              #for section.items as item (item.href)
                <a
                  class="docs-nav-link"
                  jacare-go=${item.href}
                  href=${item.href}
                  on-click=${closeMenu}
                >
  <span class="docs-nav-label">${item.label}</span>
                  #if item.blurb
                    <span class="docs-nav-blurb">${item.blurb}</span>
                  #end
                </a>
              #end
            </div>
          #end
        </nav>
      </aside>

      <div class="docs-backdrop" class-is-open=${menuOpen} on-click=${closeMenu}></div>

      <main id="docs-content" class="docs-main" jacare-frame></main>
    </div>

    <CommandPalette :open=${cmdOpen} on-close=${() => cmdOpen.set(false)} />
  </div>
</view>
