import { pulse } from '@jacare/core'
import { docsNav } from './nav-data.js'
import ThemeToggle from '@jacare/ui/components/ThemeToggle.jcr'
import CommandPalette from './ui/CommandPalette.jcr'

const menuOpen = pulse(false)
const cmdOpen = pulse(false)

function toggleMenu() {
  menuOpen.update((open) => !open)
}

function closeMenu() {
  menuOpen.set(false)
}

function openSearch() {
  cmdOpen.set(true)
}

if (typeof window !== 'undefined') {
  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault()
      cmdOpen.set(true)
    }
  })
}

export <view>
  <a class="skip-link" href="#docs-content">Skip to content</a>

  <div class="docs-shell">
    <header class="docs-topbar">
      <button type="button" class="docs-menu-btn" aria-label="Open menu" on-click=${toggleMenu}>
        Menu
      </button>

      <a class="docs-brand docs-brand--top" jacare-go="/" href="/" aria-label="Jacaré UI home">
        <img class="docs-brand__mark" src="/jacare-logo.png" alt="" width="40" height="40" />
        <span class="docs-brand__copy">
          <span class="docs-brand__name">Jacaré <strong>UI</strong></span>
          <span class="docs-brand__tag">Build with pulse</span>
        </span>
      </a>

      <button type="button" class="docs-search-pill" on-click=${openSearch}>
        <span>Search docs…</span>
        <kbd>⌘K</kbd>
      </button>

      <div class="docs-topbar-actions">
        <span class="docs-version">v0.1.0</span>
        <ThemeToggle />
        <a class="docs-github" href="https://jacarejs.github.io/ui/" target="_blank" rel="noreferrer">Docs</a>
        <a class="docs-github" href="https://github.com/jacarejs/ui" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </header>

    <div class="docs-body">
      <aside class="docs-sidebar" class-is-open=${menuOpen} aria-label="Documentation">
        <button type="button" class="docs-search-trigger" on-click=${openSearch}>
          <span>Search docs</span>
          <kbd>⌘K</kbd>
        </button>

        <nav class="docs-nav">
          #for docsNav as section (section.title)
            <div class="docs-nav-group">
              <p class="docs-nav-title">${section.title}</p>
              #for section.items as item (item.href)
                <a
                  class="docs-nav-link"
                  jacare-go=${item.href}
                  href=${item.href}
                  on-click=${closeMenu}
                >
                  <span class="docs-nav-label">${item.label}</span>
                  #if item.blurb
                    <span class="docs-nav-blurb">${item.blurb}</span>
                  #end
                </a>
              #end
            </div>
          #end
        </nav>
      </aside>

      <div class="docs-backdrop" class-is-open=${menuOpen} on-click=${closeMenu}></div>

      <main id="docs-content" class="docs-main" jacare-frame></main>
    </div>

    <CommandPalette :open=${cmdOpen} on-close=${() => cmdOpen.set(false)} />
  </div>
</view>
