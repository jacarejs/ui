import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Button from '@jacare/ui/components/Button.jcr'
import DocsHero from '../ui/DocsHero.jcr'
import DocsSection from '../ui/DocsSection.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext } from '../nav-data.js'
import { goDocs } from '../navigate.js'
import {
  tokenGroups,
  filterGroups,
  readToken,
  swatchStyle,
  copyToken,
} from '../token-catalog.js'

const navLinks = previousNext('/tokens')
const query = pulse('')
const copied = pulse('')

function visibleGroups() {
  return filterGroups(tokenGroups, query())
}

function hasNoMatches() {
  return visibleGroups().length === 0
}

function jumpTargets() {
  return visibleGroups().map((group) => ({ id: group.id, title: group.title }))
}

function sectionHref(id) {
  return `#${id}`
}

function copyAria(name) {
  return `Copy ${name}`
}

function isLayout(group, layout) {
  return group.layout === layout
}

async function onCopy(name) {
  const ok = await copyToken(name)
  if (!ok) return
  copied.set(name)
  setTimeout(() => {
    if (copied() === name) copied.set('')
  }, 1200)
}

function copyLabel(name) {
  return copied() === name ? 'Copied' : 'Copy'
}

export <view>
  <article class="docs-page docs-tokens-page">
    <DocsHero
      :kicker=${'Foundations'}
      :title=${'Token reference'}
      :description=${'Live catalog of --j-* brand, semantic, shape, space, and motion tokens. Switch Light / Dark in the header to compare canopy themes — every swatch and value updates from the document.'}
    />

    <div class="docs-tokens-intro docs-panel">
      <div class="docs-tokens-intro__copy">
        <p>
          Change a token once and every component that references it updates. Prefer editing brand tokens
          (<code>--j-primary</code>, <code>--j-leaf</code>) before restyling primitives.
        </p>
        <div class="docs-hero-actions">
          <Button :variant=${'primary'} :size=${'sm'} on-press=${() => goDocs('/theme-editor')}>Theme Editor</Button>
          <Button :variant=${'secondary'} :size=${'sm'} on-press=${() => goDocs('/theme')}>Theme guide</Button>
        </div>
      </div>
      <div class="docs-tokens-intro__preview" aria-hidden="true">
        <span class="docs-tokens-intro__chip" style="background:var(--j-primary)"></span>
        <span class="docs-tokens-intro__chip" style="background:var(--j-leaf)"></span>
        <span class="docs-tokens-intro__chip" style="background:var(--j-lime)"></span>
        <span class="docs-tokens-intro__chip" style="background:var(--j-mint);border:1px solid var(--j-border)"></span>
        <span class="docs-tokens-intro__chip" style="background:var(--j-surface-2);border:1px solid var(--j-border);box-shadow:var(--j-shadow-sm)"></span>
      </div>
    </div>

    <div class="docs-tokens-toolbar">
      <Field
        :label=${'Filter tokens'}
        :placeholder=${'--j-primary, radius, muted…'}
        bind-value=${query}
      />
      <nav class="docs-tokens-jump" aria-label="Token groups">
        #for jumpTargets() as link (link.id)
          <a class="docs-tokens-jump__link" href=${() => sectionHref(link.id)}>${link.title}</a>
        #end
      </nav>
    </div>

    #if hasNoMatches()
      <p class="docs-lead docs-tokens-empty">No tokens match “${() => query()}”.</p>
    #end

    #for visibleGroups() as group (group.id)
      <DocsSection :id=${group.id} :title=${group.title}>
        <p class="docs-lead docs-tokens-blurb">${group.blurb}</p>

        #if isLayout(group, 'swatches')
          <div class="docs-token-grid">
            #for group.items as item (item.name)
              <article class="docs-token-card">
                <button
                  type="button"
                  class="docs-token-card__swatch"
                  class-docs-token-card__swatch--shape=${item.kind !== 'color'}
                  :style=${() => swatchStyle(item)}
                  aria-label=${() => copyAria(item.name)}
                  on-click=${() => onCopy(item.name)}
                ></button>
                <div class="docs-token-card__body">
                  <div class="docs-token-card__row">
                    <code class="docs-token-card__name">${item.name}</code>
                    <button type="button" class="docs-token-card__copy" on-click=${() => onCopy(item.name)}>
                      ${() => copyLabel(item.name)}
                    </button>
                  </div>
                  <p class="docs-token-card__role">${item.role}</p>
                  <code class="docs-token-card__value">${() => readToken(item.name)}</code>
                </div>
              </article>
            #end
          </div>
        #elif isLayout(group, 'shape')
          <div class="docs-token-grid docs-token-grid--shape">
            #for group.items as item (item.name)
              <article class="docs-token-card docs-token-card--shape">
                <div
                  class="docs-token-shape"
                  class-docs-token-shape--radius=${item.kind === 'radius'}
                  class-docs-token-shape--shadow=${item.kind === 'shadow'}
                  class-docs-token-shape--focus=${item.kind === 'focus'}
                  :style=${() => swatchStyle(item)}
                ></div>
                <div class="docs-token-card__body">
                  <div class="docs-token-card__row">
                    <code class="docs-token-card__name">${item.name}</code>
                    <button type="button" class="docs-token-card__copy" on-click=${() => onCopy(item.name)}>
                      ${() => copyLabel(item.name)}
                    </button>
                  </div>
                  <p class="docs-token-card__role">${item.role}</p>
                  <code class="docs-token-card__value">${() => readToken(item.name)}</code>
                </div>
              </article>
            #end
          </div>
        #elif isLayout(group, 'space')
          <div class="docs-token-space">
            #for group.items as item (item.name)
              <div class="docs-token-space__row">
                <div class="docs-token-space__meta">
                  <code class="docs-token-card__name">${item.name}</code>
                  <span class="docs-token-card__role">${item.role}</span>
                  <code class="docs-token-card__value">${() => readToken(item.name)}</code>
                </div>
                <div class="docs-token-space__track">
                  <span class="docs-token-space__bar" :style=${() => swatchStyle(item)}></span>
                </div>
                <button type="button" class="docs-token-card__copy" on-click=${() => onCopy(item.name)}>
                  ${() => copyLabel(item.name)}
                </button>
              </div>
            #end
          </div>
        #else
          <div class="docs-token-grid docs-token-grid--motion">
            #for group.items as item (item.name)
              <article class="docs-token-card docs-token-card--motion">
                #if item.kind === 'font'
                  <p class="docs-token-font" :style=${() => swatchStyle(item)}>
                    The quick jacaré jumps.
                  </p>
                #else
                  <div class="docs-token-motion" :style=${() => swatchStyle(item)}>
                    <span class="docs-token-motion__dot"></span>
                  </div>
                #end
                <div class="docs-token-card__body">
                  <div class="docs-token-card__row">
                    <code class="docs-token-card__name">${item.name}</code>
                    <button type="button" class="docs-token-card__copy" on-click=${() => onCopy(item.name)}>
                      ${() => copyLabel(item.name)}
                    </button>
                  </div>
                  <p class="docs-token-card__role">${item.role}</p>
                  <code class="docs-token-card__value">${() => readToken(item.name)}</code>
                </div>
              </article>
            #end
          </div>
        #end
      </DocsSection>
    #end

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
