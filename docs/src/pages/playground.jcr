import DocsHero from '../ui/DocsHero.jcr'
import DocsSection from '../ui/DocsSection.jcr'
import CodeBlock from '../ui/CodeBlock.jcr'
import Button from '@jacare/ui/components/Button.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext } from '../nav-data.js'

const navLinks = previousNext('/playground')

const playgroundDev = `yarn playground:dev`
const docsDev = `yarn docs:dev`
const tip = `# Playground — minimal Vite sandbox for experiments
# Docs — full documentation shell with search and Theme Editor`

export <view>
  <article class="docs-page">
    <DocsHero
      :kicker=${'Tools'}
      :title=${'Playground'}
      :description=${'The package ships a local Vite playground for quick experiments without the docs shell. Use docs:dev when you want the full documentation experience, including search and the Theme Editor.'}
    />

    <DocsSection :id=${'playground'} :title=${'Local playground'}>
      <p class="docs-lead">From the package root, start the sandbox against the real theme:</p>
      <CodeBlock :code=${playgroundDev} :filename=${'terminal'} :language=${'bash'} />
    </DocsSection>

    <DocsSection :id=${'docs'} :title=${'Docs site'}>
      <p class="docs-lead">
        For the documentation shell (this site), run the docs Vite app instead:
      </p>
      <CodeBlock :code=${docsDev} :filename=${'terminal'} :language=${'bash'} />
      <CodeBlock :code=${tip} :filename=${'notes'} :language=${'bash'} />
    </DocsSection>

    <div class="docs-hero-actions">
      <a href="https://github.com/jacarejs/ui" target="_blank" rel="noreferrer">
        <Button :variant=${'secondary'}>Open repository</Button>
      </a>
    </div>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
