import Button from '@jacare/ui/components/Button.jcr'
import Field from '@jacare/ui/components/Field.jcr'
import LocaleToggle from '@jacare/ui/components/LocaleToggle.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import { pulse } from '@jacare/core'
import DocsHero from '../ui/DocsHero.jcr'
import DocsSection from '../ui/DocsSection.jcr'
import Demo from '../ui/Demo.jcr'
import CodeBlock from '../ui/CodeBlock.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext } from '../nav-data.js'
import {
  t,
  locale,
  setLocale,
} from '@jacare/ui/i18n/index.js'
import { setupI18n } from '../examples/i18n/setup.js'
import {
  bootScript,
  componentLabels,
  createI18nBoot,
  lazyLocale,
  localeEn,
  localePtBR,
  localesIndex,
  localeToggleDemo,
  treeLayout,
  useI18nHelper,
  useInTemplate,
} from '../examples/i18n.js'

setupI18n()

const navLinks = previousNext('/i18n')
const demoValue = pulse('')

export <view>
  <article class="docs-page">
    <DocsHero
      :kicker=${'Foundations'}
      :title=${'i18n'}
      :description=${'Simple translations for Jacaré apps — one locale file per language, createI18n once, t() in templates, LocaleToggle to switch. Nested keys, {params}, and a fallback locale.'}
    />

    <DocsSection :id=${'layout'} :title=${'File layout'}>
      <p class="docs-lead">
        Keep each language in its own file under <code>locales/</code>, then wire them in <code>locales/index.js</code>${' '}and pass that bag to <code>createI18n</code>.
      </p>
      <CodeBlock :code=${treeLayout} :filename=${'src/'} :language=${'text'} />
      <CodeBlock :code=${localeEn} :filename=${'locales/en.js'} :language=${'javascript'} />
      <CodeBlock :code=${localePtBR} :filename=${'locales/pt-BR.js'} :language=${'javascript'} />
      <CodeBlock :code=${localesIndex} :filename=${'locales/index.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'quick'} :title=${'Quick start'}>
      <p class="docs-lead">
        Boot with the folder messages. Dot keys like <code>app.title</code>${' '}work.
        In templates write <code>${"t('key')"}</code>${' '}— <code>t</code>${' '}returns a reactive translation (like a pulse), so no arrow wrapper is needed.
      </p>
      <CodeBlock :code=${createI18nBoot} :filename=${'i18n.js'} :language=${'javascript'} />
      <CodeBlock :code=${useInTemplate} :filename=${'app.jcr'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'live'} :title=${'Live demo'}>
      <Demo
        :id=${'i18n-live'}
        :title=${'LocaleToggle + t()'}
        :lead=${'Same folder messages as above — flip EN / PT and the UI updates.'}
        :code=${localeToggleDemo}
        :filename=${'app.jcr'}
      >
        <Stack :gap=${'md'}>
          <LocaleToggle
            :locales=${[
              { id: 'en', label: 'English' },
              { id: 'pt-BR', label: 'Português' },
            ]}
          />
          <p class="docs-lead" style="margin:0">${t('lead')}</p>
          <h3 style="margin:0">${t('app.title')}</h3>
          <p style="margin:0">${t('hello', { name: 'Jacaré' })}</p>
          <Stack :direction=${'row'} :gap=${'sm'} :wrap=${true}>
            <Button :variant=${'primary'}>${t('save')}</Button>
            <Button :variant=${'secondary'}>${t('cancel')}</Button>
            <Button :variant=${'ghost'} on-press=${() => setLocale('en')}>EN</Button>
            <Button :variant=${'ghost'} on-press=${() => setLocale('pt-BR')}>PT</Button>
          </Stack>
          <Field
            :label=${t('app.title')}
            :placeholder=${t('hello', { name: '…' })}
            :hint=${() => `locale: ${locale()}`}
            bind-value=${demoValue}
          />
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <p class="docs-lead">
        Import from <code>@jacare/ui/i18n</code>${' '}(or <code>@jacare/ui</code>).
      </p>
      <div class="docs-table-wrap">
        <table class="docs-table">
          <thead>
            <tr>
              <th>Helper</th>
              <th>What it does</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>createI18n(options)</code></td>
              <td>Create the app instance (call once). Options: <code>locale</code>, <code>fallbackLocale</code>, <code>messages</code>, <code>persist</code>.</td>
            </tr>
            <tr>
              <td><code>t(key, params?)</code></td>
              <td>Returns a reactive translation (call it like a pulse). Use as <code>${"t('key')"}</code>${' '}or <code>${":title=\${t('key')}"}</code>.</td>
            </tr>
            <tr>
              <td><code>translate(key, params?)</code></td>
              <td>Immediate string for scripts/logs — same as <code>t(key, params)()</code>.</td>
            </tr>
            <tr>
              <td><code>te(key)</code></td>
              <td>Returns true when the key exists in the active or fallback locale.</td>
            </tr>
            <tr>
              <td><code>locale()</code>${' '}/ <code>setLocale(id)</code></td>
              <td>Read or change the active locale. Updates <code>document.documentElement.lang</code>.</td>
            </tr>
            <tr>
              <td><code>useI18n()</code></td>
              <td>Returns <code>${'{ t, te, locale, setLocale, addMessages, availableLocales }'}</code>.</td>
            </tr>
            <tr>
              <td><code>addMessages(locale, bag)</code></td>
              <td>Merge more strings for a locale (lazy-loaded packs from <code>locales/</code>).</td>
            </tr>
            <tr>
              <td><code>LocaleToggle</code></td>
              <td>Pill control to switch locales. Pass <code>locales</code>${' '}or use <code>availableLocales()</code>.</td>
            </tr>
            <tr>
              <td><code>localeBootScript()</code></td>
              <td>Tiny inline script to set <code>lang</code>${' '}before paint when <code>persist</code>${' '}is on.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <CodeBlock :code=${useI18nHelper} :filename=${'use-i18n.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'lazy'} :title=${'Lazy locale packs'}>
      <p class="docs-lead">
        Start with the folders you need. Load another language file later with <code>addMessages</code>.
      </p>
      <CodeBlock :code=${lazyLocale} :filename=${'load-es.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'components'} :title=${'With UI components'}>
      <p class="docs-lead">
        Pass <code>t('key')</code>${' '}straight into props — no arrow. Keep the copy in the same <code>locales/*.js</code>${' '}files.
      </p>
      <CodeBlock :code=${componentLabels} :filename=${'translated-chrome.jcr'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'persist'} :title=${'Persist locale'}>
      <p class="docs-lead">
        With <code>persist: true</code>${' '}(default), <code>setLocale</code>${' '}writes <code>localStorage['j-locale']</code>.
        On the next <code>createI18n</code>, that value wins over <code>options.locale</code>.
        Optional early paint:
      </p>
      <CodeBlock :code=${bootScript} :filename=${'index.html'} :language=${'html'} />
    </DocsSection>

    <DocsSection :id=${'rules'} :title=${'Rules of thumb'}>
      <ul class="docs-checklist">
        <li>One file per locale under <code>locales/</code>; re-export them from <code>locales/index.js</code>.</li>
        <li>Call <code>createI18n</code>${' '}once before any <code>t</code>${' '}/ <code>LocaleToggle</code>.</li>
        <li>In <code>.jcr</code>${' '}templates use <code>${"\${t('key')}"}</code>${' '}or <code>${":title=\${t('key')}"}</code>${' '}— no arrow needed.</li>
        <li>In plain JS, use <code>translate('key')</code>${' '}(or <code>t('key')()</code>) when you need the string now.</li>
        <li>Missing keys return the key string; missing locales fall back to <code>fallbackLocale</code>.</li>
        <li>Nest only when it helps (<code>app.title</code>); keep packs easy to scan.</li>
        <li>Component built-in English defaults stay English unless you pass translated props.</li>
      </ul>
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
