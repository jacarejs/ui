import Button from '@jacare/ui/components/Button.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext, docsSiteUrl } from '../nav-data.js'
import { goDocs } from '../navigate.js'

const navLinks = previousNext('/')

export <view>
  <article class="docs-page">
    <section class="docs-home-hero docs-panel">
      <p class="docs-kicker">@jacare/ui</p>
      <h1 class="docs-title">Official UI for Jacaré</h1>
      <p class="docs-lead">
        Accessible, themeable primitives powered by pulses — no virtual DOM. Every docs page shows a live demo beside Jacaré source, including imports.
      </p>
      <p class="docs-lead">
        Hosted docs:
        <a href=${() => docsSiteUrl} target="_blank" rel="noreferrer">${() => docsSiteUrl}</a>
      </p>
      <div class="docs-hero-actions">
        <Button :variant=${'primary'} on-press=${() => goDocs('/quick-start')}>Quick start</Button>
        <Button :variant=${'secondary'} on-press=${() => goDocs('/install')}>Installation</Button>
        <Button :variant=${'ghost'} on-press=${() => goDocs('/components')}>Browse components</Button>
      </div>
    </section>

    <div class="docs-feature-grid">
      <div class="docs-feature docs-panel">
        <h3>Theme tokens</h3>
        <p>Light and canopy dark themes share one --j-* token sheet. Semantic aliases keep backgrounds, text, and accents aligned across every component.</p>
      </div>
      <div class="docs-feature docs-panel">
        <h3>Contracts first</h3>
        <p>Each .jcr file declares props, slots, and emits up front. Docs generate the API table from that contract so the page stays honest.</p>
      </div>
      <div class="docs-feature docs-panel">
        <h3>No virtual DOM</h3>
        <p>Updates come from Jacaré pulses — fine-grained and predictable. Live demos on every page use the same runtime as your app.</p>
      </div>
    </div>

    <section class="docs-panel" style="padding:1.25rem">
      <h2 class="docs-section-title" style="margin-top:0">In 0.1.0</h2>
      <ul class="docs-checklist">
        <li>20 primitives with playgrounds, demos, and accessibility notes</li>
        <li>Theme Editor for live token drafts and CSS export</li>
        <li>applyTheme, ThemeToggle, and ThemeScope for light / dark / system</li>
      </ul>
      <div class="docs-hero-actions" style="margin-top:1rem">
        <Button :variant=${'secondary'} :size=${'sm'} on-press=${() => goDocs('/changelog')}>Changelog</Button>
        <Button :variant=${'ghost'} :size=${'sm'} on-press=${() => goDocs('/theme-editor')}>Theme Editor</Button>
      </div>
    </section>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
