import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Mention from '@jacare/ui/components/Mention.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, customPrefix, playgroundCode as buildPlaygroundCode, prefilled, states } from '../../examples/mention.js'

const contract = getContract('Mention')
const navLinks = previousNext('/components/mention')

const options = [
  { value: 'ada', label: 'Ada' },
  { value: 'grace', label: 'Grace' },
  { value: 'alan', label: 'Alan' },
  { value: 'linus', label: 'Linus' },
]

const playLabel = pulse('Message')
const playPlaceholder = pulse('Type @ to mention someone')
const playValue = pulse('')
const playDisabled = pulse(false)
const basicValue = pulse('')
const topicValue = pulse('')
const replyValue = pulse('Thanks @Ada ')
const invalidValue = pulse('')
const lockedValue = pulse('Assigned to @Ada')

const topicOptions = [{ value: 'urgent', label: 'urgent' }, { value: 'help', label: 'help' }]

const a11yItems = [
  'The native text field remains the primary keyboard target',
  'Suggestions are exposed as a listbox with option buttons',
  'Escape closes suggestions without clearing typed text',
  'Errors use role="alert" and disabled prevents editing',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    placeholder: playPlaceholder(),
    value: playValue(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Mention</span>
    </nav>

    <DocsHero
      :kicker=${'Inputs'}
      :title=${'Mention'}
      :description=${'Text field that opens a filtered suggestion list when you type @. Bind the full string value and pass mention options.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Field :label=${'Placeholder'} bind-value=${playPlaceholder} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <Mention
              :label=${playLabel}
              :placeholder=${playPlaceholder}
              :options=${options}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'mention-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'mention-basic.jcr'}>
      <Mention
        :label=${'Message'}
        :options=${options}
        :placeholder=${'Type @ to mention someone'}
        bind-value=${basicValue}
      />
    </Demo>

    <Demo :id=${'prefix'} :title=${'Custom prefix'} :lead=${'Use prefix for topic, command, or entity suggestion flows.'} :code=${customPrefix} :filename=${'mention-prefix.jcr'}>
      <Mention :label=${'Message'} :options=${topicOptions} :prefix=${'#'} :placeholder=${'Type # for topics'} bind-value=${topicValue} />
    </Demo>

    <Demo :id=${'prefilled'} :title=${'Prefilled message'} :code=${prefilled} :filename=${'mention-prefilled.jcr'}>
      <Mention :label=${'Reply'} :options=${options} :hint=${'Type @ to add another teammate'} bind-value=${replyValue} />
    </Demo>

    <Demo :id=${'states'} :title=${'Error and disabled'} :code=${states} :filename=${'mention-states.jcr'}>
      <Stack :gap=${'md'}>
        <Mention :label=${'Reviewer'} :options=${options} :error=${'Mention at least one reviewer'} bind-value=${invalidValue} />
        <Mention :label=${'Assignment'} :options=${options} :disabled=${true} bind-value=${lockedValue} />
      </Stack>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11yItems} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
