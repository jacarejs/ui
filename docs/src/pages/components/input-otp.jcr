import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import InputOtp from '@jacare/ui/components/InputOtp.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, lengths, masked, playgroundCode as buildPlaygroundCode, sizes, states } from '../../examples/input-otp.js'

const contract = getContract('InputOtp')
const navLinks = previousNext('/components/input-otp')

const playLabel = pulse('Verification code')
const playValue = pulse('')
const playLength = pulse('6')
const playMask = pulse(false)
const playDisabled = pulse(false)
const basicValue = pulse('')
const shortValue = pulse('')
const recoveryValue = pulse('')
const maskedValue = pulse('42')
const sizeSm = pulse('')
const sizeMd = pulse('')
const sizeLg = pulse('')
const hintedValue = pulse('')
const errorValue = pulse('1234')
const disabledValue = pulse('246810')
const a11y = [
  'Digit fields are grouped and each one is named by its one-based position',
  'The first field uses autocomplete="one-time-code" for platform code suggestions',
  'Pasting filters non-digits and fills the configured number of boxes',
  'Arrow keys move between boxes and Backspace returns to the previous empty box',
  'error marks every box invalid and announces the message with role="alert"',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    value: playValue(),
    length: playLength(),
    mask: playMask(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>InputOtp</span>
    </nav>

    <DocsHero
      :kicker=${'Inputs'}
      :title=${'InputOtp'}
      :description=${'One-time-code entry with auto-advancing digit boxes, paste support, and a finish event.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Field :label=${'Length'} :type=${'number'} bind-value=${playLength} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Mask'} bind-checked=${playMask} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <InputOtp
              :label=${playLabel}
              :length=${() => Number(playLength()) || 6}
              :mask=${playMask}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'input-otp-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'input-otp-basic.jcr'}>
      <InputOtp :label=${'Verification code'} :length=${6} bind-value=${basicValue} />
    </Demo>

    <Demo :id=${'lengths'} :title=${'Code lengths'} :code=${lengths} :filename=${'input-otp-lengths.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <InputOtp :label=${'Four-digit PIN'} :length=${4} bind-value=${shortValue} />
        <InputOtp :label=${'Eight-digit recovery code'} :length=${8} bind-value=${recoveryValue} />
      </Stack>
    </Demo>

    <Demo :id=${'masked'} :title=${'Masked code'} :code=${masked} :filename=${'input-otp-masked.jcr'}>
      <InputOtp :label=${'Secure PIN'} :length=${4} :mask=${true} :hint=${'Digits are hidden after entry'} bind-value=${maskedValue} />
    </Demo>

    <Demo :id=${'sizes'} :title=${'Sizes'} :code=${sizes} :filename=${'input-otp-sizes.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <InputOtp :label=${'Small'} :length=${4} :size=${'sm'} bind-value=${sizeSm} />
        <InputOtp :label=${'Medium'} :length=${4} :size=${'md'} bind-value=${sizeMd} />
        <InputOtp :label=${'Large'} :length=${4} :size=${'lg'} bind-value=${sizeLg} />
      </Stack>
    </Demo>

    <Demo :id=${'states'} :title=${'Help, error, and disabled'} :code=${states} :filename=${'input-otp-states.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <InputOtp :label=${'Confirmation code'} :hint=${'Paste all six digits at once'} bind-value=${hintedValue} />
        <InputOtp :label=${'Expired code'} :length=${4} :error=${'Request a new verification code'} bind-value=${errorValue} />
        <InputOtp :label=${'Used code'} :disabled=${true} bind-value=${disabledValue} />
      </Stack>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
