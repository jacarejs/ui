import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import TimeSelect from '@jacare/ui/components/TimeSelect.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, clearable, intervals, placeholder, playgroundCode as buildPlaygroundCode, states } from '../../examples/time-select.js'

const contract = getContract('TimeSelect')
const navLinks = previousNext('/components/time-select')

const playLabel = pulse('Appointment')
const playValue = pulse('09:30')
const playStart = pulse('09:00')
const playEnd = pulse('18:00')
const playStep = pulse('00:30')
const playClearable = pulse(true)
const playDisabled = pulse(false)
const basicValue = pulse('09:30')
const quarterValue = pulse('08:15')
const hourlyValue = pulse('10:00')
const placeholderValue = pulse('')
const clearValue = pulse('13:30')
const errorValue = pulse('')
const disabledValue = pulse('16:00')
const a11y = [
  'The trigger announces that it opens a listbox and keeps the current time visible',
  'Time choices use option roles and the active option has a distinct visual state',
  'disabled removes the trigger from keyboard focus and prevents opening',
  'error is announced with role="alert" and uses a non-color border cue',
  'Use a clear placeholder that explains the empty value when clearable is enabled',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    value: playValue(),
    start: playStart(),
    end: playEnd(),
    step: playStep(),
    clearable: playClearable(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>TimeSelect</span>
    </nav>

    <DocsHero
      :kicker=${'Pickers'}
      :title=${'TimeSelect'}
      :description=${'Dropdown of discrete time slots between start and end, stepped by an HH:mm interval. Bind value as a string pulse.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Field :label=${'Start'} bind-value=${playStart} />
          <Field :label=${'End'} bind-value=${playEnd} />
          <Field :label=${'Step'} bind-value=${playStep} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Clearable'} bind-checked=${playClearable} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <TimeSelect
              :label=${playLabel}
              :start=${playStart}
              :end=${playEnd}
              :step=${playStep}
              :clearable=${playClearable}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'time-select-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'time-select-basic.jcr'}>
      <TimeSelect
        :label=${'Appointment'}
        :start=${'09:00'}
        :end=${'18:00'}
        :step=${'00:30'}
        bind-value=${basicValue}
      />
    </Demo>

    <Demo :id=${'intervals'} :title=${'Ranges and intervals'} :code=${intervals} :filename=${'time-select-intervals.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <TimeSelect :label=${'Quarter-hour slots'} :start=${'08:00'} :end=${'10:00'} :step=${'00:15'} bind-value=${quarterValue} />
        <TimeSelect :label=${'Hourly slots'} :start=${'09:00'} :end=${'17:00'} :step=${'01:00'} bind-value=${hourlyValue} />
      </Stack>
    </Demo>

    <Demo :id=${'placeholder'} :title=${'Placeholder without clear'} :code=${placeholder} :filename=${'time-select-placeholder.jcr'}>
      <TimeSelect :label=${'Delivery window'} :placeholder=${'Choose a delivery time'} :clearable=${false} bind-value=${placeholderValue} />
    </Demo>

    <Demo :id=${'clearable'} :title=${'Clearable selection'} :code=${clearable} :filename=${'time-select-clearable.jcr'}>
      <TimeSelect :label=${'Optional break'} :clearable=${true} :hint=${'Choose the placeholder option to clear'} bind-value=${clearValue} />
    </Demo>

    <Demo :id=${'states'} :title=${'Error and disabled states'} :code=${states} :filename=${'time-select-states.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <TimeSelect :label=${'Interview'} :error=${'Select an interview time'} bind-value=${errorValue} />
        <TimeSelect :label=${'Confirmed time'} :disabled=${true} bind-value=${disabledValue} />
      </Stack>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
