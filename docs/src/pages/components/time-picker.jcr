import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import TimePicker from '@jacare/ui/components/TimePicker.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { arrowControl, basic, placeholder, playgroundCode as buildPlaygroundCode, seconds, states } from '../../examples/time-picker.js'

const contract = getContract('TimePicker')
const navLinks = previousNext('/components/time-picker')

const playLabel = pulse('Start time')
const playValue = pulse('09:30')
const playClearable = pulse(true)
const playArrowControl = pulse(false)
const playDisabled = pulse(false)
const basicValue = pulse('09:30')
const secondsValue = pulse('09:30:45')
const arrowValue = pulse('14:20')
const placeholderValue = pulse('')
const errorValue = pulse('')
const disabledValue = pulse('18:30')
const a11y = [
  'The trigger announces a dialog popup and displays the selected time as text',
  'Hour, minute, and second selectors retain native keyboard focus behavior',
  'Arrow controls have explicit Increase and Decrease names for each time unit',
  'Clear and Now are real buttons; disabling the picker prevents opening its panel',
  'error is announced with role="alert" and highlighted on both label and trigger',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    value: playValue(),
    clearable: playClearable(),
    arrowControl: playArrowControl(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>TimePicker</span>
    </nav>

    <DocsHero
      :kicker=${'Pickers'}
      :title=${'TimePicker'}
      :description=${'Hour and minute picker that binds an HH:mm (or HH:mm:ss) string pulse, with optional arrow steppers.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Clearable'} bind-checked=${playClearable} />
            <Switch :label=${'Arrow control'} bind-checked=${playArrowControl} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <TimePicker
              :label=${playLabel}
              :clearable=${playClearable}
              :arrowControl=${playArrowControl}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'time-picker-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'time-picker-basic.jcr'}>
      <TimePicker :label=${'Start time'} bind-value=${basicValue} />
    </Demo>

    <Demo :id=${'seconds'} :title=${'Seconds'} :lead=${'Bind an HH:mm:ss value to render the seconds control.'} :code=${seconds} :filename=${'time-picker-seconds.jcr'}>
      <TimePicker :label=${'Precise start'} :hint=${'A value with three segments enables seconds'} bind-value=${secondsValue} />
    </Demo>

    <Demo :id=${'arrow-control'} :title=${'Arrow controls'} :code=${arrowControl} :filename=${'time-picker-arrow-control.jcr'}>
      <TimePicker :label=${'Reminder time'} :arrowControl=${true} bind-value=${arrowValue} />
    </Demo>

    <Demo :id=${'placeholder'} :title=${'Placeholder without clear'} :code=${placeholder} :filename=${'time-picker-placeholder.jcr'}>
      <TimePicker :label=${'Optional time'} :placeholder=${'No time selected'} :clearable=${false} bind-value=${placeholderValue} />
    </Demo>

    <Demo :id=${'states'} :title=${'Error and disabled states'} :code=${states} :filename=${'time-picker-states.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <TimePicker :label=${'Closing time'} :error=${'Closing time is required'} bind-value=${errorValue} />
        <TimePicker :label=${'Scheduled time'} :disabled=${true} bind-value=${disabledValue} />
      </Stack>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
