import { pulse, derive } from '@jacare/core'
import Input from '@jacare/ui/components/Input.jcr'
import InputPassword from '@jacare/ui/components/InputPassword.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  clearableExample,
  comparison,
  confirmPair,
  maxLengthExample,
  meter,
  noMeter,
  pin,
  requiredExample,
  roles,
  sizes,
  states,
  strengthEvent,
  strengthLevels,
} from '../../examples/input-password.js'

const contract = getContract('InputPassword')
const navLinks = previousNext('/components/input-password')

const basicValue = pulse('')
const comparePlain = pulse('secret')
const compareRich = pulse('secret')
const currentValue = pulse('')
const newValue = pulse('')
const confirmRoleValue = pulse('')
const weakValue = pulse('abcdefgh')
const fairValue = pulse('Abcdefgh')
const goodValue = pulse('Abcdefgh1')
const strongValue = pulse('Abcdefgh1!')
const signupPassword = pulse('')
const signupConfirm = pulse('')
const signupError = derive(() => {
  if (!signupConfirm()) return ''
  return signupConfirm() === signupPassword() ? '' : 'Passwords do not match'
})
const meterValue = pulse('Jacare')
const noMeterValue = pulse('secret')
const hintedValue = pulse('')
const errorValue = pulse('123')
const lockedValue = pulse('locked-value')
const sizeSm = pulse('')
const sizeMd = pulse('')
const sizeLg = pulse('')
const clearableValue = pulse('temporary')
const maxLengthValue = pulse('')
const pinValue = pulse('')
const requiredValue = pulse('')
const strengthValue = pulse('')
const strength = pulse({ score: 0, label: '' })

const a11y = [
  'Show/Hide toggle uses aria-pressed and an explicit aria-label',
  'Strength meter is announced with role="status" when the value changes',
  'Native password input keeps autocomplete and required semantics',
  'error marks the field invalid and announces with role="alert"',
  'clearable exposes a Clear button when the value is non-empty',
]

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>InputPassword</span>
    </nav>

    <DocsHero
      :kicker=${'Inputs'}
      :title=${'InputPassword'}
      :description=${'Password field with show/hide toggle and an optional strength meter — more than a raw type="password" Input.'}
      :status=${'stable'}
    />

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'Toggle visibility with the trailing control. meter is on by default.'}
      :code=${basic}
      :filename=${'input-password-basic.jcr'}
      :layout=${'stack'}
    >
      <div class="docs-demo-constrain">
        <InputPassword :label=${'Password'} :hint=${'At least 8 characters'} bind-value=${basicValue} />
      </div>
    </Demo>

    <DocsSection :id=${'comparison'} :title=${'Comparison'}>
      <Demo
        :id=${'vs-input'}
        :title=${'Input vs InputPassword'}
        :lead=${'Plain Input type=password is fine for simple masking. InputPassword adds show/hide and a strength meter.'}
        :code=${comparison}
        :filename=${'input-password-comparison.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-compare">
          <div class="docs-compare__pane">
            <p class="docs-compare__label">Input type=password</p>
            <Input :label=${'Password'} :type=${'password'} bind-value=${comparePlain} />
            <Text :tone=${'muted'}>No show/hide toggle or strength meter.</Text>
          </div>
          <div class="docs-compare__pane">
            <p class="docs-compare__label">InputPassword</p>
            <InputPassword :label=${'Password'} bind-value=${compareRich} />
            <Text :tone=${'muted'}>Toggle + meter built in.</Text>
          </div>
        </div>
      </Demo>

      <Demo
        :id=${'strength-levels'}
        :title=${'Strength levels'}
        :lead=${'Score climbs with length (8 / 12), mixed case, digits, and symbols — Weak → Fair → Good → Strong.'}
        :code=${strengthLevels}
        :filename=${'input-password-strength-levels.jcr'}
        :layout=${'stack'}
      >
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:0.85rem;width:100%">
          <InputPassword :label=${'Weak'} :meter=${true} bind-value=${weakValue} />
          <InputPassword :label=${'Fair'} :meter=${true} bind-value=${fairValue} />
          <InputPassword :label=${'Good'} :meter=${true} bind-value=${goodValue} />
          <InputPassword :label=${'Strong'} :meter=${true} bind-value=${strongValue} />
        </div>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'roles'} :title=${'Password roles'}>
      <Demo
        :id=${'autocomplete'}
        :title=${'Current, new, and confirm'}
        :lead=${'Set autocomplete and meter per role — meter on for new passwords, off for current/confirm.'}
        :code=${roles}
        :filename=${'input-password-roles.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain" style="display:grid;gap:1rem">
          <InputPassword
            :label=${'Current password'}
            :autocomplete=${'current-password'}
            :meter=${false}
            :name=${'current-password'}
            bind-value=${currentValue}
          />
          <InputPassword
            :label=${'New password'}
            :autocomplete=${'new-password'}
            :placeholder=${'Create a strong password'}
            :name=${'new-password'}
            bind-value=${newValue}
          />
          <InputPassword
            :label=${'Confirm new password'}
            :autocomplete=${'new-password'}
            :meter=${false}
            :name=${'confirm-password'}
            bind-value=${confirmRoleValue}
          />
        </div>
      </Demo>

      <Demo
        :id=${'confirm'}
        :title=${'Confirm with match check'}
        :lead=${'Pair two fields and surface a mismatch with the error prop.'}
        :code=${confirmPair}
        :filename=${'input-password-confirm.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain" style="display:grid;gap:1rem">
          <InputPassword
            :label=${'Password'}
            :autocomplete=${'new-password'}
            :required=${true}
            :hint=${'Use upper, lower, number, and symbol'}
            bind-value=${signupPassword}
          />
          <InputPassword
            :label=${'Confirm password'}
            :autocomplete=${'new-password'}
            :meter=${false}
            :required=${true}
            :error=${() => signupError()}
            bind-value=${signupConfirm}
          />
        </div>
      </Demo>

      <Demo
        :id=${'pin'}
        :title=${'PIN / short secret'}
        :lead=${'maxLength + meter=false fits app PINs and one-time secrets.'}
        :code=${pin}
        :filename=${'input-password-pin.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain">
          <InputPassword
            :label=${'App PIN'}
            :placeholder=${'6–12 characters'}
            :maxLength=${12}
            :meter=${false}
            :clearable=${true}
            :autocomplete=${'one-time-code'}
            :hint=${'Short secrets often skip the strength meter'}
            bind-value=${pinValue}
          />
        </div>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'patterns'} :title=${'Patterns'}>
      <Demo
        :id=${'meter'}
        :title=${'Strength meter'}
        :lead=${'Score rises with length, mixed case, digits, and symbols.'}
        :code=${meter}
        :filename=${'input-password-meter.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain">
          <InputPassword
            :label=${'New password'}
            :meter=${true}
            :placeholder=${'Create a strong password'}
            bind-value=${meterValue}
          />
        </div>
      </Demo>

      <Demo
        :id=${'no-meter'}
        :title=${'Without meter'}
        :lead=${'Turn meter off for current-password confirm fields.'}
        :code=${noMeter}
        :filename=${'input-password-no-meter.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain">
          <InputPassword
            :label=${'Current password'}
            :meter=${false}
            :autocomplete=${'current-password'}
            bind-value=${noMeterValue}
          />
        </div>
      </Demo>

      <Demo
        :id=${'sizes'}
        :title=${'Sizes'}
        :lead=${'size accepts sm, md, and lg to match surrounding form density.'}
        :code=${sizes}
        :filename=${'input-password-sizes.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <InputPassword :label=${'Small'} :size=${'sm'} :meter=${false} bind-value=${sizeSm} />
          <InputPassword :label=${'Medium'} :size=${'md'} :meter=${false} bind-value=${sizeMd} />
          <InputPassword :label=${'Large'} :size=${'lg'} :meter=${false} bind-value=${sizeLg} />
        </Stack>
      </Demo>

      <Demo
        :id=${'clearable'}
        :title=${'Clearable'}
        :lead=${'clearable adds a clear control beside show/hide.'}
        :code=${clearableExample}
        :filename=${'input-password-clearable.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain">
          <InputPassword
            :label=${'Temporary password'}
            :clearable=${true}
            :meter=${false}
            :hint=${'clearable adds a clear control beside show/hide'}
            bind-value=${clearableValue}
          />
        </div>
      </Demo>

      <Demo
        :id=${'max-length'}
        :title=${'Max length'}
        :lead=${'maxLength caps typed characters for PIN-style passwords.'}
        :code=${maxLengthExample}
        :filename=${'input-password-max-length.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain">
          <InputPassword
            :label=${'PIN-style password'}
            :maxLength=${12}
            :meter=${false}
            :hint=${'maxLength caps input at 12 characters'}
            bind-value=${maxLengthValue}
          />
        </div>
      </Demo>

      <Demo
        :id=${'required'}
        :title=${'Required'}
        :lead=${'required marks the label and enables native required on the control.'}
        :code=${requiredExample}
        :filename=${'input-password-required.jcr'}
        :layout=${'stack'}
      >
        <div class="docs-demo-constrain">
          <InputPassword
            :label=${'Password'}
            :required=${true}
            :autocomplete=${'new-password'}
            :hint=${'Required fields show an asterisk'}
            bind-value=${requiredValue}
          />
        </div>
      </Demo>

      <Demo
        :id=${'states'}
        :title=${'Hint, error, disabled'}
        :lead=${'hint guides setup; error replaces it; disabled locks the field.'}
        :code=${states}
        :filename=${'input-password-states.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <InputPassword :label=${'Hinted'} :hint=${'Use upper, lower, number, and symbol'} bind-value=${hintedValue} />
          <InputPassword :label=${'Too short'} :error=${'Password must be at least 8 characters'} bind-value=${errorValue} />
          <InputPassword :label=${'Disabled'} :disabled=${true} bind-value=${lockedValue} />
        </Stack>
      </Demo>

      <Demo
        :id=${'strength'}
        :title=${'Strength event'}
        :lead=${'Listen to strength for live score feedback outside the field.'}
        :code=${strengthEvent}
        :filename=${'input-password-strength.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <InputPassword
            :label=${'Account password'}
            :placeholder=${'Type to score strength'}
            :autocomplete=${'new-password'}
            bind-value=${strengthValue}
            on-strength=${(next) => strength.set(next)}
          />
          <Text :tone=${'muted'}>
            ${() => {
              const next = strength() || { score: 0, label: '' }
              if (!next.score) return 'Strength idle'
              return 'Strength ' + next.label + ' (score ' + next.score + '/4)'
            }}
          </Text>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
