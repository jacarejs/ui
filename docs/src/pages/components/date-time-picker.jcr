import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import DateTimePicker from '@jacare/ui/components/DateTimePicker.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, bounds, playgroundCode as buildPlaygroundCode } from '../../examples/date-time-picker.js'

const contract = getContract('DateTimePicker')
const navLinks = previousNext('/components/date-time-picker')

const playLabel = pulse('Schedule')
const playValue = pulse('2026-07-28T14:30')
const playMin = pulse('2026-07-01T00:00')
const playMax = pulse('2026-08-31T23:59')
const playClearable = pulse(true)
const playRequired = pulse(false)
const playDisabled = pulse(false)
const playError = pulse('')
const boundsValue = pulse('2026-07-15T10:00')

const a11yItems = [
  'DatePicker and TimePicker keep their own keyboard and ARIA contracts',
  'Outer label + required marker describe the combined control',
  'TimePicker stays disabled until a date is chosen',
  'Error and hint render once on the DateTimePicker wrapper',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    value: playValue(),
    min: playMin(),
    max: playMax(),
    clearable: playClearable(),
    required: playRequired(),
    disabled: playDisabled(),
    error: playError(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>DateTimePicker</span>
    </nav>

    <DocsHero
      :kicker=${'Forms'}
      :title=${'DateTimePicker'}
      :description=${'Composes DatePicker and TimePicker into one control that binds a single ISO pulse (YYYY-MM-DDTHH:mm, or with seconds when TimePicker emits them).'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Field :label=${'Min (ISO)'} :hint=${'YYYY-MM-DDTHH:mm'} bind-value=${playMin} />
          <Field :label=${'Max (ISO)'} bind-value=${playMax} />
          <Field :label=${'Error'} :hint=${'Leave empty for a valid value'} bind-value=${playError} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Clearable'} bind-checked=${playClearable} />
            <Switch :label=${'Required'} bind-checked=${playRequired} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <DateTimePicker
              :label=${playLabel}
              :min=${playMin}
              :max=${playMax}
              :clearable=${playClearable}
              :required=${playRequired}
              :disabled=${playDisabled}
              :error=${playError}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'date-time-picker-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'DatePicker handles the calendar; TimePicker handles the clock. Both write into one pulse.'}
      :code=${basic}
      :filename=${'date-time-picker-basic.jcr'}
    >
      <DateTimePicker :label=${'Schedule'} bind-value=${playValue} />
    </Demo>

    <Demo
      :id=${'bounds'}
      :title=${'Min and max'}
      :lead=${'Bounds are passed to DatePicker as date portions of the ISO strings.'}
      :code=${bounds}
      :filename=${'date-time-picker-bounds.jcr'}
    >
      <DateTimePicker
        :label=${'Window'}
        :min=${'2026-07-01T00:00'}
        :max=${'2026-07-31T23:59'}
        :hint=${'July only'}
        bind-value=${boundsValue}
      />
    </Demo>

    <DocsSection :id=${'a11y'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11yItems} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
