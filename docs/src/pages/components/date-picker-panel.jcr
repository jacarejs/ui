import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import DatePickerPanel from '@jacare/ui/components/DatePickerPanel.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, bounds, playgroundCode as buildPlaygroundCode } from '../../examples/date-picker-panel.js'

const contract = getContract('DatePickerPanel')
const navLinks = previousNext('/components/date-picker-panel')

const playValue = pulse('2026-07-15')
const playMin = pulse('')
const playMax = pulse('')
const playBorder = pulse(true)
const playDisabled = pulse(false)
const basicValue = pulse('2026-07-15')
const boundsValue = pulse('2026-07-10')

const a11yItems = [
  'Each day button has a full date aria-label',
  'Disabled days (outside min/max) are not selectable',
  'Month and year selects remain keyboard accessible',
  'Today action jumps to the current date when allowed',
]

function playgroundCode() {
  return buildPlaygroundCode({
    value: playValue(),
    min: playMin(),
    max: playMax(),
    border: playBorder(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>DatePickerPanel</span>
    </nav>

    <DocsHero
      :kicker=${'Forms'}
      :title=${'DatePickerPanel'}
      :description=${'Inline calendar panel that binds an ISO YYYY-MM-DD string. Embed it in popovers, side panels, or next to other form fields when you do not need DatePicker chrome.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Min (YYYY-MM-DD)'} bind-value=${playMin} />
          <Field :label=${'Max (YYYY-MM-DD)'} bind-value=${playMax} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Border'} bind-checked=${playBorder} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <DatePickerPanel
              :min=${playMin}
              :max=${playMax}
              :border=${playBorder}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'date-picker-panel-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'Always-visible calendar with month/year selects and a Today action.'}
      :code=${basic}
      :filename=${'date-picker-panel-basic.jcr'}
    >
      <DatePickerPanel bind-value=${basicValue} />
    </Demo>

    <Demo
      :id=${'bounds'}
      :title=${'Bounds'}
      :lead=${'Days outside min/max are disabled. Use this when embedding the panel in a constrained booking flow.'}
      :code=${bounds}
      :filename=${'date-picker-panel-bounds.jcr'}
    >
      <DatePickerPanel
        :min=${'2026-07-05'}
        :max=${'2026-07-25'}
        bind-value=${boundsValue}
      />
    </Demo>

    <DocsSection :id=${'a11y'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11yItems} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
