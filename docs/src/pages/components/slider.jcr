import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Slider from '@jacare/ui/components/Slider.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, rangeExample, tooltipExample, playgroundCode as buildPlaygroundCode } from '../../examples/slider.js'

const contract = getContract('Slider')
const navLinks = previousNext('/components/slider')

const playSingle = pulse(40)
const playRangeValue = pulse([20, 60])
const playMin = pulse('0')
const playMax = pulse('100')
const playStep = pulse('1')
const playRange = pulse(false)
const playShowTooltip = pulse(true)
const playVertical = pulse(false)
const playDisabled = pulse(false)

const basicValue = pulse(40)
const rangeValue = pulse([25, 70])
const tooltipValue = pulse(55)

function playgroundCode() {
  return buildPlaygroundCode({
    range: playRange(),
    value: playSingle(),
    lo: playRangeValue()[0],
    hi: playRangeValue()[1],
    min: playMin(),
    max: playMax(),
    step: playStep(),
    showTooltip: playShowTooltip(),
    vertical: playVertical(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Slider</span>
    </nav>

    <DocsHero
      :kicker=${'Forms'}
      :title=${'Slider'}
      :description=${'Single or range value slider with pointer and touch drag, optional tooltips, and independent demo state on this page.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Min'} :type=${'number'} bind-value=${playMin} />
          <Field :label=${'Max'} :type=${'number'} bind-value=${playMax} />
          <Field :label=${'Step'} :type=${'number'} bind-value=${playStep} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Range'} bind-checked=${playRange} />
            <Switch :label=${'Tooltip'} bind-checked=${playShowTooltip} />
            <Switch :label=${'Vertical'} bind-checked=${playVertical} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel docs-slider-stage" class-docs-slider-stage--vertical=${playVertical}>
            #if playRange()
              <Slider
                :min=${() => Number(playMin()) || 0}
                :max=${() => Number(playMax()) || 100}
                :step=${() => Number(playStep()) || 1}
                :range=${true}
                :showTooltip=${playShowTooltip}
                :vertical=${playVertical}
                :disabled=${playDisabled}
                bind-value=${playRangeValue}
              />
            #else
              <Slider
                :min=${() => Number(playMin()) || 0}
                :max=${() => Number(playMax()) || 100}
                :step=${() => Number(playStep()) || 1}
                :showTooltip=${playShowTooltip}
                :vertical=${playVertical}
                :disabled=${playDisabled}
                bind-value=${playSingle}
              />
            #end
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'slider-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'slider-basic.jcr'}>
      <Slider :min=${0} :max=${100} bind-value=${basicValue} />
    </Demo>

    <Demo :id=${'range'} :title=${'Range'} :code=${rangeExample} :filename=${'slider-range.jcr'}>
      <Slider :min=${0} :max=${100} :range=${true} bind-value=${rangeValue} />
    </Demo>

    <Demo :id=${'tooltip'} :title=${'Tooltip'} :code=${tooltipExample} :filename=${'slider-tooltip.jcr'}>
      <Slider :min=${0} :max=${100} :showTooltip=${true} bind-value=${tooltipValue} />
    </Demo>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
