import { pulse } from '@jacare/core'
import Button from '@jacare/ui/components/Button.jcr'
import Field from '@jacare/ui/components/Field.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import VisuallyHidden from '@jacare/ui/components/VisuallyHidden.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import {
  basic,
  colors,
  events,
  iconEnd,
  iconOnly,
  iconStart,
  icons,
  menu,
  playgroundCode as buildPlaygroundCode,
  shapes,
  sizes,
  states,
  types,
  variants,
} from '../../examples/button.js'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'

const contract = getContract('Button')
const navLinks = previousNext('/components/button')

const a11y = [
  'Has visible focus ring using --j-focus',
  'Disabled removes pointer interaction',
  'Loading sets aria-busy and blocks clicks',
  'Icon-only buttons need VisuallyHidden or an accessible name',
]

const playLabel = pulse('Button')
const playVariant = pulse('primary')
const playSize = pulse('md')
const playShape = pulse('pill')
const playType = pulse('button')
const playDisabled = pulse(false)
const playLoading = pulse(false)
const playBlock = pulse(false)
const playIconMode = pulse('none')
const pressCount = pulse(0)
const menuOpen = pulse(false)

const variantOptions = ['primary', 'secondary', 'ghost', 'outline', 'success', 'warn', 'danger', 'info']
const sizeOptions = ['sm', 'md', 'lg']
const shapeOptions = ['pill', 'rounded', 'circle']
const typeOptions = ['button', 'submit', 'reset']
const iconOptions = ['none', 'start', 'end', 'only', 'menu']

function setVariant(next) {
  playVariant.set(next)
}

function setSize(next) {
  playSize.set(next)
}

function setShape(next) {
  playShape.set(next)
}

function setType(next) {
  playType.set(next)
}

function setIconMode(next) {
  playIconMode.set(next)
  if (next === 'only' || next === 'menu') {
    playShape.set(next === 'menu' ? 'rounded' : 'circle')
  }
}

function onPress() {
  pressCount.set(pressCount() + 1)
}

function toggleMenu() {
  menuOpen.set(!menuOpen())
}

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    variant: playVariant(),
    size: playSize(),
    shape: playShape(),
    type: playType(),
    disabled: playDisabled(),
    loading: playLoading(),
    block: playBlock(),
    iconMode: playIconMode(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Button</span>
    </nav>

    <DocsHero
      :kicker=${'Actions'}
      :title=${'Button'}
      :description=${'Primary way to trigger an action or submit a form. Choose a variant, color, size, shape, icons on the left or right, icon-only and menu buttons, and react to press — all pulse-friendly.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />

          <div class="docs-alert-play__group">
            <span class="docs-alert-play__label">Variant</span>
            <div class="docs-hero-actions">
              #for variantOptions as option
                <Button
                  :size=${'sm'}
                  :variant=${() => (playVariant() === option ? 'primary' : 'secondary')}
                  on-press=${() => setVariant(option)}
                >${option}</Button>
              #end
            </div>
          </div>

          <div class="docs-alert-play__group">
            <span class="docs-alert-play__label">Size</span>
            <div class="docs-hero-actions">
              #for sizeOptions as option
                <Button
                  :size=${'sm'}
                  :variant=${() => (playSize() === option ? 'primary' : 'secondary')}
                  on-press=${() => setSize(option)}
                >${option}</Button>
              #end
            </div>
          </div>

          <div class="docs-alert-play__group">
            <span class="docs-alert-play__label">Shape</span>
            <div class="docs-hero-actions">
              #for shapeOptions as option
                <Button
                  :size=${'sm'}
                  :variant=${() => (playShape() === option ? 'primary' : 'secondary')}
                  on-press=${() => setShape(option)}
                >${option}</Button>
              #end
            </div>
          </div>

          <div class="docs-alert-play__group">
            <span class="docs-alert-play__label">Icon</span>
            <div class="docs-hero-actions">
              #for iconOptions as option
                <Button
                  :size=${'sm'}
                  :variant=${() => (playIconMode() === option ? 'primary' : 'secondary')}
                  on-press=${() => setIconMode(option)}
                >${option}</Button>
              #end
            </div>
          </div>

          <div class="docs-alert-play__group">
            <span class="docs-alert-play__label">Type</span>
            <div class="docs-hero-actions">
              #for typeOptions as option
                <Button
                  :size=${'sm'}
                  :variant=${() => (playType() === option ? 'primary' : 'secondary')}
                  on-press=${() => setType(option)}
                >${option}</Button>
              #end
            </div>
          </div>

          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
            <Switch :label=${'Loading'} bind-checked=${playLoading} />
            <Switch :label=${'Block'} bind-checked=${playBlock} />
          </Stack>

          <p class="docs-demo-lead" style="margin:0">Presses: ${() => pressCount()}</p>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel docs-avatar-play__stage">
            #if playIconMode() === 'start'
              <Button
                :variant=${playVariant}
                :size=${playSize}
                :shape=${playShape}
                :type=${playType}
                :disabled=${playDisabled}
                :loading=${playLoading}
                :block=${playBlock}
                on-press=${onPress}
              >
                <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
                ${() => playLabel()}
              </Button>
            #elif playIconMode() === 'end'
              <Button
                :variant=${playVariant}
                :size=${playSize}
                :shape=${playShape}
                :type=${playType}
                :disabled=${playDisabled}
                :loading=${playLoading}
                :block=${playBlock}
                on-press=${onPress}
              >
                ${() => playLabel()}
                <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </Button>
            #elif playIconMode() === 'only'
              <Button
                :variant=${playVariant}
                :size=${playSize}
                :shape=${playShape}
                :type=${playType}
                :disabled=${playDisabled}
                :loading=${playLoading}
                :block=${playBlock}
                :iconOnly=${true}
                on-press=${onPress}
              >
                <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5" />
                </svg>
                <VisuallyHidden>${() => playLabel() || 'Search'}</VisuallyHidden>
              </Button>
            #elif playIconMode() === 'menu'
              <Button
                :variant=${playVariant}
                :size=${playSize}
                :shape=${playShape}
                :type=${playType}
                :disabled=${playDisabled}
                :loading=${playLoading}
                :block=${playBlock}
                :iconOnly=${true}
                on-press=${toggleMenu}
              >
                <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <VisuallyHidden>Open menu</VisuallyHidden>
              </Button>
            #else
              <Button
                :variant=${playVariant}
                :size=${playSize}
                :shape=${playShape}
                :type=${playType}
                :disabled=${playDisabled}
                :loading=${playLoading}
                :block=${playBlock}
                on-press=${onPress}
              >${() => playLabel()}</Button>
            #end
            #if playIconMode() === 'menu'
              <p class="docs-demo-lead" style="margin:0.75rem 0 0">Menu ${() => (menuOpen() ? 'open' : 'closed')}</p>
            #end
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'button-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'button-basic.jcr'}>
      <Button :variant=${'primary'}>Continue</Button>
    </Demo>

    <DocsSection :id=${'variants'} :title=${'Variants'}>
      <Demo :id=${'variants-demo'} :title=${'Style variants'} :code=${variants} :filename=${'button-variants.jcr'}>
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button :variant=${'primary'}>Primary</Button>
          <Button :variant=${'secondary'}>Secondary</Button>
          <Button :variant=${'ghost'}>Ghost</Button>
          <Button :variant=${'outline'}>Outline</Button>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'colors'} :title=${'Colors'}>
      <Demo :id=${'colors-demo'} :title=${'Semantic colors'} :code=${colors} :filename=${'button-colors.jcr'}>
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button :variant=${'primary'}>Primary</Button>
          <Button :variant=${'success'}>Success</Button>
          <Button :variant=${'warn'}>Warning</Button>
          <Button :variant=${'danger'}>Danger</Button>
          <Button :variant=${'info'}>Info</Button>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'sizes'} :title=${'Sizes'}>
      <Demo :id=${'sizes-demo'} :title=${'Size scale'} :code=${sizes} :filename=${'button-sizes.jcr'}>
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button :size=${'sm'}>Small</Button>
          <Button :size=${'md'}>Medium</Button>
          <Button :size=${'lg'}>Large</Button>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'shapes'} :title=${'Shapes'}>
      <Demo :id=${'shapes-demo'} :title=${'Pill, rounded, and circle'} :code=${shapes} :filename=${'button-shapes.jcr'}>
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button :shape=${'pill'}>Pill</Button>
          <Button :shape=${'rounded'}>Rounded</Button>
          <Button :shape=${'circle'}>+</Button>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'icons'} :title=${'Icons'}>
      <Demo
        :id=${'icons-overview'}
        :title=${'Left, right, icon-only, and menu'}
        :lead=${'Place an SVG with class jui-btn__icon before or after the label. Use iconOnly with VisuallyHidden for accessible icon buttons.'}
        :code=${icons}
        :filename=${'button-icons.jcr'}
      >
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            Add item
          </Button>
          <Button :variant=${'secondary'}>
            Continue
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </Button>
          <Button :iconOnly=${true} :shape=${'circle'} :variant=${'outline'}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <VisuallyHidden>Search</VisuallyHidden>
          </Button>
          <Button :iconOnly=${true} :variant=${'ghost'} on-press=${toggleMenu}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <VisuallyHidden>Open menu</VisuallyHidden>
          </Button>
        </Stack>
      </Demo>

      <Demo :id=${'icon-start'} :title=${'Icon on the left'} :code=${iconStart} :filename=${'button-icon-start.jcr'}>
        <Button>
          <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
          </svg>
          Add item
        </Button>
      </Demo>

      <Demo :id=${'icon-end'} :title=${'Icon on the right'} :code=${iconEnd} :filename=${'button-icon-end.jcr'}>
        <Button :variant=${'secondary'}>
          Continue
          <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </Button>
      </Demo>

      <Demo :id=${'icon-only'} :title=${'Icon only'} :code=${iconOnly} :filename=${'button-icon-only.jcr'}>
        <Stack :direction=${'row'} :gap=${'md'} :align=${'center'} :wrap=${true}>
          <Button :iconOnly=${true} :shape=${'circle'} :variant=${'outline'}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <VisuallyHidden>Search</VisuallyHidden>
          </Button>
          <Button :iconOnly=${true} :variant=${'secondary'}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            <VisuallyHidden>Add</VisuallyHidden>
          </Button>
          <Button :iconOnly=${true} :variant=${'danger'} :shape=${'rounded'}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
            <VisuallyHidden>Close</VisuallyHidden>
          </Button>
        </Stack>
      </Demo>

      <Demo
        :id=${'menu-button'}
        :title=${'Menu'}
        :lead=${'Use an icon-only hamburger control for navigation drawers and overflow menus.'}
        :code=${menu}
        :filename=${'button-menu.jcr'}
      >
        <Stack :direction=${'row'} :gap=${'md'} :align=${'center'}>
          <Button :iconOnly=${true} :variant=${'ghost'} on-press=${toggleMenu}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <VisuallyHidden>Open menu</VisuallyHidden>
          </Button>
          <Button :variant=${'secondary'}>
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            Menu
            <svg class="jui-btn__icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </Button>
          <span class="docs-demo-lead">Menu ${() => (menuOpen() ? 'open' : 'closed')}</span>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'states'} :title=${'States'}>
      <Demo :id=${'states-demo'} :title=${'Loading, disabled, block'} :code=${states} :filename=${'button-states.jcr'}>
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button :loading=${true}>Saving</Button>
          <Button :disabled=${true}>Disabled</Button>
        </Stack>
        <div class="docs-demo-constrain" style="margin-top:1rem">
          <Button :block=${true}>Full width</Button>
        </div>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'types'} :title=${'Button types'}>
      <Demo
        :id=${'types-demo'}
        :title=${'submit, reset, and button'}
        :lead=${'Use type to control native form behavior.'}
        :code=${types}
        :filename=${'button-types.jcr'}
      >
        <Stack :direction=${'row'} :gap=${'xl'} :align=${'center'} :justify=${'center'} :wrap=${true}>
          <Button :type=${'submit'} :variant=${'primary'}>Submit</Button>
          <Button :type=${'reset'} :variant=${'secondary'}>Reset</Button>
          <Button :type=${'button'} :variant=${'ghost'}>Button</Button>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'events'} :title=${'Press event'}>
      <Demo
        :id=${'events-demo'}
        :title=${'Reacting to on-press'}
        :lead=${'The press event only fires when the button is enabled and not loading.'}
        :code=${events}
        :filename=${'button-events.jcr'}
      >
        <Button on-press=${onPress}>Clicked ${() => pressCount()}</Button>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
