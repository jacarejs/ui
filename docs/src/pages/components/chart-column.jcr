import { pulse } from '@jacare/core'
import Card from '@jacare/ui/components/Card.jcr'
import ChartColumn from '@jacare/ui/components/ChartColumn.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  colors as colorsExample,
  inCard,
  multiSeries,
  noLegend,
  playgroundCode as buildPlaygroundCode,
  sized,
  stacked as stackedExample,
} from '../../examples/chart-column.js'

const contract = getContract('ChartColumn')
const navLinks = previousNext('/components/chart-column')

const playShowLegend = pulse(true)
const playStacked = pulse(false)
const playCustomColors = pulse(false)

const data = [
  { label: 'Product', value: 86 },
  { label: 'Sales', value: 72 },
  { label: 'Support', value: 64 },
  { label: 'Marketing', value: 51 },
]

const multiData = {
  categories: ['Q1', 'Q2', 'Q3', 'Q4'],
  series: [
    { name: 'Product', data: [40, 52, 61, 74] },
    { name: 'Services', data: [22, 28, 35, 41] },
  ],
}

const colorsData = {
  categories: ['Jan', 'Feb', 'Mar', 'Apr'],
  series: [
    { name: 'Online', data: [32, 38, 41, 45] },
    { name: 'Retail', data: [24, 28, 30, 34] },
  ],
}

const stackedData = {
  categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
  series: [
    { name: 'Direct', data: [18, 22, 24, 28, 30, 34] },
    { name: 'Organic', data: [14, 16, 18, 20, 22, 24] },
    { name: 'Referral', data: [8, 9, 10, 12, 13, 15] },
  ],
}

const trafficData = [
  { label: 'Direct', value: 44 },
  { label: 'Organic', value: 28 },
  { label: 'Referral', value: 18 },
  { label: 'Social', value: 10 },
]

const compactData = [
  { label: 'A', value: 8 },
  { label: 'B', value: 12 },
  { label: 'C', value: 10 },
  { label: 'D', value: 16 },
  { label: 'E', value: 14 },
]

const customColors = ['#be185d', '#0f766e']

const a11y = [
  'SVG root uses role="img" with an aria-label from title',
  'Each column exposes a native title with label and value',
  'Use the legend to identify series when color is not enough',
  'Use short category labels that remain readable on narrow viewports',
]

function playgroundCode() {
  return buildPlaygroundCode({
    showLegend: playShowLegend(),
    stacked: playStacked(),
    customColors: playCustomColors(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>ChartColumn</span>
    </nav>

    <DocsHero
      :kicker=${'Charts'}
      :title=${'ChartColumn'}
      :description=${'Vertical category columns for discrete comparisons with grouped or stacked series, custom colors, and legend.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Switch :label=${'Show legend'} bind-checked=${playShowLegend} />
          <Switch :label=${'Stacked'} bind-checked=${playStacked} />
          <Switch :label=${'Custom colors'} bind-checked=${playCustomColors} />
          <Text :tone=${'muted'}>Toggle options to preview column chart chrome.</Text>
        </div>
        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <ChartColumn
              :data=${() => (playStacked() ? stackedData : multiData)}
              :title=${'Column'}
              :caption=${'Playground preview'}
              :showLegend=${playShowLegend}
              :stacked=${playStacked}
              :colors=${() => (playCustomColors() ? customColors : null)}
              :width=${480}
              :height=${280}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'chart-column-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'Pass an array of { label, value }. Optional title, caption, width, and height frame the plot.'}
      :code=${basic}
      :filename=${'chart-column-basic.jcr'}
      :layout=${'stack'}
    >
      <ChartColumn
        :data=${data}
        :title=${'Column'}
        :caption=${'Department scores'}
        :width=${480}
        :height=${280}
      />
    </Demo>

    <DocsSection :id=${'data'} :title=${'Data shapes'}>
      <Demo
        :id=${'multi-series'}
        :title=${'Categories + series'}
        :lead=${'Pass categories and multiple series for grouped columns.'}
        :code=${multiSeries}
        :filename=${'chart-column-multi-series.jcr'}
        :layout=${'stack'}
      >
        <ChartColumn :data=${multiData} :title=${'Grouped columns'} />
      </Demo>
    </DocsSection>

    <DocsSection :id=${'options'} :title=${'Options'}>
      <Demo
        :id=${'colors'}
        :title=${'Custom colors'}
        :lead=${'colors overrides the default palette in series order.'}
        :code=${colorsExample}
        :filename=${'chart-column-colors.jcr'}
        :layout=${'stack'}
      >
        <ChartColumn
          :data=${colorsData}
          :title=${'Custom palette'}
          :colors=${['#be185d', '#1f6feb']}
        />
      </Demo>

      <Demo
        :id=${'stacked'}
        :title=${'Stacked'}
        :lead=${'stacked layers series in each category for part-to-whole comparisons.'}
        :code=${stackedExample}
        :filename=${'chart-column-stacked.jcr'}
        :layout=${'stack'}
      >
        <ChartColumn :data=${stackedData} :title=${'Stacked channels'} :stacked=${true} />
      </Demo>

      <Demo
        :id=${'no-legend'}
        :title=${'Hide legend'}
        :lead=${'showLegend=false for compact dashboard tiles.'}
        :code=${noLegend}
        :filename=${'chart-column-no-legend.jcr'}
        :layout=${'stack'}
      >
        <ChartColumn
          :data=${trafficData}
          :title=${'Traffic sources'}
          :caption=${'Legend hidden for compact tiles'}
          :showLegend=${false}
        />
      </Demo>

      <Demo
        :id=${'sized'}
        :title=${'Custom size'}
        :lead=${'width and height control the SVG viewBox and frame.'}
        :code=${sized}
        :filename=${'chart-column-sized.jcr'}
        :layout=${'stack'}
      >
        <ChartColumn
          :data=${compactData}
          :title=${'Compact size'}
          :width=${320}
          :height=${200}
          :showLegend=${false}
        />
      </Demo>
    </DocsSection>

    <DocsSection :id=${'patterns'} :title=${'Patterns'}>
      <Demo
        :id=${'in-card'}
        :title=${'Inside Card'}
        :lead=${'Compose ChartColumn in a Card for dashboard KPI panels.'}
        :code=${inCard}
        :filename=${'chart-column-card.jcr'}
        :layout=${'stack'}
      >
        <Card :title=${'Departments'} :subtitle=${'Q4 scores'}>
          <ChartColumn :data=${data} :showLegend=${true} :height=${240} />
        </Card>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
