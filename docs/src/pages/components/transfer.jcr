import { pulse } from '@jacare/core'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Transfer from '@jacare/ui/components/Transfer.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, customLabels, disabled, filterable, playgroundCode as buildPlaygroundCode } from '../../examples/transfer.js'

const contract = getContract('Transfer')
const navLinks = previousNext('/components/transfer')

const data = [
  { key: '1', label: 'Option 1' },
  { key: '2', label: 'Option 2' },
  { key: '3', label: 'Option 3' },
  { key: '4', label: 'Option 4' },
  { key: '5', label: 'Option 5' },
  { key: '6', label: 'Option 6' },
]

const playValue = pulse(['2', '4'])
const playFilterable = pulse(false)
const playDisabled = pulse(false)
const basicValue = pulse(['2', '4'])
const filterValue = pulse(['2'])
const labelsValue = pulse(['4'])
const disabledValue = pulse(['2'])

const a11yItems = [
  'Each list has an accessible title and listbox semantics',
  'Native checkboxes preserve keyboard toggling and checked state',
  'Move controls expose explicit target and source labels',
  'Disabled items and the disabled component prevent selection and movement',
]

function playgroundCode() {
  return buildPlaygroundCode({
    value: playValue(),
    filterable: playFilterable(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Transfer</span>
    </nav>

    <DocsHero
      :kicker=${'Selection'}
      :title=${'Transfer'}
      :description=${'Move items between source and target lists. Pass data as {key, label} and bind value to an array of selected keys.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Filterable'} bind-checked=${playFilterable} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <Transfer
              :data=${data}
              :filterable=${playFilterable}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'transfer-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'transfer-basic.jcr'}>
      <Transfer :data=${data} bind-value=${basicValue} />
    </Demo>

    <Demo :id=${'filterable'} :title=${'Filterable lists'} :lead=${'Filtering narrows each side independently without changing the selected keys.'} :code=${filterable} :filename=${'transfer-filterable.jcr'}>
      <Transfer :data=${data} :filterable=${true} bind-value=${filterValue} />
    </Demo>

    <Demo :id=${'labels'} :title=${'Custom labels'} :code=${customLabels} :filename=${'transfer-labels.jcr'}>
      <Transfer :data=${data} :titles=${['Available options', 'Chosen options']} :buttonTexts=${['Add', 'Remove']} bind-value=${labelsValue} />
    </Demo>

    <Demo :id=${'disabled'} :title=${'Disabled'} :code=${disabled} :filename=${'transfer-disabled.jcr'}>
      <Transfer :data=${data} :disabled=${true} bind-value=${disabledValue} />
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11yItems} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
