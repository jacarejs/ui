import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Cascader from '@jacare/ui/components/Cascader.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  changeOnSelectExample,
  customSeparator,
  filterableExample,
  multipleExample,
  playgroundCode as buildPlaygroundCode,
  selectedPath,
  states,
} from '../../examples/cascader.js'

const contract = getContract('Cascader')
const navLinks = previousNext('/components/cascader')

const options = [
  {
    value: 'guide',
    label: 'Guide',
    children: [
      {
        value: 'disciplines',
        label: 'Disciplines',
        children: [
          { value: 'consistency', label: 'Consistency' },
          { value: 'feedback', label: 'Feedback' },
        ],
      },
      {
        value: 'navigation',
        label: 'Navigation',
        children: [
          { value: 'side nav', label: 'Side Nav' },
          { value: 'top nav', label: 'Top Nav' },
        ],
      },
    ],
  },
  {
    value: 'component',
    label: 'Component',
    children: [
      {
        value: 'form',
        label: 'Form',
        children: [
          { value: 'cascader', label: 'Cascader' },
          { value: 'select', label: 'Select' },
        ],
      },
    ],
  },
]

const regionOptions = [
  {
    value: 'americas',
    label: 'Americas',
    children: [
      {
        value: 'brazil',
        label: 'Brazil',
        children: [
          { value: 'recife', label: 'Recife' },
          { value: 'sp', label: 'São Paulo' },
        ],
      },
    ],
  },
  {
    value: 'europe',
    label: 'Europe',
    children: [{ value: 'portugal', label: 'Portugal' }],
  },
]

const playLabel = pulse('Category')
const playPlaceholder = pulse('Select')
const playValue = pulse([])
const playClearable = pulse(true)
const playDisabled = pulse(false)
const playFilterable = pulse(false)
const playChangeOnSelect = pulse(false)
const playMultiple = pulse(false)
const basicValue = pulse([])
const selectedValue = pulse(['component', 'form', 'select'])
const regionValue = pulse(['guide', 'navigation', 'side nav'])
const filterValue = pulse([])
const anyLevelValue = pulse([])
const multipleValue = pulse([])
const invalidValue = pulse([])
const lockedValue = pulse(['guide', 'disciplines', 'feedback'])

const a11yItems = [
  'The trigger announces a dialog picker and tracks its expanded state',
  'Columns expose listbox and option semantics with selected states',
  'Escape closes the picker and returns focus to the trigger',
  'filterable search focuses an input; results stay keyboard-clickable options',
  'On mobile, the bottom sheet keeps large targets and an explicit back action',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    placeholder: playPlaceholder(),
    clearable: playClearable(),
    disabled: playDisabled(),
    filterable: playFilterable(),
    changeOnSelect: playChangeOnSelect(),
    multiple: playMultiple(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Cascader</span>
    </nav>

    <DocsHero
      :kicker=${'Selection'}
      :title=${'Cascader'}
      :description=${'Hierarchical path picker. Model is a path array (or array of paths when multiple). Adds filterable search, changeOnSelect for any level, and multiple selection — prefer CascadeSelect when you only need a single leaf value via optionLabel / optionValue / optionGroupChildren.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Field :label=${'Placeholder'} bind-value=${playPlaceholder} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Clearable'} bind-checked=${playClearable} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
            <Switch :label=${'Filterable'} bind-checked=${playFilterable} />
            <Switch :label=${'Change on select'} bind-checked=${playChangeOnSelect} />
            <Switch :label=${'Multiple'} bind-checked=${playMultiple} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <Cascader
              :label=${playLabel}
              :placeholder=${playPlaceholder}
              :options=${options}
              :clearable=${playClearable}
              :disabled=${playDisabled}
              :filterable=${playFilterable}
              :changeOnSelect=${playChangeOnSelect}
              :multiple=${playMultiple}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'cascader-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :lead=${'Bind value to a pulse of path segments: root → … → leaf.'} :code=${basic} :filename=${'cascader-basic.jcr'}>
      <Cascader :label=${'Category'} :options=${options} bind-value=${basicValue} />
    </Demo>

    <Demo :id=${'filterable'} :title=${'Filterable'} :lead=${'Search across leaf paths. Distinct from CascadeSelect, which has no filter.'} :code=${filterableExample} :filename=${'cascader-filterable.jcr'}>
      <Cascader
        :label=${'Search pages'}
        :options=${options}
        :filterable=${true}
        :hint=${'Type to jump to a leaf path'}
        bind-value=${filterValue}
      />
    </Demo>

    <Demo :id=${'change-on-select'} :title=${'Change on select'} :lead=${'Parents are selectable. The model stays a path array ending at the clicked node.'} :code=${changeOnSelectExample} :filename=${'cascader-change-on-select.jcr'}>
      <Cascader
        :label=${'Region'}
        :options=${regionOptions}
        :changeOnSelect=${true}
        :hint=${'Click Americas or Brazil without drilling to a city'}
        bind-value=${anyLevelValue}
      />
    </Demo>

    <Demo :id=${'multiple'} :title=${'Multiple'} :lead=${'Model becomes an array of path arrays. Toggle leaves to add or remove.'} :code=${multipleExample} :filename=${'cascader-multiple.jcr'}>
      <Cascader
        :label=${'Topics'}
        :options=${options}
        :multiple=${true}
        :hint=${'Select several leaf paths'}
        bind-value=${multipleValue}
      />
    </Demo>

    <Demo :id=${'selected'} :title=${'Selected path'} :lead=${'Seed the path array to show a committed selection.'} :code=${selectedPath} :filename=${'cascader-selected.jcr'}>
      <Cascader :label=${'Component'} :options=${options} bind-value=${selectedValue} />
    </Demo>

    <Demo :id=${'separator'} :title=${'Custom separator'} :code=${customSeparator} :filename=${'cascader-separator.jcr'}>
      <Cascader :label=${'Documentation'} :options=${options} :separator=${'›'} :hint=${'Choose the most specific page'} bind-value=${regionValue} />
    </Demo>

    <Demo :id=${'states'} :title=${'Error and disabled'} :code=${states} :filename=${'cascader-states.jcr'}>
      <Stack :gap=${'md'}>
        <Cascader :label=${'Destination'} :options=${options} :clearable=${false} :error=${'Select a destination'} bind-value=${invalidValue} />
        <Cascader :label=${'Locked path'} :options=${options} :disabled=${true} bind-value=${lockedValue} />
      </Stack>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11yItems} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
