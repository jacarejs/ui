import { pulse } from '@jacare/core'
import FilterBar from '@jacare/ui/components/FilterBar.jcr'
import Select from '@jacare/ui/components/Select.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import TableV2 from '@jacare/ui/components/TableV2.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  alignExample,
  basic,
  bordered,
  empty,
  filterExample,
  options,
  playgroundCode as buildPlaygroundCode,
  sizes,
  sortable,
  striped,
  virtualized,
  widths,
} from '../../examples/table-v2.js'

const contract = getContract('TableV2')
const navLinks = previousNext('/components/table-v2')

const sizeOptions = [
  { value: 'sm', label: 'Small' },
  { value: 'md', label: 'Medium' },
  { value: 'lg', label: 'Large' },
]

const columns = [
  { prop: 'name', label: 'Name', sortable: true, width: 160 },
  { prop: 'status', label: 'Status', sortable: true, width: 120 },
  { prop: 'owner', label: 'Owner', sortable: true, width: 140 },
]
const plainColumns = [
  { prop: 'name', label: 'Name', width: 160 },
  { prop: 'status', label: 'Status', width: 120 },
]
const alignColumns = [
  { prop: 'name', label: 'Name', width: 180 },
  { prop: 'version', label: 'Version', width: 100, align: 'center' },
  { prop: 'downloads', label: 'Downloads', width: 120, align: 'end' },
]
const widthColumns = [
  { prop: 'sku', label: 'SKU', width: 96 },
  { prop: 'name', label: 'Product', width: 220 },
  { prop: 'qty', label: 'Qty', width: 72 },
  { prop: 'price', label: 'Price', width: 96 },
]
const virtualColumns = [
  { prop: 'id', label: 'ID', width: 72, sortable: true },
  { prop: 'name', label: 'Package', width: 180, sortable: true },
  { prop: 'owner', label: 'Owner', width: 140, sortable: true },
  { prop: 'status', label: 'Status', width: 120, sortable: true },
]

const data = [
  { id: 1, name: 'API', status: 'Ready', owner: 'Platform' },
  { id: 2, name: 'Docs', status: 'Draft', owner: 'Design' },
  { id: 3, name: 'Site', status: 'Queued', owner: 'Growth' },
  { id: 4, name: 'Theme', status: 'Ready', owner: 'Design' },
  { id: 5, name: 'Tokens', status: 'Draft', owner: 'Design' },
]
const sortData = [
  { id: 1, name: 'Theme', status: 'Ready', owner: 'Design' },
  { id: 2, name: 'API', status: 'Draft', owner: 'Platform' },
  { id: 3, name: 'Docs', status: 'Queued', owner: 'Design' },
  { id: 4, name: 'Site', status: 'Ready', owner: 'Growth' },
]
const alignData = [
  { id: 1, name: 'Button', version: '0.1.3', downloads: '12.4k' },
  { id: 2, name: 'TableV2', version: '0.1.3', downloads: '8.1k' },
  { id: 3, name: 'Empty', version: '0.1.2', downloads: '3.6k' },
]
const widthData = [
  { id: 1, sku: 'JUI-01', name: 'Theme kit', qty: 12, price: '$24' },
  { id: 2, sku: 'JUI-02', name: 'Icon pack', qty: 40, price: '$12' },
  { id: 3, sku: 'JUI-03', name: 'Motion presets', qty: 8, price: '$18' },
]
const virtualData = Array.from({ length: 500 }, (item, index) => ({
  id: index + 1,
  name: 'pkg-' + (index + 1),
  owner: index % 2 ? 'Ada' : 'Grace',
  status: index % 3 ? 'Ready' : 'Queued',
}))
const filterData = Array.from({ length: 200 }, (item, index) => ({
  id: index + 1,
  name: 'pkg-' + (index + 1),
  owner: index % 2 ? 'Ada' : 'Grace',
  status: index % 3 ? 'Ready' : 'Queued',
}))

const statusOptions = [
  { value: 'all', label: 'All statuses' },
  { value: 'Ready', label: 'Ready' },
  { value: 'Queued', label: 'Queued' },
]

const playStripe = pulse(true)
const playBorder = pulse(true)
const playSize = pulse('md')
const playSortField = pulse('name')
const playSortOrder = pulse(1)

const sortField = pulse('name')
const sortOrder = pulse(1)
const filterQuery = pulse('')
const filterStatus = pulse('all')
const filterSortField = pulse('name')
const filterSortOrder = pulse(1)

const a11y = [
  'Keep column labels short, unique, and descriptive',
  'Sortable headers are buttons with explicit aria-labels',
  'Prefer textual status values over color alone',
  'Virtualization keeps only visible rows in the DOM — screen readers see the current window',
]

function playgroundCode() {
  return buildPlaygroundCode({
    stripe: playStripe(),
    border: playBorder(),
    size: playSize(),
    rowHeight: 40,
    maxHeight: 280,
  })
}

function filteredRows() {
  const q = String(filterQuery() || '').trim().toLowerCase()
  const st = String(filterStatus() || 'all')
  return filterData.filter((row) => {
    const matchesQuery = !q || [row.name, row.owner, row.status].join(' ').toLowerCase().includes(q)
    const matchesStatus = st === 'all' || row.status === st
    return matchesQuery && matchesStatus
  })
}

function sortLabel() {
  const order = sortOrder() === -1 ? 'desc' : 'asc'
  return 'Sorted by ' + sortField() + ' (' + order + ')'
}

function filterCountLabel() {
  return filteredRows().length + ' row(s) in the virtualized window'
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>TableV2</span>
    </nav>

    <DocsHero
      :kicker=${'Data display'}
      :title=${'TableV2'}
      :description=${'Virtualized table for large lists. Same columns/data shape as Table, plus rowHeight and maxHeight. Configure stripe, border, and size; mark columns sortable for order; compose FilterBar and Select for filtering.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Select :label=${'Size'} :options=${sizeOptions} bind-value=${playSize} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Stripe'} bind-checked=${playStripe} />
            <Switch :label=${'Border'} bind-checked=${playBorder} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <TableV2
              :columns=${columns}
              :data=${data}
              :stripe=${playStripe}
              :border=${playBorder}
              :size=${playSize}
              :rowHeight=${40}
              :maxHeight=${280}
              bind-sortField=${playSortField}
              bind-sortOrder=${playSortOrder}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'table-v2-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'Pass column definitions and row objects with matching prop keys.'}
      :code=${basic}
      :filename=${'table-v2-basic.jcr'}
      :layout=${'stack'}
    >
      <TableV2 :columns=${columns} :data=${data} :border=${true} :maxHeight=${280} />
    </Demo>

    <Demo
      :id=${'virtualized'}
      :title=${'Virtualized (500 rows)'}
      :lead=${'Only a window of rows is rendered. Scroll the body to recycle rows; header stays sticky and tracks horizontal scroll.'}
      :code=${virtualized}
      :filename=${'table-v2-virtualized.jcr'}
      :layout=${'stack'}
    >
      <TableV2
        :columns=${virtualColumns}
        :data=${virtualData}
        :rowHeight=${40}
        :maxHeight=${320}
        :stripe=${true}
        :border=${true}
      />
    </Demo>

    <DocsSection :id=${'types'} :title=${'Types and options'}>
      <Demo
        :id=${'striped'}
        :title=${'Striped rows'}
        :lead=${'Stripe uses the absolute row index, so zebra banding stays correct while virtualizing.'}
        :code=${striped}
        :filename=${'table-v2-striped.jcr'}
        :layout=${'stack'}
      >
        <TableV2 :columns=${plainColumns} :data=${data} :stripe=${true} :border=${true} :maxHeight=${280} />
      </Demo>

      <Demo
        :id=${'bordered'}
        :title=${'Bordered'}
        :lead=${'Borders make dense grids and adjacent values easier to separate.'}
        :code=${bordered}
        :filename=${'table-v2-bordered.jcr'}
        :layout=${'stack'}
      >
        <TableV2 :columns=${plainColumns} :data=${data} :border=${true} :maxHeight=${280} />
      </Demo>

      <Demo
        :id=${'options'}
        :title=${'Combined options'}
        :lead=${'Mix stripe, border, size, rowHeight, and maxHeight for denser admin views.'}
        :code=${options}
        :filename=${'table-v2-options.jcr'}
        :layout=${'stack'}
      >
        <TableV2
          :columns=${columns}
          :data=${data}
          :stripe=${true}
          :border=${true}
          :size=${'sm'}
          :rowHeight=${36}
          :maxHeight=${240}
        />
      </Demo>

      <Demo
        :id=${'sizes'}
        :title=${'Sizes'}
        :lead=${'Pair size with a matching rowHeight so the virtual window stays aligned.'}
        :code=${sizes}
        :filename=${'table-v2-sizes.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'lg'}>
          <Text :weight=${'bold'}>Small</Text>
          <TableV2 :columns=${plainColumns} :data=${data} :size=${'sm'} :border=${true} :rowHeight=${36} :maxHeight=${220} />
          <Text :weight=${'bold'}>Medium</Text>
          <TableV2 :columns=${plainColumns} :data=${data} :size=${'md'} :border=${true} :maxHeight=${220} />
          <Text :weight=${'bold'}>Large</Text>
          <TableV2 :columns=${plainColumns} :data=${data} :size=${'lg'} :border=${true} :rowHeight=${52} :maxHeight=${260} />
        </Stack>
      </Demo>

      <Demo
        :id=${'widths'}
        :title=${'Column widths'}
        :lead=${'Set width as pixels (number or px string) for fixed layout columns.'}
        :code=${widths}
        :filename=${'table-v2-widths.jcr'}
        :layout=${'stack'}
      >
        <TableV2 :columns=${widthColumns} :data=${widthData} :border=${true} :maxHeight=${240} />
      </Demo>

      <Demo
        :id=${'align'}
        :title=${'Column alignment'}
        :lead=${'Set align to start, center, or end on a column definition.'}
        :code=${alignExample}
        :filename=${'table-v2-align.jcr'}
        :layout=${'stack'}
      >
        <TableV2 :columns=${alignColumns} :data=${alignData} :border=${true} :maxHeight=${240} />
      </Demo>
    </DocsSection>

    <DocsSection :id=${'order'} :title=${'Order'}>
      <Demo
        :id=${'sortable'}
        :title=${'Sortable columns'}
        :lead=${'Mark columns with sortable and bind sortField / sortOrder. Sorting runs on the full list before the virtual window is sliced.'}
        :code=${sortable}
        :filename=${'table-v2-sortable.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'sm'}>
          <TableV2
            :columns=${columns}
            :data=${sortData}
            bind-sortField=${sortField}
            bind-sortOrder=${sortOrder}
            :border=${true}
            :stripe=${true}
            :maxHeight=${280}
          />
          <Text :tone=${'muted'}>${() => sortLabel()}</Text>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'filter'} :title=${'Filter'}>
      <Demo
        :id=${'filter-sort'}
        :title=${'Search, status filter, and sort'}
        :lead=${'Filter rows before they reach TableV2, then keep header sorting on the filtered set inside the virtual window.'}
        :code=${filterExample}
        :filename=${'table-v2-filter.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <Stack :direction=${'row'} :gap=${'md'} :wrap=${true} :align=${'end'}>
            <FilterBar :placeholder=${'Search packages…'} bind-query=${filterQuery} />
            <Select :label=${'Status'} :options=${statusOptions} bind-value=${filterStatus} />
          </Stack>
          <TableV2
            :columns=${virtualColumns}
            :data=${() => filteredRows()}
            bind-sortField=${filterSortField}
            bind-sortOrder=${filterSortOrder}
            :rowHeight=${40}
            :maxHeight=${320}
            :border=${true}
            :stripe=${true}
            :emptyText=${'No matching packages'}
          />
          <Text :tone=${'muted'}>${() => filterCountLabel()}</Text>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'empty'} :title=${'Empty'}>
      <Demo
        :id=${'empty-state'}
        :title=${'Empty state'}
        :lead=${'Use emptyText to explain why no rows are available.'}
        :code=${empty}
        :filename=${'table-v2-empty.jcr'}
        :layout=${'stack'}
      >
        <TableV2
          :columns=${plainColumns}
          :data=${[]}
          :emptyText=${'No packages yet'}
          :border=${true}
          :maxHeight=${220}
        />
      </Demo>
    </DocsSection>

    <DocsSection :id=${'when'} :title=${'Table vs TableV2'}>
      <ul class="docs-checklist">
        <li><code>Table</code>${' '}— small/medium lists, simplest markup.</li>
        <li><code>TableV2</code>${' '}— large lists; virtualizes rows with <code>rowHeight</code>${' '}+ <code>maxHeight</code>.</li>
        <li>Both support <code>sortable</code>${' '}columns, <code>align</code>, stripe, border, and size.</li>
        <li>Filter outside the component; pass the filtered array as <code>data</code>.</li>
      </ul>
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
