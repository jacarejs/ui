import { pulse } from '@jacare/core'
import Button from '@jacare/ui/components/Button.jcr'
import Field from '@jacare/ui/components/Field.jcr'
import Dialog from '@jacare/ui/components/Dialog.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  playgroundCode as buildPlaygroundCode,
  sizes,
} from '../../examples/dialog.js'

const contract = getContract('Dialog')
const navLinks = previousNext('/components/dialog')

const playOpen = pulse(false)
const playTitle = pulse('Project details')
const playSize = pulse('md')

const a11y = [
  'Dialog mounts only while open and uses role="dialog" with aria-modal',
  'Escape and backdrop click emit close',
  'Close control is a 44px target with an accessible name',
  'Prefer Confirm for destructive yes/no flows; use Dialog for general content',
]

function playgroundCode() {
  return buildPlaygroundCode({
    open: playOpen(),
    title: playTitle(),
    size: playSize(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Dialog</span>
    </nav>

    <DocsHero
      :kicker=${'Overlay'}
      :title=${'Dialog'}
      :description=${'General modal surface with title, body slot, and optional footer actions. Confirm remains the specialized destructive dialog.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Title'} bind-value=${playTitle} />
          <Field :label=${'Size'} :hint=${'sm, md, or lg'} bind-value=${playSize} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Open'} bind-checked=${playOpen} />
            <Button :variant=${'primary'} on-press=${() => playOpen.set(true)}>Open dialog</Button>
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <p class="docs-lead" style="margin:0">Toggle Open or use the button. The dialog mounts above the page chrome.</p>
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'dialog-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>

      <Dialog bind-open=${playOpen} :title=${playTitle} :size=${playSize}>
        <Text>Use Dialog for general content. Confirm stays for destructive choices.</Text>
        <div class="jui-dialog__actions">
          <Button :variant=${'secondary'} on-press=${() => playOpen.set(false)}>Close</Button>
          <Button :variant=${'primary'} on-press=${() => playOpen.set(false)}>Save</Button>
        </div>
      </Dialog>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'dialog-basic.jcr'} :layout=${'stack'}>
      <Button on-press=${() => playOpen.set(true)}>Open dialog</Button>
      <Dialog bind-open=${playOpen} :title=${'Project details'}>
        <Text>Use Dialog for general content. Confirm stays for destructive choices.</Text>
        <div class="jui-dialog__actions">
          <Button :variant=${'secondary'} on-press=${() => playOpen.set(false)}>Close</Button>
          <Button :variant=${'primary'} on-press=${() => playOpen.set(false)}>Save</Button>
        </div>
      </Dialog>
    </Demo>

    <DocsSection :id=${'sizes'} :title=${'Sizes'}>
      <Demo :id=${'sizes-demo'} :title=${'Small, medium, and large'} :code=${sizes} :filename=${'dialog-sizes.jcr'} :layout=${'rail'}>
        <Stack :direction=${'row'} :gap=${'sm'} :wrap=${true}>
          <Button :size=${'sm'} on-press=${() => { playSize.set('sm'); playOpen.set(true) }}>Small</Button>
          <Button :size=${'sm'} on-press=${() => { playSize.set('md'); playOpen.set(true) }}>Medium</Button>
          <Button :size=${'sm'} on-press=${() => { playSize.set('lg'); playOpen.set(true) }}>Large</Button>
        </Stack>
        <Dialog bind-open=${playOpen} :title=${'Sized dialog'} :size=${playSize}>
          <p>Dialog width follows the size prop.</p>
        </Dialog>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
