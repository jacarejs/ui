import { pulse } from '@jacare/core'
import Dialog from '@jacare/ui/components/Dialog.jcr'
import Button from '@jacare/ui/components/Button.jcr'
import Space from '@jacare/ui/components/Space.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, small, medium, large } from '../../examples/dialog.js'

const contract = getContract('Dialog')
const navLinks = previousNext('/components/dialog')
const basicOpen = pulse(false)
const smallOpen = pulse(false)
const mediumOpen = pulse(false)
const largeOpen = pulse(false)

const a11y = [
  'Open dialogs use role dialog, aria-modal, and an accessible title',
  'Focus is trapped until Escape, backdrop, or close dismisses the dialog',
  'Focus returns to the previously focused trigger after dismissal',
]

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Dialog</span>
    </nav>

    <DocsHero
      :kicker=${'Overlay'}
      :title=${'Dialog'}
      :description=${'Focus-trapped modal surface with controlled open state, accessible title, backdrop and Escape dismissal, and three widths. For footers, mobile sheets, swipe dismiss, and scroll lock, prefer Modal.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'related'} :title=${'Related'}>
      <p class="docs-lead">
        Need a footer region, bottom sheet on phone, or blocking dismiss?
        Use <a jacare-go="/components/modal" href="/components/modal">Modal</a>
        ${' '}with <code>ModalFooter</code>.
      </p>
    </DocsSection>

    <Demo
      :id=${'basic'}
      :title=${'Controlled dialog'}
      :lead=${'Bind open to a pulse so the trigger and dismiss controls share one source of truth.'}
      :code=${basic}
      :filename=${'dialog-basic.jcr'}
      :layout=${'stack'}
    >
      <Button on-press=${() => basicOpen.set(true)}>Open dialog</Button>
      <Dialog bind-open=${basicOpen} :title=${'Project details'}>
        <p>Review the project settings before saving.</p>
        <Space><Button :variant=${'secondary'} on-press=${() => basicOpen.set(false)}>Cancel</Button><Button on-press=${() => basicOpen.set(false)}>Save</Button></Space>
      </Dialog>
    </Demo>
    <Demo
      :id=${'small'}
      :title=${'Small dialog'}
      :lead=${'Small dialogs suit focused decisions and short forms.'}
      :code=${small}
      :filename=${'dialog-small.jcr'}
      :layout=${'stack'}
    >
      <Button :size=${'sm'} on-press=${() => smallOpen.set(true)}>Open small</Button>
      <Dialog bind-open=${smallOpen} :title=${'Rename item'} :size=${'sm'}>
        <p>Small keeps the task focused.</p>
      </Dialog>
    </Demo>
    <Demo
      :id=${'medium'}
      :title=${'Medium dialog'}
      :lead=${'Medium is the default width and fits most forms and review tasks.'}
      :code=${medium}
      :filename=${'dialog-medium.jcr'}
      :layout=${'stack'}
    >
      <Button on-press=${() => mediumOpen.set(true)}>Open medium</Button>
      <Dialog bind-open=${mediumOpen} :title=${'Edit profile'} :size=${'md'}>
        <p>Medium is the default size for most dialog content.</p>
      </Dialog>
    </Demo>
    <Demo
      :id=${'large'}
      :title=${'Large dialog'}
      :lead=${'Large dialogs provide room for richer review content.'}
      :code=${large}
      :filename=${'dialog-large.jcr'}
      :layout=${'stack'}
    >
      <Button on-press=${() => largeOpen.set(true)}>Open large</Button>
      <Dialog bind-open=${largeOpen} :title=${'Release review'} :size=${'lg'}>
        <p>Use the larger surface for multi-section summaries, not simple confirmations.</p>
      </Dialog>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
