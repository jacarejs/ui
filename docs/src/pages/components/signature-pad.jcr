import { pulse } from '@jacare/core'
import SignaturePad from '@jacare/ui/components/SignaturePad.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  clearLabelExample,
  disabledExample,
  hintAndError,
  reactive,
  tallPad,
} from '../../examples/signature-pad.js'

const contract = getContract('SignaturePad')
const navLinks = previousNext('/components/signature-pad')

const signature = pulse('')
const tall = pulse('')
const localized = pulse('')
const hinted = pulse('')
const invalid = pulse('')
const locked = pulse('')
const witness = pulse('')
const clears = pulse(0)

const a11y = [
  'Canvas is exposed as role="img" with an accessible label from label or a default',
  'Clear is a keyboard-reachable button in the toolbar',
  'error uses role="alert"; hint appears under the pad when there is no error',
  'disabled blocks drawing and the clear action',
  'Pointer and touch strokes commit a PNG data URL on pointerup',
]

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>SignaturePad</span>
    </nav>

    <DocsHero
      :kicker=${'Upload'}
      :title=${'SignaturePad'}
      :description=${'Touch-friendly signature canvas that binds a PNG data URL — clear, validate, and preview the result.'}
      :status=${'stable'}
    />

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'Draw with pointer or finger. The bound value becomes a PNG data URL when the stroke ends.'}
      :code=${basic}
      :filename=${'signature-pad-basic.jcr'}
    >
      <SignaturePad :label=${'Sign here'} :hint=${'Use a finger or stylus'} bind-value=${signature} />
    </Demo>

    <Demo
      :id=${'height'}
      :title=${'Custom height'}
      :lead=${'Raise height for tablet or stylus capture (minimum useful size is about 80px).'}
      :code=${tallPad}
      :filename=${'signature-pad-height.jcr'}
    >
      <SignaturePad
        :label=${'Authorization'}
        :height=${260}
        :hint=${'Taller pad for tablet or stylus capture'}
        bind-value=${tall}
      />
    </Demo>

    <Demo
      :id=${'clear-label'}
      :title=${'Localized clear action'}
      :lead=${'Override the toolbar button with clearLabel.'}
      :code=${clearLabelExample}
      :filename=${'signature-pad-clear-label.jcr'}
    >
      <SignaturePad
        :label=${'Cliente'}
        :clearLabel=${'Limpar assinatura'}
        :hint=${'clearLabel localizes the toolbar action'}
        bind-value=${localized}
      />
    </Demo>

    <Demo
      :id=${'hint-error'}
      :title=${'Hint and error'}
      :lead=${'hint guides capture; error replaces it and marks the pad invalid.'}
      :code=${hintAndError}
      :filename=${'signature-pad-states.jcr'}
      :layout=${'stack'}
    >
      <Stack :gap=${'lg'}>
        <SignaturePad
          :label=${'Delivery receipt'}
          :hint=${'Sign to confirm the package was received'}
          bind-value=${hinted}
        />
        <SignaturePad
          :label=${'Contract signature'}
          :error=${'Signature is required before submitting'}
          bind-value=${invalid}
        />
      </Stack>
    </Demo>

    <Demo
      :id=${'disabled'}
      :title=${'Disabled'}
      :lead=${'Freeze the pad after filing — drawing and clear are blocked.'}
      :code=${disabledExample}
      :filename=${'signature-pad-disabled.jcr'}
    >
      <SignaturePad
        :label=${'Archived form'}
        :disabled=${true}
        :hint=${'Locked after the document was filed'}
        bind-value=${locked}
      />
    </Demo>

    <Demo
      :id=${'reactive'}
      :title=${'Preview and clear events'}
      :lead=${'Read the bound data URL for a thumbnail; listen to clear for analytics.'}
      :code=${reactive}
      :filename=${'signature-pad-reactive.jcr'}
      :layout=${'stack'}
    >
      <Stack :gap=${'md'}>
        <SignaturePad
          :label=${'Witness'}
          :hint=${'value is a PNG data URL after the stroke ends'}
          bind-value=${witness}
          on-clear=${() => clears.set(clears() + 1)}
        />
        <Text :tone=${'muted'}>
          ${() => {
            const next = String(witness() || '')
            if (!next) return `Empty · cleared ${clears()} time(s)`
            return `Signed · ${Math.round(next.length / 1024)} KB PNG · cleared ${clears()} time(s)`
          }}
        </Text>
        #if witness()
          <img
            alt="Signature preview"
            src=${witness}
            style="max-width:16rem;border:1px solid var(--j-border);border-radius:var(--j-radius-sm);background:var(--j-surface-2)"
          />
        #end
      </Stack>
    </Demo>

    <AccessibilityChecklist :items=${a11y} />
    <PropsTable :contract=${contract} />
    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
