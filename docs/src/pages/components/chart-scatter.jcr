import { pulse } from '@jacare/core'
import Card from '@jacare/ui/components/Card.jcr'
import ChartScatter from '@jacare/ui/components/ChartScatter.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  colors as colorsExample,
  inCard,
  noLegend,
  playgroundCode as buildPlaygroundCode,
  single,
  sized,
} from '../../examples/chart-scatter.js'

const contract = getContract('ChartScatter')
const navLinks = previousNext('/components/chart-scatter')

const playShowLegend = pulse(true)
const playCustomColors = pulse(false)

const data = {
  series: [
    {
      name: 'Team A',
      data: [
        { x: 12, y: 28 },
        { x: 22, y: 36 },
        { x: 34, y: 24 },
        { x: 48, y: 42 },
      ],
    },
    {
      name: 'Team B',
      data: [
        { x: 18, y: 18 },
        { x: 30, y: 32 },
        { x: 40, y: 46 },
        { x: 52, y: 38 },
      ],
    },
  ],
}

const singleData = [
  { x: 4, y: 12 },
  { x: 8, y: 18 },
  { x: 14, y: 16 },
  { x: 20, y: 24 },
  { x: 26, y: 22 },
]

const colorsData = {
  series: [
    {
      name: 'Alpha',
      data: [
        { x: 10, y: 20 },
        { x: 24, y: 34 },
        { x: 38, y: 28 },
      ],
    },
    {
      name: 'Beta',
      data: [
        { x: 14, y: 16 },
        { x: 28, y: 30 },
        { x: 42, y: 40 },
      ],
    },
  ],
}

const compactData = {
  series: [
    {
      name: 'Points',
      data: [
        { x: 2, y: 8 },
        { x: 6, y: 12 },
        { x: 10, y: 10 },
        { x: 14, y: 16 },
      ],
    },
  ],
}

const npsData = {
  series: [
    {
      name: 'Latency',
      data: [
        { x: 12, y: 48 },
        { x: 28, y: 62 },
        { x: 44, y: 55 },
      ],
    },
  ],
}

const customColors = ['#be185d', '#0f766e']

const a11y = [
  'SVG root uses role="img" with an aria-label from title',
  'Point titles expose coordinates on hover',
  'Legend identifies series when multiple groups are present',
  'Keep point count readable — dense clouds are hard to distinguish',
]

function playgroundCode() {
  return buildPlaygroundCode({
    showLegend: playShowLegend(),
    customColors: playCustomColors(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>ChartScatter</span>
    </nav>

    <DocsHero
      :kicker=${'Charts'}
      :title=${'ChartScatter'}
      :description=${'X/Y point clouds for correlation views with custom colors and optional legend.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Switch :label=${'Show legend'} bind-checked=${playShowLegend} />
          <Switch :label=${'Custom colors'} bind-checked=${playCustomColors} />
          <Text :tone=${'muted'}>Toggle options to preview scatter chart chrome.</Text>
        </div>
        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <ChartScatter
              :data=${data}
              :title=${'Scatter'}
              :caption=${'Playground preview'}
              :showLegend=${playShowLegend}
              :colors=${() => (playCustomColors() ? customColors : null)}
              :width=${480}
              :height=${280}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'chart-scatter-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo
      :id=${'basic'}
      :title=${'Basic'}
      :lead=${'Pass series with { x, y } points. Optional title, caption, width, and height frame the plot.'}
      :code=${basic}
      :filename=${'chart-scatter-basic.jcr'}
      :layout=${'stack'}
    >
      <ChartScatter
        :data=${data}
        :title=${'Scatter'}
        :caption=${'X/Y correlation'}
        :width=${480}
        :height=${280}
      />
    </Demo>

    <DocsSection :id=${'data'} :title=${'Data shapes'}>
      <Demo
        :id=${'single'}
        :title=${'Single series array'}
        :lead=${'Pass a flat array of { x, y } for one cohort.'}
        :code=${single}
        :filename=${'chart-scatter-single.jcr'}
        :layout=${'stack'}
      >
        <ChartScatter :data=${singleData} :title=${'Single cohort'} :showLegend=${false} />
      </Demo>
    </DocsSection>

    <DocsSection :id=${'options'} :title=${'Options'}>
      <Demo
        :id=${'colors'}
        :title=${'Custom colors'}
        :lead=${'colors overrides the default palette in series order.'}
        :code=${colorsExample}
        :filename=${'chart-scatter-colors.jcr'}
        :layout=${'stack'}
      >
        <ChartScatter
          :data=${colorsData}
          :title=${'Custom palette'}
          :colors=${['#be185d', '#1f6feb']}
        />
      </Demo>

      <Demo
        :id=${'no-legend'}
        :title=${'Hide legend'}
        :lead=${'showLegend=false for compact dashboard tiles.'}
        :code=${noLegend}
        :filename=${'chart-scatter-no-legend.jcr'}
        :layout=${'stack'}
      >
        <ChartScatter
          :data=${npsData}
          :title=${'Compact'}
          :caption=${'Legend hidden for dense dashboards'}
          :showLegend=${false}
        />
      </Demo>

      <Demo
        :id=${'sized'}
        :title=${'Custom size'}
        :lead=${'width and height control the SVG viewBox and frame.'}
        :code=${sized}
        :filename=${'chart-scatter-sized.jcr'}
        :layout=${'stack'}
      >
        <ChartScatter
          :data=${compactData}
          :title=${'Compact size'}
          :width=${320}
          :height=${200}
          :showLegend=${false}
        />
      </Demo>
    </DocsSection>

    <DocsSection :id=${'patterns'} :title=${'Patterns'}>
      <Demo
        :id=${'in-card'}
        :title=${'Inside Card'}
        :lead=${'Compose ChartScatter in a Card for performance panels.'}
        :code=${inCard}
        :filename=${'chart-scatter-card.jcr'}
        :layout=${'stack'}
      >
        <Card :title=${'Performance'} :subtitle=${'Throughput vs latency'}>
          <ChartScatter :data=${data} :showLegend=${true} :height=${240} />
        </Card>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
