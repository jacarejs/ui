import { pulse } from '@jacare/core'
import Button from '@jacare/ui/components/Button.jcr'
import Drawer from '@jacare/ui/components/Drawer.jcr'
import Menu from '@jacare/ui/components/Menu.jcr'
import MenuItem from '@jacare/ui/components/MenuItem.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import SubMenu from '@jacare/ui/components/SubMenu.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Text from '@jacare/ui/components/Text.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import {
  basic,
  collapsed,
  collapseToggle as collapseToggleExample,
  horizontal,
  horizontalSubmenu as horizontalSubmenuExample,
  links as linksExample,
  mobile as mobileExample,
  nested as nestedExample,
  selectFeedback as selectFeedbackExample,
  submenu,
} from '../../examples/menu.js'

const contract = getContract('Menu')
const navLinks = previousNext('/components/menu')
const selected = pulse('home')
const feedbackSelected = pulse('home')
const railCollapsed = pulse(false)
const mobileOpen = pulse(false)
const mobileActive = pulse('home')

const a11y = [
  'Menu renders a menubar and items expose menuitem roles',
  'Active state is reinforced with weight and surface color',
  'Disabled items leave the focus order and block selection',
  'Mobile pattern keeps the drawer focus-trapped until a destination is chosen',
]

function selectMobile(value) {
  mobileActive.set(value)
  mobileOpen.set(false)
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>Menu</span>
    </nav>

    <DocsHero
      :kicker=${'Navigation'}
      :title=${'Menu'}
      :description=${'Application navigation with vertical and horizontal modes, nested submenus, collapsed rail, and a mobile drawer pattern for narrow viewports.'}
      :status=${'stable'}
    />

    <Demo
      :id=${'basic'}
      :title=${'Vertical menu'}
      :lead=${'defaultActive marks the initial route and select reports later choices.'}
      :code=${basic}
      :filename=${'menu-basic.jcr'}
      :layout=${'stack'}
    >
      <Menu :defaultActive=${'home'} on-select=${(value) => selected.set(value)}>
        <MenuItem :index=${'home'}>Home</MenuItem>
        <MenuItem :index=${'projects'}>Projects</MenuItem>
        <SubMenu :index=${'settings'} :title=${'Settings'}>
          <MenuItem :index=${'profile'}>Profile</MenuItem>
          <MenuItem :index=${'security'}>Security</MenuItem>
        </SubMenu>
      </Menu>
    </Demo>

    <DocsSection :id=${'mobile'} :title=${'Mobile'}>
      <Demo
        :id=${'mobile-drawer'}
        :title=${'Mobile menu'}
        :lead=${'Compose Button + Drawer + Menu for narrow viewports. Open from a trigger, navigate with nested groups, and close the drawer on select.'}
        :code=${mobileExample}
        :filename=${'menu-mobile.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <Stack :direction=${'row'} :gap=${'md'} :align=${'center'} :wrap=${true}>
            <Button :variant=${'secondary'} on-press=${() => mobileOpen.set(true)}>Open menu</Button>
            <Text :tone=${'muted'}>Active: ${() => mobileActive()}</Text>
          </Stack>
          <Text :tone=${'muted'}>Use this pattern for hamburger navigation on phones and small tablets.</Text>
        </Stack>

        <Drawer
          bind-open=${mobileOpen}
          :title=${'Navigation'}
          :direction=${'ltr'}
          :size=${'18rem'}
        >
          <Menu :defaultActive=${'home'} on-select=${selectMobile}>
            <MenuItem :index=${'home'}>Home</MenuItem>
            <MenuItem :index=${'search'}>Search</MenuItem>
            <SubMenu :index=${'explore'} :title=${'Explore'}>
              <MenuItem :index=${'projects'}>Projects</MenuItem>
              <MenuItem :index=${'teams'}>Teams</MenuItem>
              <MenuItem :index=${'templates'}>Templates</MenuItem>
            </SubMenu>
            <SubMenu :index=${'account'} :title=${'Account'}>
              <MenuItem :index=${'profile'}>Profile</MenuItem>
              <MenuItem :index=${'billing'}>Billing</MenuItem>
              <MenuItem :index=${'security'}>Security</MenuItem>
              <MenuItem :index=${'notifications'}>Notifications</MenuItem>
            </SubMenu>
            <MenuItem :index=${'help'}>Help</MenuItem>
            <MenuItem :index=${'signout'} :disabled=${true}>Sign out</MenuItem>
          </Menu>
        </Drawer>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'modes'} :title=${'Modes'}>
      <Demo
        :id=${'horizontal'}
        :title=${'Horizontal mode'}
        :lead=${'Use horizontal navigation for compact top-level destinations.'}
        :code=${horizontal}
        :filename=${'menu-horizontal.jcr'}
        :layout=${'stack'}
      >
        <Menu :mode=${'horizontal'} :defaultActive=${'overview'}>
          <MenuItem :index=${'overview'}>Overview</MenuItem>
          <MenuItem :index=${'activity'}>Activity</MenuItem>
          <MenuItem :index=${'team'}>Team</MenuItem>
        </Menu>
      </Demo>

      <Demo
        :id=${'horizontal-submenu'}
        :title=${'Horizontal with submenu'}
        :lead=${'Nest groups inside a horizontal menubar for product sections.'}
        :code=${horizontalSubmenuExample}
        :filename=${'menu-horizontal-submenu.jcr'}
        :layout=${'stack'}
      >
        <Menu :mode=${'horizontal'} :defaultActive=${'overview'}>
          <MenuItem :index=${'overview'}>Overview</MenuItem>
          <SubMenu :index=${'product'} :title=${'Product'}>
            <MenuItem :index=${'features'}>Features</MenuItem>
            <MenuItem :index=${'pricing'}>Pricing</MenuItem>
            <MenuItem :index=${'changelog'}>Changelog</MenuItem>
          </SubMenu>
          <MenuItem :index=${'team'}>Team</MenuItem>
        </Menu>
      </Demo>

      <Demo
        :id=${'collapsed'}
        :title=${'Collapsed rail'}
        :lead=${'collapse preserves menu semantics while visually reducing the rail.'}
        :code=${collapsed}
        :filename=${'menu-collapsed.jcr'}
        :layout=${'stack'}
      >
        <Menu :defaultActive=${'inbox'} :collapse=${true}>
          <MenuItem :index=${'inbox'}>Inbox</MenuItem>
          <MenuItem :index=${'calendar'}>Calendar</MenuItem>
          <MenuItem :index=${'reports'}>Reports</MenuItem>
        </Menu>
      </Demo>

      <Demo
        :id=${'collapse-toggle'}
        :title=${'Toggle collapse'}
        :lead=${'Bind collapse to a Switch for expandable sidebar rails.'}
        :code=${collapseToggleExample}
        :filename=${'menu-collapse-toggle.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <Switch :label=${'Collapse rail'} bind-checked=${railCollapsed} />
          <Menu :defaultActive=${'inbox'} :collapse=${railCollapsed}>
            <MenuItem :index=${'inbox'}>Inbox</MenuItem>
            <MenuItem :index=${'calendar'}>Calendar</MenuItem>
            <SubMenu :index=${'reports'} :title=${'Reports'}>
              <MenuItem :index=${'weekly'}>Weekly</MenuItem>
              <MenuItem :index=${'monthly'}>Monthly</MenuItem>
            </SubMenu>
          </Menu>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'structure'} :title=${'Structure'}>
      <Demo
        :id=${'submenu'}
        :title=${'Nested submenu'}
        :lead=${'Group related destinations and keep unavailable routes visible with disabled items.'}
        :code=${submenu}
        :filename=${'menu-submenu.jcr'}
        :layout=${'stack'}
      >
        <Menu :defaultActive=${'members'}>
          <MenuItem :index=${'dashboard'}>Dashboard</MenuItem>
          <SubMenu :index=${'workspace'} :title=${'Workspace'}>
            <MenuItem :index=${'members'}>Members</MenuItem>
            <MenuItem :index=${'permissions'}>Permissions</MenuItem>
            <MenuItem :index=${'billing'} :disabled=${true}>Billing</MenuItem>
          </SubMenu>
        </Menu>
      </Demo>

      <Demo
        :id=${'nested'}
        :title=${'Deep nesting'}
        :lead=${'Stack SubMenu levels for admin trees and dense IA.'}
        :code=${nestedExample}
        :filename=${'menu-nested.jcr'}
        :layout=${'stack'}
      >
        <Menu :defaultActive=${'roles'}>
          <MenuItem :index=${'home'}>Home</MenuItem>
          <SubMenu :index=${'admin'} :title=${'Admin'}>
            <MenuItem :index=${'users'}>Users</MenuItem>
            <SubMenu :index=${'access'} :title=${'Access'}>
              <MenuItem :index=${'roles'}>Roles</MenuItem>
              <MenuItem :index=${'policies'}>Policies</MenuItem>
            </SubMenu>
          </SubMenu>
        </Menu>
      </Demo>

      <Demo
        :id=${'links'}
        :title=${'Items with href'}
        :lead=${'Pass href for real navigation anchors. Disabled items stay visible but non-interactive.'}
        :code=${linksExample}
        :filename=${'menu-links.jcr'}
        :layout=${'stack'}
      >
        <Menu :defaultActive=${'docs'}>
          <MenuItem :index=${'docs'} :href=${'/components/menu'}>Docs</MenuItem>
          <MenuItem :index=${'github'} :href=${'https://github.com'}>GitHub</MenuItem>
          <MenuItem :index=${'disabled'} :href=${'/x'} :disabled=${true}>Disabled link</MenuItem>
        </Menu>
      </Demo>

      <Demo
        :id=${'select'}
        :title=${'Select feedback'}
        :lead=${'on-select receives the item index so you can sync route state or labels.'}
        :code=${selectFeedbackExample}
        :filename=${'menu-select.jcr'}
        :layout=${'stack'}
      >
        <Stack :gap=${'md'}>
          <Text>Selected: ${() => feedbackSelected()}</Text>
          <Menu :defaultActive=${'home'} on-select=${(value) => feedbackSelected.set(value)}>
            <MenuItem :index=${'home'}>Home</MenuItem>
            <MenuItem :index=${'inbox'}>Inbox</MenuItem>
            <SubMenu :index=${'more'} :title=${'More'}>
              <MenuItem :index=${'archive'}>Archive</MenuItem>
              <MenuItem :index=${'trash'}>Trash</MenuItem>
            </SubMenu>
          </Menu>
        </Stack>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
