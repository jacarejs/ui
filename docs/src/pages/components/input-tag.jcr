import { pulse } from '@jacare/core'
import Field from '@jacare/ui/components/Field.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import InputTag from '@jacare/ui/components/InputTag.jcr'
import DocsHero from '../../ui/DocsHero.jcr'
import Demo from '../../ui/Demo.jcr'
import DocsSection from '../../ui/DocsSection.jcr'
import PropsTable from '../../ui/PropsTable.jcr'
import PreviousNext from '../../ui/PreviousNext.jcr'
import CodeBlock from '../../ui/CodeBlock.jcr'
import AccessibilityChecklist from '../../ui/AccessibilityChecklist.jcr'
import { getContract } from '../../generated/contracts.js'
import { previousNext } from '../../nav-data.js'
import { basic, clearable, delimiter, limit, playgroundCode as buildPlaygroundCode, states } from '../../examples/input-tag.js'

const contract = getContract('InputTag')
const navLinks = previousNext('/components/input-tag')

const playLabel = pulse('Frameworks')
const playValue = pulse(['vue', 'react'])
const playPlaceholder = pulse('Add a framework')
const playMax = pulse('')
const playClearable = pulse(true)
const playDisabled = pulse(false)
const basicValue = pulse(['vue', 'react'])
const delimiterValue = pulse(['design'])
const limitValue = pulse(['frontend', 'accessibility'])
const clearValue = pulse(['vue', 'jacare'])
const fixedValue = pulse(['core', 'ui'])
const requiredValue = pulse([])
const errorValue = pulse(['draft'])
const disabledValue = pulse(['locked', 'archived'])
const a11y = [
  'Every tag remove button includes the tag text in its accessible name',
  'Backspace removes the last tag only when the text field is empty',
  'The configured delimiter and blur both commit non-empty, unique tags',
  'required is visible in the label and error text is announced with role="alert"',
  'At the max limit the entry field is disabled while existing tags remain removable',
]

function playgroundCode() {
  return buildPlaygroundCode({
    label: playLabel(),
    value: playValue(),
    placeholder: playPlaceholder(),
    max: playMax(),
    clearable: playClearable(),
    disabled: playDisabled(),
  })
}

export <view>
  <article class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Breadcrumb">
      <a jacare-go="/components" href="/components">Components</a>
      <span aria-hidden="true">/</span>
      <span>InputTag</span>
    </nav>

    <DocsHero
      :kicker=${'Inputs'}
      :title=${'InputTag'}
      :description=${'Free-form tag entry with delimiter commit, duplicate guarding, and a max tag limit.'}
      :status=${'stable'}
    />

    <DocsSection :id=${'playground'} :title=${'Playground'}>
      <div class="docs-alert-play">
        <div class="docs-alert-play__controls docs-panel">
          <Field :label=${'Label'} bind-value=${playLabel} />
          <Field :label=${'Placeholder'} bind-value=${playPlaceholder} />
          <Field :label=${'Max tags'} :type=${'number'} :hint=${'Leave empty for no limit'} bind-value=${playMax} />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true}>
            <Switch :label=${'Clearable'} bind-checked=${playClearable} />
            <Switch :label=${'Disabled'} bind-checked=${playDisabled} />
          </Stack>
        </div>

        <div class="docs-alert-play__preview">
          <div class="docs-panel">
            <InputTag
              :label=${playLabel}
              :placeholder=${playPlaceholder}
              :max=${() => (playMax() === '' ? null : Number(playMax()))}
              :clearable=${playClearable}
              :disabled=${playDisabled}
              bind-value=${playValue}
            />
          </div>
          <CodeBlock :code=${() => playgroundCode()} :filename=${'input-tag-playground.jcr'} :language=${'jacare'} />
        </div>
      </div>
    </DocsSection>

    <Demo :id=${'basic'} :title=${'Basic'} :code=${basic} :filename=${'input-tag-basic.jcr'}>
      <InputTag :label=${'Frameworks'} :placeholder=${'Add a framework'} bind-value=${basicValue} />
    </Demo>

    <Demo :id=${'delimiter'} :title=${'Custom delimiter'} :code=${delimiter} :filename=${'input-tag-delimiter.jcr'}>
      <InputTag :label=${'Skills'} :delimiter=${','} :hint=${'Press comma to add each skill'} bind-value=${delimiterValue} />
    </Demo>

    <Demo :id=${'limit'} :title=${'Tag limit'} :code=${limit} :filename=${'input-tag-limit.jcr'}>
      <InputTag :label=${'Topics'} :max=${3} :placeholder=${'Add one more topic'} :hint=${'Maximum of three topics'} bind-value=${limitValue} />
    </Demo>

    <Demo :id=${'clearable'} :title=${'Clear behavior'} :code=${clearable} :filename=${'input-tag-clearable.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <InputTag :label=${'Clearable'} :clearable=${true} bind-value=${clearValue} />
        <InputTag :label=${'No clear-all action'} :clearable=${false} bind-value=${fixedValue} />
      </Stack>
    </Demo>

    <Demo :id=${'states'} :title=${'Validation and disabled states'} :code=${states} :filename=${'input-tag-states.jcr'} :layout=${'stack'}>
      <Stack :gap=${'md'}>
        <InputTag :label=${'Required labels'} :required=${true} :hint=${'Add at least one label'} bind-value=${requiredValue} />
        <InputTag :label=${'Release labels'} :error=${'Draft is not allowed here'} bind-value=${errorValue} />
        <InputTag :label=${'Read-only labels'} :disabled=${true} bind-value=${disabledValue} />
      </Stack>
    </Demo>

    <DocsSection :id=${'accessibility'} :title=${'Accessibility'}>
      <AccessibilityChecklist :items=${a11y} />
    </DocsSection>

    <DocsSection :id=${'api'} :title=${'API'}>
      <PropsTable :contract=${contract} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
