import { pulse, derive } from '@jacare/core'
import DocsHero from '../ui/DocsHero.jcr'
import DocsSection from '../ui/DocsSection.jcr'
import CodeBlock from '../ui/CodeBlock.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext, docsSiteUrl } from '../nav-data.js'
import { managers, themeImport, componentImports, viteConfig } from '../examples/install.js'

const navLinks = previousNext('/install')
const active = pulse('npm')

const selected = derive(() => managers.find((item) => item.id === active()) || managers[0])
const installCode = derive(() => selected().code)
const installFile = derive(() => selected().filename)
const toolsCode = derive(() => {
  const id = active()
  if (id === 'yarn') return `yarn add -D @jacare/vite-plugin @jacare/compiler`
  if (id === 'pnpm') return `pnpm add -D @jacare/vite-plugin @jacare/compiler`
  if (id === 'bun') return `bun add -d @jacare/vite-plugin @jacare/compiler`
  return `npm install -D @jacare/vite-plugin @jacare/compiler`
})

export <view>
  <article class="docs-page">
    <DocsHero
      :kicker=${'Getting started'}
      :title=${'Installation'}
      :description=${'Install @jacare/ui alongside @jacare/core, add the Vite plugin for .jcr compilation, import theme.css once, then deep-import components the same way every docs demo does.'}
    />

    <p class="docs-lead">
      Full documentation:
      <a href=${docsSiteUrl} target="_blank" rel="noreferrer">${docsSiteUrl}</a>
    </p>

    <DocsSection :id=${'package'} :title=${'Package'}>
      <p class="docs-lead">
        Pick your package manager. All of these install the UI library and its peer dependency
        <code>@jacare/core</code> (^0.1.12).
      </p>

      <div class="docs-pkg-tabs" role="tablist" aria-label="Package manager">
        #for managers as manager (manager.id)
          <button
            type="button"
            class="docs-pkg-tab"
            class-is-active=${active() === manager.id}
            role="tab"
            aria-selected=${active() === manager.id}
            on-click=${() => active.set(manager.id)}
          >
            ${manager.label}
          </button>
        #end
      </div>

      <CodeBlock :code=${installCode} :filename=${installFile} :language=${'bash'} />
    </DocsSection>

    <DocsSection :id=${'tooling'} :title=${'Compiler tooling'}>
      <p class="docs-lead">
        For Vite apps that compile <code>.jcr</code> files, also add the Jacaré Vite plugin and compiler
        as development dependencies.
      </p>
      <CodeBlock :code=${toolsCode} :filename=${installFile} :language=${'bash'} />
      <CodeBlock :code=${viteConfig} :filename=${'vite.config.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'theme'} :title=${'Import the theme'}>
      <p class="docs-lead">
        Import the theme once at your app entry, then call <code>applyTheme</code> so light, dark, and system modes resolve before the first paint.
      </p>
      <CodeBlock :code=${themeImport} :filename=${'main.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'imports'} :title=${'Import components'}>
      <p class="docs-lead">
        Prefer deep imports like <code>@jacare/ui/Button</code> — that is the canonical path used across the docs. The package barrel also exports named members if you prefer a single import site.
      </p>
      <CodeBlock :code=${componentImports} :filename=${'app.jcr'} :language=${'javascript'} />
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
