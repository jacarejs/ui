import DocsHero from '../ui/DocsHero.jcr'
import { shippedComponents, componentHref } from '../nav-data.js'

const catalog = shippedComponents.filter(
  (item) => !['ThemeScope', 'ThemeToggle', 'VisuallyHidden'].includes(item.name),
)

export <view>
  <article class="docs-page">
    <DocsHero
      :kicker=${'Components'}
      :title=${'Catalog'}
      :description=${'Browse every shipped primitive in @jacare/ui. Each card opens a page with a live demo, always-visible source, generated API from the .jcr contract, and previous/next navigation.'}
    />

    <div class="docs-card-grid">
      #for catalog as item (item.name)
        <a class="docs-card docs-panel" jacare-go=${componentHref(item.name)} href=${componentHref(item.name)}>
          <h3>${item.name}</h3>
          <p>${item.blurb}</p>
        </a>
      #end
    </div>
  </article>
</view>
