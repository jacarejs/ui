import Button from '@jacare/ui/components/Button.jcr'
import DocsHero from '../ui/DocsHero.jcr'
import DocsSection from '../ui/DocsSection.jcr'
import Demo from '../ui/Demo.jcr'
import CodeBlock from '../ui/CodeBlock.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext } from '../nav-data.js'
import { install, viteConfig, boot, firstComponent } from '../examples/quick-start.js'

const navLinks = previousNext('/quick-start')

export <view>
  <article class="docs-page">
    <DocsHero
      :kicker=${'Getting started'}
      :title=${'Quick start'}
      :description=${'Install packages, wire the Vite plugin, import the theme, and mount a .jcr view with a Button. Five minutes from empty app to a live Jacaré UI control.'}
    />

    <DocsSection :id=${'install'} :title=${'1. Install packages'}>
      <p class="docs-lead">
        Add <code>@jacare/ui</code> with its peer <code>@jacare/core</code>, plus the compiler tooling for Vite.
      </p>
      <CodeBlock :code=${install} :filename=${'terminal'} :language=${'bash'} />
    </DocsSection>

    <DocsSection :id=${'vite'} :title=${'2. Add the Vite plugin'}>
      <p class="docs-lead">
        Register <code>jacare()</code> so <code>.jcr</code> files compile during development and production builds.
      </p>
      <CodeBlock :code=${viteConfig} :filename=${'vite.config.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'boot'} :title=${'3. Import the theme and mount'}>
      <p class="docs-lead">
        Import <code>theme.css</code> once at the app entry, call <code>applyTheme</code>, then mount your root view.
      </p>
      <CodeBlock :code=${boot} :filename=${'boot.js'} :language=${'javascript'} />
    </DocsSection>

    <DocsSection :id=${'first'} :title=${'4. Render a Button'}>
      <Demo
        :id=${'first-button'}
        :title=${'Your first component'}
        :lead=${'Deep-import components from @jacare/ui/Button (or any other primitive). Props use :name=\${...} and pulses bind with bind-*.'}
        :code=${firstComponent}
        :filename=${'app.jcr'}
      >
        <Button :variant=${'primary'}>Continue</Button>
      </Demo>
    </DocsSection>

    <DocsSection :id=${'next'} :title=${'5. What to explore next'}>
      <ul class="docs-checklist">
        <li>Browse the component catalog for playgrounds and API tables</li>
        <li>Tune tokens in Theme, or try live edits in the Theme Editor</li>
        <li>Follow Accessibility for focus, labels, and reduced motion</li>
      </ul>
    </DocsSection>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
