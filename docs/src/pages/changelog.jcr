import DocsHero from '../ui/DocsHero.jcr'
import PreviousNext from '../ui/PreviousNext.jcr'
import { previousNext } from '../nav-data.js'

const navLinks = previousNext('/changelog')

export <view>
  <article class="docs-page">
    <DocsHero
      :kicker=${'Tools'}
      :title=${'Changelog'}
      :description=${'Release notes for @jacare/ui — new components, theme changes, breaking API updates, and docs improvements. Start here when upgrading between versions.'}
    />

    <div class="docs-panel" style="padding:1.25rem">
      <h2 class="docs-section-title" style="margin-top:0">Unreleased</h2>
      <p class="docs-lead" style="margin-top:0">Forms suite, theme density/motion, and docs tools.</p>
      <ul class="docs-checklist">
        <li>Forms — Autocomplete, Cascader, ColorPickerPanel, DatePickerPanel, DateTimePicker (composes DatePicker + TimePicker), Form/FormItem, Input family, Mention, Radio, Rate, SelectV2, Slider, TimePicker, TimeSelect, Transfer, TreeSelect, Upload</li>
        <li>Theme — <code>--j-density</code>, control sizing tokens, <code>--j-duration-slow</code>, <code>--j-ease-in-out</code>, <code>applyDensity</code>, <code>applyMotion</code></li>
        <li>Docs tools — Viewport Lab (320/390/768 + Tap River checklist), Density Preview, Motion Lab</li>
        <li>Theme docs — custom fonts, Tailwind bridge, density and motion guides</li>
        <li>Theme Editor — expanded presets, sticky live preview, custom themes in localStorage</li>
        <li>Token reference — catalog with filter, copy, and motion/density tokens</li>
        <li>i18n — <code>@jacare/ui/i18n</code> with <code>createI18n</code>, <code>t()</code>, nested keys, <code>{params}</code>, fallback locale, persist, and <code>LocaleToggle</code>; full foundations docs</li>
        <li>Docs brand — Jacaré SVG logo in the shell, home hero, and Theme Editor preview; colors follow <code>--j-primary</code>, <code>--j-leaf</code>, and <code>--j-surface-2</code></li>
        <li>Unit tests — <code>yarn test:coverage</code> at <strong>100%</strong> statements, branches, functions, and lines (theme helpers, docs stores, navigate, and critical components); branch threshold enforced at 100%</li>
      </ul>
    </div>

    <div class="docs-panel" style="padding:1.25rem">
      <h2 class="docs-section-title" style="margin-top:0">0.1.1</h2>
      <p class="docs-lead" style="margin-top:0">Layout primitives and composition models on the canopy palette.</p>
      <ul class="docs-checklist">
        <li><code>Flex</code> — full flexbox positioning with reverse axes, justify, wrap, and inline</li>
        <li><code>Grid</code> — CSS grid tracks (<code>1</code>–<code>12</code>, <code>auto</code>) with dense packing</li>
        <li><code>Select</code> — searchable single/multi dropdown with string or tagged options</li>
        <li><code>DatePicker</code> — typed or calendar date input with range and bounds support</li>
        <li><code>Confirm</code> — modal confirmation dialog with danger and busy states</li>
        <li><code>Icon</code> — stroke icon set with sizes, tones, and accessible labels</li>
        <li><code>Textarea</code> — multiline field with character count and resize</li>
        <li><code>RadioGroup</code> — single-choice list or selectable cards</li>
        <li><code>Dialog</code> — general modal with body and footer slots</li>
        <li>Docs demos — Element Plus–style stage card, Show/Hide source, stacked examples</li>
        <li>Docs shell polish — brand-first home, clearer nav, overlay stacking above code</li>
        <li>Layouts docs — shell, sidebar, split, gallery, and toolbar recipes using canopy tokens</li>
        <li>Docs fixes for Pages mounts, logo base path, CodeBlock spacing/copy state, and <code>boot.js</code> filenames</li>
      </ul>
    </div>

    <div class="docs-panel" style="padding:1.25rem">
      <h2 class="docs-section-title" style="margin-top:0">0.1.0</h2>
      <p class="docs-lead" style="margin-top:0">Initial public release of the Jacaré UI package and docs site.</p>
      <ul class="docs-checklist">
        <li>Core primitives: Alert, Avatar, Badge, Button, Card, Checkbox, ColorPicker, Divider, Field, Progress, Spinner, Stack, Switch, Text</li>
        <li>Foundations: ThemeScope, ThemeToggle, VisuallyHidden</li>
        <li>Light + canopy dark <code>--j-*</code> tokens with semantic aliases</li>
        <li><code>applyTheme</code> for light, dark, or system preferences</li>
        <li>Docs site with playgrounds, live demos, Theme Editor, and accessibility notes</li>
      </ul>
    </div>

    <PreviousNext :previous=${navLinks.previous} :next=${navLinks.next} />
  </article>
</view>
