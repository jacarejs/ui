export <contract>
  props: {
    previous: { type: 'object', default: null }
    prev: { type: 'object', default: null }
    next: { type: 'object', default: null }
  }
</contract>

function read(value) {
  return typeof value === 'function' ? value() : value
}

function linkItem(previousValue, prevValue) {
  return read(previousValue) || read(prevValue) || null
}

function linkHref(value) {
  const item = read(value)
  return item?.href || '#'
}

function linkLabel(value) {
  const item = read(value)
  return item?.label || ''
}

export <view>
  <nav class="docs-prevnext" aria-label="Previous and next">
    #if linkItem(previous, prev)
      <a jacare-go=${linkHref(linkItem(previous, prev))} href=${linkHref(linkItem(previous, prev))}>
        <span>Previous</span>
        <strong>${linkLabel(linkItem(previous, prev))}</strong>
      </a>
    #else
      <span></span>
    #end

    #if read(next)
      <a class="is-next" jacare-go=${linkHref(next)} href=${linkHref(next)}>
        <span>Next</span>
        <strong>${linkLabel(next)}</strong>
      </a>
    #end
  </nav>
</view>
