import CodeBlock from './CodeBlock.jcr'

export <contract>
  props: {
    id: { type: 'string', default: '' }
    title: { type: 'string', required: true }
    lead: { type: 'string', default: '' }
    code: { type: 'string', required: true }
    filename: { type: 'string', default: 'example.jcr' }
    layout: { type: 'string', default: 'split' }
  }
  slots: ['default']
</contract>

function read(value) {
  return typeof value === 'function' ? value() : value
}

function layoutOf(value) {
  const next = read(value)
  if (next === 'stack' || next === 'bleed' || next === 'rail') return next
  return 'split'
}

export <view>
  <section
    class="docs-demo"
    class-docs-demo--stack=${() => layoutOf(layout) === 'stack'}
    class-docs-demo--bleed=${() => layoutOf(layout) === 'bleed'}
    class-docs-demo--rail=${() => layoutOf(layout) === 'rail'}
    id=${id}
  >
    <header class="docs-demo-head">
      <div>
        <h3 class="docs-demo-title">${title}</h3>
        #if read(lead)
          <p class="docs-demo-lead">${lead}</p>
        #end
      </div>
    </header>

    <div class="docs-demo-grid">
      <div class="docs-demo-live docs-panel">
        <div class="docs-demo-live-inner"><slot /></div>
      </div>

      <CodeBlock :code=${code} :filename=${filename} :language=${'jacare'} />
    </div>
  </section>
</view>
