import { pulse } from '@jacare/core'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'string', default: '', model: true }
    placeholder: { type: 'string', default: '' }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
    disabled: { type: 'boolean', default: false }
    required: { type: 'boolean', default: false }
    clearable: { type: 'boolean', default: false }
    meter: { type: 'boolean', default: true }
    size: { type: 'string', default: 'md' }
    name: { type: 'string', default: '' }
    autocomplete: { type: 'string', default: 'current-password' }
    maxLength: { type: 'number', default: 0 }
  }
  emits: ['change', 'clear', 'strength']
</contract>

const LEVELS = ['', 'Weak', 'Fair', 'Good', 'Strong']

function sizeClass(value) {
  const next = read(value)
  if (next === 'sm' || next === 'lg') return next
  return 'md'
}

function maxChars(value) {
  const next = Number(read(value))
  return Number.isFinite(next) && next > 0 ? Math.round(next) : 0
}

function visibleState(emitFn) {
  if (!emitFn.__juiPasswordVisible) emitFn.__juiPasswordVisible = pulse(false)
  return emitFn.__juiPasswordVisible
}

function strengthScore(password) {
  const text = String(password || '')
  if (!text) return 0
  let score = 0
  if (text.length >= 8) score += 1
  if (text.length >= 12) score += 1
  if (/[a-z]/.test(text) && /[A-Z]/.test(text)) score += 1
  if (/\d/.test(text)) score += 1
  if (/[^A-Za-z0-9]/.test(text)) score += 1
  return Math.min(4, score)
}

function strengthLabel(password) {
  return LEVELS[strengthScore(password)] || ''
}

function commit(model, next, emitFn) {
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
  emitFn('strength', { score: strengthScore(next), label: strengthLabel(next) })
}

function clearValue(model, emitFn) {
  commit(model, '', emitFn)
  emitFn('clear')
}

function toggleVisible(emitFn, disabledValue) {
  if (read(disabledValue)) return
  const visible = visibleState(emitFn)
  visible.set(!read(visible))
}

export <view>
  <label
    class="jui-input-password"
    class-jui-input-password--sm=${() => sizeClass(size) === 'sm'}
    class-jui-input-password--lg=${() => sizeClass(size) === 'lg'}
    class-has-error=${() => !!read(error)}
    class-is-disabled=${() => !!read(disabled)}
  >
    #if read(label)
      <span class="jui-input-password__label">
        ${() => read(label)}
        #if read(required)
          <span class="jui-input-password__req" aria-hidden="true">*</span>
        #end
      </span>
    #end

    <span class="jui-input-password__control">
      <input
        class="jui-input-password__field"
        type=${() => (read(visibleState(emit)) ? 'text' : 'password')}
        name=${() => read(name) || ''}
        autocomplete=${() => read(autocomplete) || 'current-password'}
        placeholder=${() => read(placeholder) || ''}
        disabled=${() => !!read(disabled)}
        required=${() => !!read(required)}
        maxlength=${() => {
          const limit = maxChars(maxLength)
          return limit > 0 ? limit : undefined
        }}
        aria-invalid=${() => !!read(error)}
        value=${() => read(value)}
        on-input=${(event) => commit(value, event.target.value, emit)}
      />
      #if read(clearable) && !read(disabled) && read(value)
        <button type="button" class="jui-input-password__clear" aria-label="Clear" on-click=${() => clearValue(value, emit)}>×</button>
      #end
      <button
        type="button"
        class="jui-input-password__toggle"
        aria-label=${() => (read(visibleState(emit)) ? 'Hide password' : 'Show password')}
        aria-pressed=${() => !!read(visibleState(emit))}
        disabled=${() => !!read(disabled)}
        on-click=${() => toggleVisible(emit, disabled)}
      >
        ${() => (read(visibleState(emit)) ? 'Hide' : 'Show')}
      </button>
    </span>

    #if read(meter) && read(value)
      <span
        class="jui-input-password__meter"
        class-is-weak=${() => strengthScore(read(value)) === 1}
        class-is-fair=${() => strengthScore(read(value)) === 2}
        class-is-good=${() => strengthScore(read(value)) === 3}
        class-is-strong=${() => strengthScore(read(value)) >= 4}
        role="status"
        aria-live="polite"
      >
        <span class="jui-input-password__meter-bar" aria-hidden="true">
          <span class="jui-input-password__meter-fill" style=${() => `--jui-pw-score:${strengthScore(read(value))}`}></span>
        </span>
        <span class="jui-input-password__meter-label">${() => strengthLabel(read(value))}</span>
      </span>
    #end

    #if read(error)
      <span class="jui-input-password__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-input-password__hint">${() => read(hint)}</span>
    #end
  </label>
</view>

export <style>
.jui-input-password {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-input-password__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-text);
}

.jui-input-password__req {
  color: var(--j-danger);
}

.jui-input-password__control {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  width: 100%;
  min-height: calc(var(--j-control-height, 2.5rem) + 0.25rem);
  padding: 0 calc(var(--j-control-padding-x, 1.15rem) * 0.75);
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  background: var(--j-surface-2);
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

.jui-input-password--sm .jui-input-password__control {
  min-height: 2.1rem;
  padding: 0 0.65rem;
}

.jui-input-password--lg .jui-input-password__control {
  min-height: 3.1rem;
  padding: 0 1rem;
}

.jui-input-password__control:focus-within {
  border-color: var(--j-primary);
  box-shadow: var(--j-focus);
}

.jui-input-password__field {
  flex: 1 1 auto;
  min-width: 0;
  height: 100%;
  padding: 0.6rem 0;
  border: 0;
  background: transparent;
  color: var(--j-text);
  font: inherit;
  outline: none;
}

.jui-input-password--sm .jui-input-password__field {
  font-size: 0.875rem;
}

.jui-input-password--lg .jui-input-password__field {
  font-size: 1.05rem;
}

.jui-input-password__field::placeholder {
  color: color-mix(in srgb, var(--j-muted) 75%, white);
}

.jui-input-password__clear,
.jui-input-password__toggle {
  flex: 0 0 auto;
  border: 0;
  background: transparent;
  color: var(--j-muted);
  cursor: pointer;
  font: inherit;
  line-height: 1;
}

.jui-input-password__clear {
  display: grid;
  place-items: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 999px;
  font-size: 1rem;
}

.jui-input-password__clear:hover {
  color: var(--j-danger);
}

.jui-input-password__toggle {
  padding: 0.2rem 0.35rem;
  border-radius: var(--j-radius-sm);
  font-size: 0.8rem;
  font-weight: 700;
}

.jui-input-password__toggle:hover:not(:disabled) {
  color: var(--j-primary);
}

.jui-input-password__toggle:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.jui-input-password__meter {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.55rem;
  align-items: center;
}

.jui-input-password__meter-bar {
  display: block;
  height: 0.35rem;
  overflow: hidden;
  border-radius: 999px;
  background: var(--j-border);
}

.jui-input-password__meter-fill {
  display: block;
  height: 100%;
  width: calc(var(--jui-pw-score, 0) * 25%);
  border-radius: inherit;
  background: var(--j-muted);
  transition: width 160ms ease, background 160ms ease;
}

.jui-input-password__meter.is-weak .jui-input-password__meter-fill {
  background: var(--j-danger);
}

.jui-input-password__meter.is-fair .jui-input-password__meter-fill {
  background: var(--j-warn, #d97706);
}

.jui-input-password__meter.is-good .jui-input-password__meter-fill {
  background: var(--j-info, #2563eb);
}

.jui-input-password__meter.is-strong .jui-input-password__meter-fill {
  background: var(--j-primary);
}

.jui-input-password__meter-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--j-muted);
}

.jui-input-password.has-error .jui-input-password__control {
  border-color: var(--j-danger);
}

.jui-input-password.is-disabled {
  opacity: 0.65;
}

.jui-input-password__hint,
.jui-input-password__error {
  font-size: 0.8rem;
}

.jui-input-password__hint {
  color: var(--j-muted);
}

.jui-input-password__error {
  color: var(--j-danger);
  font-weight: 600;
}
</style>
