import { effect, pulse } from '@jacare/core'

export <contract>
  props: {
    tone: { type: 'string', default: 'info' }
    title: { type: 'string', default: '' }
    dismissible: { type: 'boolean', default: false }
    open: { type: 'boolean', default: true, model: true }
    duration: { type: 'number', default: 0 }
    role: { type: 'string', default: '' }
    compact: { type: 'boolean', default: false }
  }
  slots: ['default']
  emits: ['dismiss']
</contract>

function read(value) {
  return typeof value === 'function' ? value() : value
}

function openState(openProp, emitFn) {
  if (openProp && typeof openProp.set === 'function') return openProp
  if (!emitFn.__juiOpen) {
    emitFn.__juiOpen = pulse(read(openProp) !== false)
  }
  return emitFn.__juiOpen
}

function isOpen(openProp, emitFn) {
  return read(openState(openProp, emitFn)) !== false
}

function toneOf(value) {
  const next = read(value)
  if (next === 'success' || next === 'warn' || next === 'danger') return next
  return 'info'
}

function roleOf(roleValue, toneValue) {
  const explicit = read(roleValue)
  if (explicit === 'status' || explicit === 'alert') return explicit
  const tone = toneOf(toneValue)
  return tone === 'danger' || tone === 'warn' ? 'alert' : 'status'
}

function closeAlert(openProp, emitFn) {
  openState(openProp, emitFn).set(false)
  emitFn('dismiss')
}

function armAutoDismiss(durationValue, openProp, emitFn) {
  if (!emitFn.__juiAlertStop) {
    emitFn.__juiAlertStop = effect(() => {
      const wait = Number(read(durationValue) || 0)
      if (wait <= 0) return
      if (!isOpen(openProp, emitFn)) return
      const id = setTimeout(() => closeAlert(openProp, emitFn), wait)
      return () => clearTimeout(id)
    })
  }
  return ''
}

export <view>
  #if isOpen(open, emit)
    <div
      class="jui-alert"
      class-jui-alert--success=${() => toneOf(tone) === 'success'}
      class-jui-alert--warn=${() => toneOf(tone) === 'warn'}
      class-jui-alert--danger=${() => toneOf(tone) === 'danger'}
      class-jui-alert--compact=${() => !!read(compact)}
      class-jui-alert--dismissible=${() => !!read(dismissible)}
      role=${() => roleOf(role, tone)}
    >
      <div class="jui-alert__main">
        #if read(title)
          <strong class="jui-alert__title">${title}</strong>
        #end
        <div class="jui-alert__body"><slot /></div>
      </div>

      #if read(dismissible)
        <button
          type="button"
          class="jui-alert__close"
          aria-label="Dismiss"
          on-click=${() => closeAlert(open, emit)}
        >
          <span aria-hidden="true">×</span>
        </button>
      #end

      <span class="jui-alert__arm" aria-hidden="true">${() => armAutoDismiss(duration, open, emit)}</span>
    </div>
  #end
</view>

export <style>
.jui-alert {
  --jui-alert-accent: var(--j-info, #1f6feb);
  --jui-alert-fg: var(--j-text);
  --jui-alert-bg: color-mix(in srgb, var(--jui-alert-accent) 12%, var(--j-surface));
  --jui-alert-border: color-mix(in srgb, var(--jui-alert-accent) 32%, var(--j-border));
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.65rem;
  align-items: start;
  padding: 0.9rem 1rem;
  border: 1px solid var(--jui-alert-border);
  border-radius: var(--j-radius);
  background: var(--jui-alert-bg);
  color: var(--jui-alert-fg);
}

.jui-alert--success {
  --jui-alert-accent: var(--j-success, var(--j-primary));
}

.jui-alert--warn {
  --jui-alert-accent: var(--j-warn, #c47a00);
}

.jui-alert--danger {
  --jui-alert-accent: var(--j-danger);
}

.jui-alert--compact {
  padding: 0.55rem 0.75rem;
  gap: 0.45rem;
}

.jui-alert--compact .jui-alert__title,
.jui-alert--compact .jui-alert__body {
  font-size: 0.84rem;
}

.jui-alert__main {
  display: grid;
  gap: 0.3rem;
  min-width: 0;
}

.jui-alert__title {
  font-size: 0.92rem;
  color: var(--jui-alert-accent);
}

.jui-alert__body {
  font-size: 0.9rem;
  line-height: 1.45;
  color: var(--j-text);
}

.jui-alert__close {
  appearance: none;
  display: inline-grid;
  place-items: center;
  width: 1.75rem;
  height: 1.75rem;
  margin: -0.2rem -0.25rem 0 0;
  border: 0;
  border-radius: var(--j-radius-sm, 0.4rem);
  background: transparent;
  color: inherit;
  font-size: 1.2rem;
  line-height: 1;
  cursor: pointer;
  opacity: 0.72;
}

.jui-alert__close:hover {
  opacity: 1;
  background: color-mix(in srgb, currentColor 10%, transparent);
}

.jui-alert__close:focus-visible {
  outline: none;
  box-shadow: var(--j-focus);
  opacity: 1;
}

.jui-alert__arm {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
</style>
