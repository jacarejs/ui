export <contract>
  props: {
    name: { type: 'string', required: true }
    size: { type: 'string', default: 'md' }
    label: { type: 'string', default: '' }
    tone: { type: 'string', default: '' }
  }
</contract>

const ICON_NAMES = [
  'check',
  'close',
  'chevron-down',
  'chevron-right',
  'search',
  'calendar',
  'alert',
  'info',
  'user',
  'external-link',
  'plus',
  'minus',
  'menu',
]

const glyphs = {
  check: '<path d="M5 12.5 10 17.5 19 6.5"/>',
  close: '<path d="M6 6 18 18"/><path d="M18 6 6 18"/>',
  'chevron-down': '<path d="M6 9 12 15 18 9"/>',
  'chevron-right': '<path d="M9 6 15 12 9 18"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="M20 20 16.2 16.2"/>',
  calendar: '<rect x="4" y="6" width="16" height="14" rx="2"/><path d="M8 3.5v4"/><path d="M16 3.5v4"/><path d="M4 10.5h16"/>',
  alert: '<path d="M12 4 21 20H3L12 4Z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.5" r="1.2" fill="white" stroke="none"/>',
  info: '<circle cx="12" cy="12" r="8"/><path d="M12 11v5.5"/><circle cx="12" cy="7.8" r="1.2" fill="white" stroke="none"/>',
  user: '<circle cx="12" cy="8" r="3.5"/><path d="M5 19.5c1.6-3.4 4-5 7-5s5.4 1.6 7 5"/>',
  'external-link': '<path d="M10 5h9v9"/><path d="M19 5 10 14"/><path d="M14 19H6a1 1 0 0 1-1-1V9"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
}

function read(value) {
  return typeof value === 'function' ? value() : value
}

function iconName(value) {
  const next = String(read(value) || '').trim()
  return ICON_NAMES.includes(next) ? next : 'info'
}

function iconMask(value) {
  const body = glyphs[iconName(value)]
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">${body}</svg>`
  return `url("data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}")`
}

function sizeClass(value) {
  const next = read(value)
  if (next === 'sm' || next === 'lg') return next
  return 'md'
}

function toneClass(value) {
  const next = read(value)
  if (next === 'muted' || next === 'primary' || next === 'danger' || next === 'success' || next === 'warn' || next === 'info') {
    return next
  }
  return ''
}

function accessibleLabel(value) {
  return String(read(value) || '').trim()
}

function iconStyle(value) {
  return `--jui-icon-mask:${iconMask(value)}`
}

export <view>
  <span
    class="jui-icon"
    class-jui-icon--sm=${() => sizeClass(size) === 'sm'}
    class-jui-icon--md=${() => sizeClass(size) === 'md'}
    class-jui-icon--lg=${() => sizeClass(size) === 'lg'}
    class-jui-icon--muted=${() => toneClass(tone) === 'muted'}
    class-jui-icon--primary=${() => toneClass(tone) === 'primary'}
    class-jui-icon--danger=${() => toneClass(tone) === 'danger'}
    class-jui-icon--success=${() => toneClass(tone) === 'success'}
    class-jui-icon--warn=${() => toneClass(tone) === 'warn'}
    class-jui-icon--info=${() => toneClass(tone) === 'info'}
    role=${() => (accessibleLabel(label) ? 'img' : 'presentation')}
    aria-label=${() => accessibleLabel(label) || undefined}
    aria-hidden=${() => (accessibleLabel(label) ? undefined : 'true')}
    :style=${() => iconStyle(name)}
  ></span>
</view>

export <style>
.jui-icon {
  display: inline-block;
  flex: 0 0 auto;
  color: currentColor;
  background-color: currentColor;
  -webkit-mask-image: var(--jui-icon-mask);
  mask-image: var(--jui-icon-mask);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  vertical-align: middle;
  line-height: 0;
}

.jui-icon--sm {
  width: 1rem;
  height: 1rem;
}

.jui-icon--md {
  width: 1.25rem;
  height: 1.25rem;
}

.jui-icon--lg {
  width: 1.75rem;
  height: 1.75rem;
}

.jui-icon--muted {
  color: var(--j-muted);
}

.jui-icon--primary {
  color: var(--j-primary);
}

.jui-icon--danger {
  color: var(--j-danger);
}

.jui-icon--success {
  color: var(--j-success);
}

.jui-icon--warn {
  color: var(--j-warn);
}

.jui-icon--info {
  color: var(--j-info);
}
</style>
