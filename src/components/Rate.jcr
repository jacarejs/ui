import { read } from '../internal/utils.js'

export <contract>
  props: {
    value: { type: 'number', default: 0, model: true }
    max: { type: 'number', default: 5 }
    allowHalf: { type: 'boolean', default: false }
    disabled: { type: 'boolean', default: false }
    clearable: { type: 'boolean', default: true }
    showText: { type: 'boolean', default: false }
    texts: { type: 'object', default: null }
    character: { type: 'string', default: '★' }
  }
  emits: ['change']
</contract>

function maxOf(value) {
  const next = Number(read(value))
  return Number.isFinite(next) && next > 0 ? Math.round(next) : 5
}

function indices(maxProp) {
  return Array.from({ length: maxOf(maxProp) }, (item, index) => index)
}

function starState(index, model) {
  const current = Number(read(model)) || 0
  if (current >= index + 1) return 'full'
  if (current >= index + 0.5) return 'half'
  return 'empty'
}

function fillWidth(index, model) {
  const state = starState(index, model)
  if (state === 'full') return '100%'
  if (state === 'half') return '50%'
  return '0%'
}

function fillStyle(index, model) {
  return `width:${fillWidth(index, model)}`
}

function commit(model, next, emitFn) {
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function pickHalf(index, half, model, disabledProp, emitFn) {
  if (read(disabledProp)) return
  commit(model, half ? index + 0.5 : index + 1, emitFn)
}

function pickFull(index, model, disabledProp, clearableProp, emitFn) {
  if (read(disabledProp)) return
  const current = Number(read(model)) || 0
  if (read(clearableProp) && current === index + 1) {
    commit(model, 0, emitFn)
    return
  }
  commit(model, index + 1, emitFn)
}

function textFor(model, textsProp, maxProp) {
  const current = Math.ceil(Number(read(model)) || 0)
  if (!current) return ''
  const list = read(textsProp)
  if (Array.isArray(list) && list.length) {
    return list[Math.min(current, list.length) - 1] ?? ''
  }
  return `${current} / ${maxOf(maxProp)}`
}

function glyphOf(value) {
  const next = String(read(value) ?? '').trim()
  return next || '★'
}

export <view>
  <div class="jui-rate" class-is-disabled=${() => !!read(disabled)}>
    <div class="jui-rate__stars" role="radiogroup" aria-label="Rating">
      #for indices(max) as index (index)
        <span
          class="jui-rate__star"
          class-jui-rate__star--full=${() => starState(index, value) === 'full'}
          class-jui-rate__star--half=${() => starState(index, value) === 'half'}
        >
          #if read(allowHalf)
            <button
              type="button"
              class="jui-rate__hit jui-rate__hit--left"
              aria-label=${`Rate ${index + 0.5}`}
              disabled=${() => !!read(disabled)}
              on-click=${() => pickHalf(index, true, value, disabled, emit)}
            ></button>
            <button
              type="button"
              class="jui-rate__hit jui-rate__hit--right"
              aria-label=${`Rate ${index + 1}`}
              disabled=${() => !!read(disabled)}
              on-click=${() => pickHalf(index, false, value, disabled, emit)}
            ></button>
          #else
            <button
              type="button"
              class="jui-rate__hit jui-rate__hit--full"
              aria-label=${`Rate ${index + 1}`}
              disabled=${() => !!read(disabled)}
              on-click=${() => pickFull(index, value, disabled, clearable, emit)}
            ></button>
          #end
          <span class="jui-rate__icon" aria-hidden="true">
            <span class="jui-rate__icon-base">${() => glyphOf(character)}</span>
            <span class="jui-rate__icon-fill" :style=${() => fillStyle(index, value)}>${() => glyphOf(character)}</span>
          </span>
        </span>
      #end
    </div>
    #if read(showText)
      <span class="jui-rate__text">${() => textFor(value, texts, max)}</span>
    #end
  </div>
</view>

export <style>
.jui-rate {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
}

.jui-rate.is-disabled {
  opacity: 0.6;
}

.jui-rate__stars {
  display: inline-flex;
  align-items: center;
  gap: 0.2rem;
}

.jui-rate__star {
  position: relative;
  display: inline-flex;
  width: 1.6rem;
  height: 1.6rem;
}

.jui-rate__hit {
  position: absolute;
  z-index: 1;
  top: 0;
  bottom: 0;
  width: 50%;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.jui-rate__hit--left {
  left: 0;
}

.jui-rate__hit--right,
.jui-rate__hit--full {
  right: 0;
}

.jui-rate__hit--full {
  left: 0;
  width: 100%;
}

.jui-rate__hit:disabled {
  cursor: not-allowed;
}

.jui-rate__icon {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  font-size: 1.6rem;
  line-height: 1;
}

.jui-rate__icon-base,
.jui-rate__icon-fill {
  position: absolute;
  inset: 0;
  overflow: hidden;
  white-space: nowrap;
}

.jui-rate__icon-base {
  color: var(--j-border);
}

.jui-rate__icon-fill {
  width: 0%;
  color: var(--j-primary);
  transition: width 120ms ease;
}

.jui-rate__text {
  color: var(--j-muted);
  font-size: 0.85rem;
  font-weight: 600;
}

@media (pointer: coarse) {
  .jui-rate__star {
    width: var(--j-touch-target, 2.75rem);
    height: var(--j-touch-target, 2.75rem);
  }

  .jui-rate__icon {
    font-size: 1.85rem;
  }
}
</style>
