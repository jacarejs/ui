export <contract>
  props: {
    label: { type: 'string', default: '' }
    vertical: { type: 'boolean', default: false }
  }
</contract>

function read(value) {
  return typeof value === 'function' ? value() : value
}

export <view>
  #if read(vertical)
    <div class="jui-divider jui-divider--vertical" role="separator" aria-orientation="vertical"></div>
  #elif read(label)
    <div class="jui-divider jui-divider--labeled" role="separator">
      <span class="jui-divider__line"></span>
      <span class="jui-divider__label">${label}</span>
      <span class="jui-divider__line"></span>
    </div>
  #else
    <hr class="jui-divider" />
  #end
</view>

export <style>
.jui-divider {
  border: 0;
  border-top: 1px solid var(--j-border);
  margin: 0.75rem 0;
  width: 100%;
}

.jui-divider--vertical {
  width: 1px;
  height: 1.5rem;
  margin: 0 0.5rem;
  border: 0;
  background: var(--j-border);
  align-self: stretch;
}

.jui-divider--labeled {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 0.75rem;
  margin: 0.75rem 0;
}

.jui-divider__line {
  height: 1px;
  background: var(--j-border);
}

.jui-divider__label {
  color: var(--j-muted);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
}
</style>
