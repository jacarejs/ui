import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'number', default: null, model: true }
    options: { type: 'object', default: null }
    disabled: { type: 'boolean', default: false }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
  }
  emits: ['change']
</contract>

const DEFAULT_OPTIONS = [
  { value: 1, label: 'Strongly disagree' },
  { value: 2, label: 'Disagree' },
  { value: 3, label: 'Neutral' },
  { value: 4, label: 'Agree' },
  { value: 5, label: 'Strongly agree' },
]

function normalizeOptions(optionsValue) {
  const list = read(optionsValue)
  if (!Array.isArray(list) || !list.length) return DEFAULT_OPTIONS
  return list.map((option, index) => {
    if (option && typeof option === 'object') {
      return {
        value: Number(option.value ?? index + 1),
        label: String(option.label ?? option.value ?? index + 1),
      }
    }
    return { value: index + 1, label: String(option) }
  })
}

function isSelected(optionValue, model) {
  return Number(read(model)) === Number(optionValue)
}

function pick(option, model, disabledValue, emitFn) {
  if (read(disabledValue)) return
  if (model && typeof model.set === 'function') model.set(option.value)
  emitFn('change', option.value)
}

export <view>
  <fieldset
    class="jui-likert"
    class-has-error=${() => !!read(error)}
    class-is-disabled=${() => !!read(disabled)}
    disabled=${() => !!read(disabled)}
  >
    #if read(label)
      <legend class="jui-likert__legend">${() => read(label)}</legend>
    #end

    <div class="jui-likert__list" role="radiogroup">
      #for normalizeOptions(options) as option (option.value)
        <button
          type="button"
          class="jui-likert__option"
          class-is-active=${() => isSelected(option.value, value)}
          role="radio"
          aria-checked=${() => isSelected(option.value, value)}
          disabled=${() => !!read(disabled)}
          on-click=${() => pick(option, value, disabled, emit)}
        >
          <span class="jui-likert__value" aria-hidden="true">${option.value}</span>
          <span class="jui-likert__label">${option.label}</span>
        </button>
      #end
    </div>

    #if read(error)
      <span class="jui-likert__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-likert__hint">${() => read(hint)}</span>
    #end
  </fieldset>
</view>

export <style>
.jui-likert {
  display: grid;
  gap: 0.75rem;
  margin: 0;
  padding: 0;
  border: 0;
  min-inline-size: 0;
}

.jui-likert__legend {
  padding: 0;
  margin: 0 0 0.85rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
  line-height: 1.35;
}

.jui-likert__list {
  display: grid;
  gap: 0.55rem;
}

@media (min-width: 720px) {
  .jui-likert__list {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
}

.jui-likert__option {
  display: grid;
  gap: 0.35rem;
  justify-items: center;
  min-height: var(--j-touch-target, 2.75rem);
  padding: 0.7rem 0.55rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  background: var(--j-surface-2);
  color: var(--j-text);
  font: inherit;
  cursor: pointer;
  text-align: center;
}

.jui-likert__option:hover:not(:disabled) {
  border-color: color-mix(in srgb, var(--j-primary) 45%, var(--j-border));
}

.jui-likert__option.is-active {
  border-color: var(--j-primary);
  background: color-mix(in srgb, var(--j-mint) 55%, var(--j-surface-2));
  box-shadow: var(--j-focus);
}

.jui-likert__value {
  display: grid;
  place-items: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 999px;
  background: var(--j-surface);
  border: 1px solid var(--j-border);
  font-weight: 700;
  font-size: 0.85rem;
}

.jui-likert__option.is-active .jui-likert__value {
  background: var(--j-primary);
  border-color: var(--j-primary);
  color: #fff;
}

.jui-likert__label {
  font-size: 0.82rem;
  line-height: 1.3;
  color: var(--j-muted);
}

.jui-likert__option.is-active .jui-likert__label {
  color: var(--j-text);
  font-weight: 600;
}

.jui-likert.is-disabled {
  opacity: 0.65;
}

.jui-likert__hint,
.jui-likert__error {
  font-size: 0.8rem;
}

.jui-likert__hint {
  color: var(--j-muted);
}

.jui-likert__error {
  color: var(--j-danger);
  font-weight: 600;
}
</style>
