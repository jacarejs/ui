import ChartFrame from './ChartFrame.jcr'
import ChartPlot from './ChartPlot.jcr'
import { read } from '../internal/utils.js'
import {
  cartesianModel,
  chartLayoutWidth,
  colorAt,
  curvePath,
  escapeXml,
  extent,
  formatNumber,
  linePath,
  niceTicks,
  padOf,
  resolveChartWidth,
  scaleLinear,
  sizeOf,
} from '../internal/charts.js'

export <contract>
  props: {
    data: { type: 'any', required: true }
    title: { type: 'string', default: '' }
    caption: { type: 'string', default: '' }
    width: { type: 'number', default: 480 }
    height: { type: 'number', default: 280 }
    colors: { type: 'any', default: null }
    showLegend: { type: 'boolean', default: true }
    showDots: { type: 'boolean', default: true }
    showTooltip: { type: 'boolean', default: true }
    curved: { type: 'boolean', default: false }
  }
  emits: ['layout']
</contract>

function model(dataProp, colorsProp, widthValue, heightProp, curvedProp) {
  const { height } = sizeOf(null, heightProp, 480, 280)
  const width = Math.max(120, Math.round(Number(widthValue) || 480))
  const pad = padOf(null)
  const { categories, series } = cartesianModel(dataProp)
  const values = series.flatMap((serie) => serie.data)
  const yDomain = extent(values)
  const ticks = niceTicks(yDomain.min, yDomain.max, 4)
  const xScale = scaleLinear(0, Math.max(categories.length - 1, 1), pad.left, width - pad.right)
  const yScale = scaleLinear(yDomain.min, yDomain.max, height - pad.bottom, pad.top)
  const pathOf = read(curvedProp) ? curvePath : linePath
  const lines = series.map((serie, index) => {
    const color = serie.color || colorAt(index, colorsProp)
    const points = categories.map((_, pointIndex) => ({
      x: xScale(pointIndex),
      y: yScale(serie.data[pointIndex] ?? 0),
      value: serie.data[pointIndex] ?? 0,
    }))
    return { ...serie, color, points, path: pathOf(points) }
  })
  return {
    width,
    height,
    pad,
    categories,
    lines,
    ticks: ticks.map((tick) => ({ value: tick, y: yScale(tick), label: formatNumber(tick) })),
    xLabels: categories.map((label, index) => ({ label, x: xScale(index) })),
    legend: lines,
  }
}

function plotContent(dataProp, colorsProp, widthValue, heightProp, showDotsProp, showTooltipProp, curvedProp) {
  const next = model(dataProp, colorsProp, widthValue, heightProp, curvedProp)
  const showDots = !!read(showDotsProp)
  const showTooltip = !!read(showTooltipProp)
  const parts = []
  for (const tick of next.ticks) {
    parts.push(
      `<line x1="${next.pad.left}" x2="${next.width - next.pad.right}" y1="${tick.y}" y2="${tick.y}" stroke="color-mix(in srgb, var(--j-border) 70%, transparent)" stroke-width="1" />`,
    )
    parts.push(
      `<text x="${next.pad.left - 8}" y="${tick.y}" text-anchor="end" dominant-baseline="middle" fill="var(--j-muted)" font-size="11">${escapeXml(tick.label)}</text>`,
    )
  }
  for (const item of next.xLabels) {
    parts.push(
      `<text x="${item.x}" y="${next.height - 12}" text-anchor="middle" fill="var(--j-muted)" font-size="11">${escapeXml(item.label)}</text>`,
    )
  }
  for (const line of next.lines) {
    parts.push(
      `<path d="${escapeXml(line.path)}" fill="none" stroke="${escapeXml(line.color)}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />`,
    )
    if (showDots || showTooltip) {
      for (let index = 0; index < line.points.length; index += 1) {
        const point = line.points[index]
        const tipText = showTooltip
          ? `${escapeXml(line.name)} · ${escapeXml(next.categories[index])}: ${escapeXml(formatNumber(point.value))}`
          : ''
        if (showTooltip) {
          parts.push(
            `<circle cx="${point.x}" cy="${point.y}" r="10" fill="transparent" stroke="transparent" data-jui-tip="${tipText}" />`,
          )
        }
        if (showDots) {
          parts.push(
            `<circle cx="${point.x}" cy="${point.y}" r="3.5" fill="${escapeXml(line.color)}" ${showTooltip ? `data-jui-tip="${tipText}"` : ''} />`,
          )
        }
      }
    }
  }
  return parts.join('')
}

export <view>
  <ChartFrame
    :title=${title}
    :caption=${caption}
    :width=${() => resolveChartWidth(width, emit)}
    :height=${height}
    :legend=${() =>
      read(showLegend) ? model(data, colors, resolveChartWidth(width, emit), height, curved).legend : []}
  >
    <ChartPlot
      bind-layoutWidth=${chartLayoutWidth(emit)}
      :width=${() => resolveChartWidth(width, emit)}
      :height=${() => model(data, colors, resolveChartWidth(width, emit), height, curved).height}
      :label=${() => read(title) || 'Line chart'}
      :content=${() =>
        plotContent(
          data,
          colors,
          resolveChartWidth(width, emit),
          height,
          showDots,
          showTooltip,
          curved,
        )}
    />
  </ChartFrame>
</view>
