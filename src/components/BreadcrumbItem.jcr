import { read } from '../internal/utils.js'

export <contract>
  props: {
    href: { type: 'string', default: '' }
  }
  slots: ['default']
</contract>

function safeHref(value) {
  const next = String(read(value) || '')
  if (!next) return ''
  if (/^\s*javascript:/i.test(next)) return '#'
  return next
}

function hasHref(value) {
  return !!safeHref(value)
}

export <view>
  <li class="jui-breadcrumb-item">
    #if hasHref(href)
      <a class="jui-breadcrumb-item__link" href=${() => safeHref(href)}><slot /></a>
    #else
      <span class="jui-breadcrumb-item__text"><slot /></span>
    #end
  </li>
</view>

export <style>
.jui-breadcrumb-item {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  min-width: 0;
  color: var(--j-muted);
}

.jui-breadcrumb-item__link {
  color: inherit;
  text-decoration: none;
  transition: color var(--j-duration-fast) var(--j-ease-out);
}

.jui-breadcrumb-item__link:hover {
  color: var(--j-primary);
  text-decoration: underline;
}

.jui-breadcrumb-item__link:focus-visible {
  outline: none;
  box-shadow: var(--j-focus);
  border-radius: 2px;
}

.jui-breadcrumb-item__text {
  color: inherit;
}
</style>
