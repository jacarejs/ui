import { read } from '../internal/utils.js'

export <contract>
  props: {
    direction: { type: 'string', default: 'vertical' }
  }
  slots: ['default']
</contract>

function directionOf(value) {
  return read(value) === 'horizontal' ? 'horizontal' : 'vertical'
}

export <view>
  <div
    class="jui-container"
    class-jui-container--horizontal=${() => directionOf(direction) === 'horizontal'}
    class-jui-container--vertical=${() => directionOf(direction) === 'vertical'}
  >
    <slot />
  </div>
</view>

export <style>
.jui-container {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
}

.jui-container > span {
  display: contents;
}

.jui-container--horizontal {
  flex-direction: row;
}

.jui-container--vertical {
  flex-direction: column;
}

@media (max-width: 640px) {
  .jui-container--horizontal {
    flex-direction: column;
  }
}
</style>
