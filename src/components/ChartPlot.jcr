import { effect } from '@jacare/core'
import { paintChartSvg } from '../internal/charts.js'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    width: { type: 'number', default: 480 }
    height: { type: 'number', default: 280 }
    label: { type: 'string', default: 'Chart' }
    content: { type: 'any', default: '' }
    layoutWidth: { type: 'number', default: 0, model: true }
  }
</contract>

const BOOT_SRC = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'

function layoutWidthState(layoutWidthProp) {
  if (layoutWidthProp && typeof layoutWidthProp.set === 'function') return layoutWidthProp
  return null
}

function publishWidth(host, layoutWidthProp) {
  if (!host) return
  const next = Math.max(0, Math.round(host.clientWidth || 0))
  if (next < 120) return
  const state = layoutWidthState(layoutWidthProp)
  if (!state) return
  if (Number(read(state) || 0) === next) return
  state.set(next)
}

function arm(host, widthProp, heightProp, labelProp, contentProp, layoutWidthProp) {
  if (!host || host.__juiChartArmed) return
  host.__juiChartArmed = true

  host.__juiChartDispose = effect(() => {
    paintChartSvg(host, {
      width: read(widthProp),
      height: read(heightProp),
      label: read(labelProp),
      html: read(contentProp),
    })
    return () => {}
  })

  publishWidth(host, layoutWidthProp)
  requestAnimationFrame(() => publishWidth(host, layoutWidthProp))

  if (typeof ResizeObserver === 'function' && !host.__juiChartRo) {
    host.__juiChartRo = new ResizeObserver(() => publishWidth(host, layoutWidthProp))
    host.__juiChartRo.observe(host)
  }
}

export <view>
  <div class="jui-chart-plot">
    <img
      class="jui-chart-plot__boot"
      alt=""
      width="0"
      height="0"
      aria-hidden="true"
      src=${BOOT_SRC}
      on-load=${(event) =>
        arm(event.currentTarget.parentElement, width, height, label, content, layoutWidth)}
    />
  </div>
</view>

export <style>
.jui-chart-plot {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  overflow: visible;
}

.jui-chart-plot__boot {
  position: absolute;
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
}

.jui-chart-tip {
  position: absolute;
  z-index: 5;
  max-width: min(16rem, 70%);
  padding: 0.35rem 0.55rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  background: var(--j-surface-2);
  color: var(--j-text);
  box-shadow: var(--j-shadow);
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.3;
  pointer-events: none;
  white-space: nowrap;
}

.jui-chart-tip[hidden] {
  display: none;
}
</style>
