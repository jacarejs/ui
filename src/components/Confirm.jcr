import { effect, pulse } from '@jacare/core'
import { propText, localeText } from '../i18n/index.js'
import { read } from '../internal/utils.js'
import { activateFocusTrap, uniqueId } from '../internal/overlay.js'

export <contract>
  props: {
    open: { type: 'boolean', default: false, model: true }
    title: { type: 'string', default: 'Confirm' }
    message: { type: 'string', default: '' }
    confirmLabel: { type: 'string', default: 'Confirm' }
    cancelLabel: { type: 'string', default: 'Cancel' }
    danger: { type: 'boolean', default: false }
    busy: { type: 'boolean', default: false }
  }
  emits: ['confirm', 'cancel']
</contract>

function openState(openProp, emitFn) {
  if (openProp && typeof openProp.set === 'function') return openProp
  if (!emitFn.__juiConfirmOpen) {
    emitFn.__juiConfirmOpen = pulse(read(openProp) === true)
  }
  return emitFn.__juiConfirmOpen
}

function isOpen(openProp, emitFn) {
  return read(openState(openProp, emitFn)) === true
}

function confirmId(emitFn) {
  return uniqueId('jui-confirm', emitFn)
}

function titleId(emitFn) {
  return `${confirmId(emitFn)}-title`
}

function closeConfirm(openProp, emitFn) {
  openState(openProp, emitFn).set(false)
}

function confirmLabelText(busyValue, labelValue) {
  return read(busyValue)
    ? localeText('j.confirm.pleaseWait', 'Please wait…')
    : propText(labelValue, 'j.confirm.confirm', 'Confirm')
}

function handleBackdrop(event, openProp, emitFn, busyValue) {
  event.preventDefault()
  if (event.target !== event.currentTarget || read(busyValue)) return
  closeConfirm(openProp, emitFn)
  emitFn('cancel')
}

function handleCancel(event, openProp, emitFn, busyValue) {
  event.preventDefault()
  event.stopPropagation()
  if (read(busyValue)) return
  closeConfirm(openProp, emitFn)
  emitFn('cancel')
}

function handleConfirm(event, emitFn, busyValue) {
  event.preventDefault()
  event.stopPropagation()
  if (read(busyValue)) return
  emitFn('confirm')
}

function armOverlay(openProp, emitFn, busyValue) {
  if (!emitFn.__juiConfirmOverlay) {
    emitFn.__juiConfirmOverlay = effect(() => {
      if (!isOpen(openProp, emitFn)) return undefined
      const id = confirmId(emitFn)
      let release = () => {}
      const frame = requestAnimationFrame(() => {
        const root = document.querySelector(`[data-jui-confirm="${id}"]`)
        if (!root) return
        release = activateFocusTrap(root, {
          onEscape: () => {
            if (read(busyValue)) return
            closeConfirm(openProp, emitFn)
            emitFn('cancel')
          },
        })
      })
      return () => {
        cancelAnimationFrame(frame)
        release()
      }
    })
  }
  return ''
}

export <view>
  #if isOpen(open, emit)
    <div class="jui-confirm-backdrop" on-click=${(event) => handleBackdrop(event, open, emit, busy)}>
      <section
        class="jui-confirm"
        role="dialog"
        aria-modal="true"
        data-jui-confirm=${() => confirmId(emit)}
        aria-labelledby=${() => titleId(emit)}
        on-click=${(event) => event.stopPropagation()}
      >
        <header class="jui-confirm__head">
          <h2 class="jui-confirm__title" id=${() => titleId(emit)}>${() => propText(title, 'j.confirm.title', 'Confirm')}</h2>
          <button
            type="button"
            class="jui-confirm__close"
            aria-label="Close"
            disabled=${() => !!read(busy)}
            on-click=${(event) => handleCancel(event, open, emit, busy)}
          >
            <span aria-hidden="true">×</span>
          </button>
        </header>

        #if read(message)
          <div class="jui-confirm__body">
            <p>${() => read(message)}</p>
          </div>
        #end

        <footer class="jui-confirm__actions">
          <button
            type="button"
            class="jui-confirm__btn jui-confirm__btn--cancel"
            disabled=${() => !!read(busy)}
            on-click=${(event) => handleCancel(event, open, emit, busy)}
          >${() => propText(cancelLabel, 'j.confirm.cancel', 'Cancel')}</button>
          <button
            type="button"
            class="jui-confirm__btn jui-confirm__btn--confirm"
            class-is-danger=${() => !!read(danger)}
            aria-busy=${() => !!read(busy)}
            disabled=${() => !!read(busy)}
            on-click=${(event) => handleConfirm(event, emit, busy)}
          >
            #if read(busy)
              <span class="jui-confirm__spinner" aria-hidden="true"></span>
            #end
            <span>${() => confirmLabelText(busy, confirmLabel)}</span>
          </button>
        </footer>

        <span class="jui-confirm__arm" aria-hidden="true">${() => armOverlay(open, emit, busy)}</span>
      </section>
    </div>
  #end
</view>

export <style>
.jui-confirm-backdrop {
  position: fixed;
  z-index: 130;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 1rem;
  background: rgba(0, 24, 24, 0.55);
}

.jui-confirm {
  width: min(26rem, 100%);
  overflow: hidden;
  border-radius: var(--j-radius);
  background: var(--j-surface-2);
  box-shadow: var(--j-shadow);
}

.jui-confirm__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.1rem 1.2rem;
  border-bottom: 1px solid var(--j-border);
}

.jui-confirm__title {
  margin: 0;
  color: var(--j-forest);
  font-size: 1.15rem;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.jui-confirm__close {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 0;
  border-radius: 50%;
  color: var(--j-primary);
  background: var(--j-mint);
  cursor: pointer;
  font-size: 1.4rem;
  line-height: 1;
}

.jui-confirm__close:hover:not(:disabled) {
  background: var(--j-lime);
}

.jui-confirm__close:focus-visible {
  outline: none;
  box-shadow: var(--j-focus);
}

.jui-confirm__close:disabled {
  cursor: wait;
  opacity: 0.65;
}

.jui-confirm__body {
  padding: 1.1rem 1.2rem 0.9rem;
}

.jui-confirm__body p {
  margin: 0;
  color: var(--j-text);
  font-size: 0.92rem;
  line-height: 1.5;
}

.jui-confirm__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0.55rem;
  padding: 1rem 1.2rem 1.2rem;
}

.jui-confirm__btn {
  min-height: 2.6rem;
  padding: 0.6rem 1rem;
  border: 1px solid transparent;
  border-radius: var(--j-radius-pill);
  cursor: pointer;
  font-weight: 700;
  transition: transform 120ms ease, background 120ms ease, opacity 120ms ease;
}

.jui-confirm__btn:focus-visible {
  outline: none;
  box-shadow: var(--j-focus);
}

.jui-confirm__btn--cancel {
  color: var(--j-forest);
  background: var(--j-surface);
  border-color: var(--j-border);
}

.jui-confirm__btn--cancel:hover:not(:disabled) {
  background: var(--j-mint);
}

.jui-confirm__btn--confirm {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: #ffffff;
  background: var(--j-primary);
}

.jui-confirm__btn--confirm:hover:not(:disabled) {
  background: var(--j-leaf);
}

.jui-confirm__btn--confirm.is-danger {
  background: var(--j-danger);
}

.jui-confirm__btn--confirm.is-danger:hover:not(:disabled) {
  background: color-mix(in srgb, var(--j-danger) 82%, #000000);
}

.jui-confirm__btn:disabled {
  cursor: wait;
  opacity: 0.65;
}

.jui-confirm__spinner {
  width: 1rem;
  height: 1rem;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: jui-confirm-spin 0.7s linear infinite;
}

.jui-confirm__arm {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}

@keyframes jui-confirm-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 640px) {
  .jui-confirm-backdrop {
    align-items: flex-end;
    padding: 0;
  }

  .jui-confirm {
    width: 100%;
    border-radius: var(--j-radius) var(--j-radius) 0 0;
  }

  .jui-confirm__actions {
    display: grid;
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .jui-confirm__btn,
  .jui-confirm__spinner {
    transition: none;
    animation: none;
  }
}
</style>
