export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'any', default: null, model: true }
    options: { type: 'any', required: true }
    placeholder: { type: 'string', default: 'Select' }
    clearable: { type: 'boolean', default: true }
    disabled: { type: 'boolean', default: false }
    separator: { type: 'string', default: '/' }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
  }
  emits: ['change']
</contract>

function read(value) {
  return typeof value === 'function' ? value() : value
}

function normalizedTree(source) {
  const list = read(source)
  return Array.isArray(list) ? list : []
}

function toPath(value, sep) {
  const current = read(value)
  if (Array.isArray(current)) return current.filter((item) => item !== undefined && item !== null && item !== '')
  if (typeof current === 'string' && current) return current.split(read(sep) || '/').filter(Boolean)
  return []
}

function findNode(nodes, value) {
  return nodes.find((node) => String(node.value) === String(value))
}

function pathLabels(tree, path) {
  const labels = []
  let level = tree
  for (const step of path) {
    const node = findNode(level, step)
    if (!node) break
    labels.push(node.label)
    level = node.children || []
  }
  return labels
}

function displayValue(value, source, sep, placeholderValue) {
  const path = toPath(value, sep)
  const labels = pathLabels(normalizedTree(source), path)
  return labels.length ? labels.join(` ${read(sep) || '/'} `) : read(placeholderValue)
}

function commitPath(model, path, emitFn) {
  const next = [...path]
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function buildColumn(nodes, activeValue, level, root) {
  const list = document.createElement('ul')
  list.className = 'jui-cascader__column'
  list.setAttribute('role', 'listbox')

  nodes.forEach((node) => {
    const item = document.createElement('li')
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'jui-cascader__option'
    button.setAttribute('role', 'option')
    const hasChildren = Array.isArray(node.children) && node.children.length > 0
    button.classList.toggle('is-active', String(node.value) === String(activeValue))
    button.classList.toggle('has-children', hasChildren)

    const text = document.createElement('span')
    text.textContent = node.label
    button.appendChild(text)

    if (hasChildren) {
      const caret = document.createElement('span')
      caret.className = 'jui-cascader__caret'
      caret.setAttribute('aria-hidden', 'true')
      caret.textContent = '›'
      button.appendChild(caret)
    }

    button.addEventListener('click', () => selectNode(root, level, node))
    item.appendChild(button)
    list.appendChild(item)
  })

  return list
}

function renderColumns(root) {
  const state = root.cascaderState
  const container = root.querySelector('[data-cascader-columns]')
  container.replaceChildren()

  let level = state.tree
  for (let index = 0; index <= state.path.length; index += 1) {
    if (!level.length) break
    container.appendChild(buildColumn(level, state.path[index], index, root))
    const activeNode = findNode(level, state.path[index])
    if (!activeNode) break
    level = activeNode.children || []
  }
}

function selectNode(root, level, node) {
  const state = root.cascaderState
  const nextPath = [...state.path.slice(0, level), node.value]
  const hasChildren = Array.isArray(node.children) && node.children.length > 0

  if (hasChildren) {
    state.path = nextPath
    renderColumns(root)
    return
  }

  state.commit(nextPath)
  closePicker(root)
}

function closePicker(root) {
  if (!root) return
  const panel = root.querySelector('[data-cascader-panel]')
  if (panel) panel.hidden = true
  root.querySelector('[data-cascader-trigger]')?.setAttribute('aria-expanded', 'false')
  root.cascaderController?.abort()
}

function openPicker(event, model, source, sep, emitFn) {
  const root = event.currentTarget.closest('[data-cascader]')
  if (!root || event.currentTarget.disabled) return

  document.querySelectorAll('[data-cascader-panel]:not([hidden])').forEach((panel) => {
    const otherRoot = panel.closest('[data-cascader]')
    if (otherRoot !== root) closePicker(otherRoot)
  })

  root.cascaderState = {
    tree: normalizedTree(source),
    path: toPath(model, sep),
    commit: (path) => commitPath(model, path, emitFn),
  }

  renderColumns(root)
  root.querySelector('[data-cascader-panel]').hidden = false
  event.currentTarget.setAttribute('aria-expanded', 'true')

  root.cascaderController?.abort()
  const controller = new AbortController()
  root.cascaderController = controller
  requestAnimationFrame(() => {
    document.addEventListener('pointerdown', (pointerEvent) => {
      if (!root.contains(pointerEvent.target)) closePicker(root)
    }, { signal: controller.signal })
    document.addEventListener('keydown', (keyEvent) => {
      if (keyEvent.key === 'Escape') {
        closePicker(root)
        event.currentTarget.focus()
      }
    }, { signal: controller.signal })
  })
}

export <view>
  <div class="jui-cascader" class-has-error=${() => !!read(error)} class-is-disabled=${() => !!read(disabled)} data-cascader>
    #if read(label)
      <span class="jui-cascader__label">${() => read(label)}</span>
    #end

    <span class="jui-cascader__field">
      <button
        type="button"
        class="jui-cascader__trigger"
        data-cascader-trigger
        aria-haspopup="dialog"
        aria-expanded="false"
        disabled=${() => !!read(disabled)}
        on-click=${(event) => openPicker(event, value, options, separator, emit)}
      >
        <span class="jui-cascader__value" class-is-placeholder=${() => toPath(value, separator).length === 0}>${() => displayValue(value, options, separator, placeholder)}</span>
        <span class="jui-cascader__chevron" aria-hidden="true">⌄</span>
      </button>

      <div class="jui-cascader__panel" data-cascader-panel role="dialog" aria-label="Choose option" hidden>
        <div class="jui-cascader__columns" data-cascader-columns></div>
        #if read(clearable)
          <div class="jui-cascader__footer">
            <button
              type="button"
              class="jui-cascader__text-btn"
              on-click=${(event) => {
                commitPath(value, [], emit)
                closePicker(event.currentTarget.closest('[data-cascader]'))
              }}
            >Clear</button>
          </div>
        #end
      </div>
    </span>

    #if read(error)
      <span class="jui-cascader__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-cascader__hint">${() => read(hint)}</span>
    #end
  </div>
</view>

export <style>
.jui-cascader {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-cascader__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-cascader.has-error .jui-cascader__label {
  color: var(--j-danger);
}

.jui-cascader.has-error .jui-cascader__trigger {
  border-color: var(--j-danger);
}

.jui-cascader.is-disabled {
  opacity: 0.65;
}

.jui-cascader__field {
  position: relative;
  display: block;
  min-width: 0;
}

.jui-cascader__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.7rem;
  width: 100%;
  min-height: 2.75rem;
  padding: 0.65rem 0.9rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  outline: 0;
  color: var(--j-text);
  background: var(--j-surface-2);
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

.jui-cascader__trigger:focus,
.jui-cascader__trigger[aria-expanded='true'] {
  border-color: var(--j-primary);
  box-shadow: var(--j-focus);
}

.jui-cascader__trigger:disabled {
  cursor: not-allowed;
}

.jui-cascader__value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.jui-cascader__value.is-placeholder {
  color: var(--j-muted);
}

.jui-cascader__chevron {
  flex: 0 0 auto;
  color: var(--j-muted);
  font-size: 1.1rem;
  transition: transform 120ms ease;
}

.jui-cascader__trigger[aria-expanded='true'] .jui-cascader__chevron {
  transform: rotate(180deg);
}

.jui-cascader__panel {
  position: absolute;
  z-index: 80;
  top: calc(100% + 0.4rem);
  left: 0;
  display: grid;
  gap: 0.5rem;
  padding: 0.55rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius);
  background: var(--j-surface-2);
  box-shadow: var(--j-shadow);
}

.jui-cascader__panel[hidden] {
  display: none;
}

.jui-cascader__columns {
  display: flex;
  gap: 0.4rem;
}

.jui-cascader__column {
  display: grid;
  align-content: start;
  gap: 0.15rem;
  width: 11rem;
  max-height: 16rem;
  margin: 0;
  padding: 0;
  overflow-y: auto;
  list-style: none;
}

.jui-cascader__column + .jui-cascader__column {
  border-left: 1px solid var(--j-border);
  padding-left: 0.4rem;
}

.jui-cascader__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  width: 100%;
  min-height: 2.5rem;
  padding: 0.5rem 0.6rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-text);
  background: transparent;
  cursor: pointer;
  text-align: left;
  font-size: 0.88rem;
}

.jui-cascader__option:hover,
.jui-cascader__option.is-active {
  background: var(--j-mint);
}

.jui-cascader__option.is-active {
  color: var(--j-forest);
  font-weight: 700;
}

.jui-cascader__caret {
  flex: 0 0 auto;
  color: var(--j-muted);
}

.jui-cascader__footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 0.45rem;
  border-top: 1px solid var(--j-border);
}

.jui-cascader__text-btn {
  min-height: 2rem;
  padding: 0.4rem 0.65rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-primary);
  background: transparent;
  cursor: pointer;
  font-size: 0.75rem;
  font-weight: 850;
}

.jui-cascader__text-btn:hover {
  background: var(--j-mint);
}

.jui-cascader__hint,
.jui-cascader__error {
  font-size: 0.8rem;
}

.jui-cascader__hint {
  color: var(--j-muted);
}

.jui-cascader__error {
  color: var(--j-danger);
  font-weight: 600;
}
</style>
