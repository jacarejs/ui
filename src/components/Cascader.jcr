import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'any', default: null, model: true }
    options: { type: 'any', required: true }
    placeholder: { type: 'string', default: 'Select' }
    clearable: { type: 'boolean', default: true }
    disabled: { type: 'boolean', default: false }
    separator: { type: 'string', default: '/' }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
  }
  emits: ['change']
</contract>

function normalizedTree(source) {
  const list = read(source)
  return Array.isArray(list) ? list : []
}

function toPath(value, sep) {
  const current = read(value)
  if (Array.isArray(current)) return current.filter((item) => item !== undefined && item !== null && item !== '')
  if (typeof current === 'string' && current) return current.split(read(sep) || '/').filter(Boolean)
  return []
}

function findNode(nodes, value) {
  return nodes.find((node) => String(node.value) === String(value))
}

function pathLabels(tree, path) {
  const labels = []
  let level = tree
  for (const step of path) {
    const node = findNode(level, step)
    if (!node) break
    labels.push(node.label)
    level = node.children || []
  }
  return labels
}

function displayValue(value, source, sep, placeholderValue) {
  const path = toPath(value, sep)
  const labels = pathLabels(normalizedTree(source), path)
  return labels.length ? labels.join(` ${read(sep) || '/'} `) : read(placeholderValue)
}

function commitPath(model, path, emitFn) {
  const next = [...path]
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function isMobileLayout() {
  if (typeof window === 'undefined' || typeof matchMedia !== 'function') return false
  return matchMedia('(max-width: 640px)').matches
}

function nodesAtDepth(tree, path, depth) {
  let level = tree
  for (let index = 0; index < depth; index += 1) {
    const node = findNode(level, path[index])
    if (!node) return []
    level = node.children || []
  }
  return level
}

function buildColumn(nodes, activeValue, level, root) {
  const list = document.createElement('ul')
  list.className = 'jui-cascader__column'
  list.setAttribute('role', 'listbox')

  nodes.forEach((node) => {
    const item = document.createElement('li')
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'jui-cascader__option'
    button.setAttribute('role', 'option')
    const hasChildren = Array.isArray(node.children) && node.children.length > 0
    button.classList.toggle('is-active', String(node.value) === String(activeValue))
    button.classList.toggle('has-children', hasChildren)

    const text = document.createElement('span')
    text.textContent = node.label
    button.appendChild(text)

    if (hasChildren) {
      const caret = document.createElement('span')
      caret.className = 'jui-cascader__caret'
      caret.setAttribute('aria-hidden', 'true')
      caret.textContent = '›'
      button.appendChild(caret)
    }

    button.addEventListener('click', () => selectNode(root, level, node))
    item.appendChild(button)
    list.appendChild(item)
  })

  return list
}

function buildMobileNav(root) {
  const state = root.cascaderState
  const nav = document.createElement('div')
  nav.className = 'jui-cascader__nav'

  const back = document.createElement('button')
  back.type = 'button'
  back.className = 'jui-cascader__nav-back'
  back.textContent = 'Back'
  back.disabled = state.path.length === 0
  back.addEventListener('click', () => {
    if (!state.path.length) return
    state.path = state.path.slice(0, -1)
    renderColumns(root)
  })

  const title = document.createElement('span')
  title.className = 'jui-cascader__nav-title'
  const labels = pathLabels(state.tree, state.path)
  title.textContent = labels.length ? labels[labels.length - 1] : 'Select'

  nav.appendChild(back)
  nav.appendChild(title)
  return nav
}

function renderColumns(root) {
  const state = root.cascaderState
  const container = root.querySelector('[data-cascader-columns]')
  const mobile = !!state.mobile
  root.classList.toggle('is-mobile', mobile)
  container.replaceChildren()

  if (mobile) {
    container.appendChild(buildMobileNav(root))
    const depth = state.path.length
    const nodes = nodesAtDepth(state.tree, state.path, depth)
    if (nodes.length) {
      container.appendChild(buildColumn(nodes, state.path[depth], depth, root))
    }
    return
  }

  let level = state.tree
  for (let index = 0; index <= state.path.length; index += 1) {
    if (!level.length) break
    container.appendChild(buildColumn(level, state.path[index], index, root))
    const activeNode = findNode(level, state.path[index])
    if (!activeNode) break
    level = activeNode.children || []
  }
}

function selectNode(root, level, node) {
  const state = root.cascaderState
  const nextPath = [...state.path.slice(0, level), node.value]
  const hasChildren = Array.isArray(node.children) && node.children.length > 0

  if (hasChildren) {
    state.path = nextPath
    renderColumns(root)
    return
  }

  state.commit(nextPath)
  closePicker(root)
}

function closePicker(root) {
  if (!root) return
  const panel = root.querySelector('[data-cascader-panel]')
  if (panel) panel.hidden = true
  root.querySelector('[data-cascader-trigger]')?.setAttribute('aria-expanded', 'false')
  root.classList.remove('is-open', 'is-mobile')
  root.cascaderController?.abort()
}

function openPicker(event, model, source, sep, emitFn) {
  const root = event.currentTarget.closest('[data-cascader]')
  if (!root || event.currentTarget.disabled) return

  document.querySelectorAll('[data-cascader-panel]:not([hidden])').forEach((panel) => {
    const otherRoot = panel.closest('[data-cascader]')
    if (otherRoot !== root) closePicker(otherRoot)
  })

  root.cascaderState = {
    tree: normalizedTree(source),
    path: toPath(model, sep),
    mobile: isMobileLayout(),
    commit: (path) => commitPath(model, path, emitFn),
  }

  renderColumns(root)
  root.querySelector('[data-cascader-panel]').hidden = false
  root.classList.add('is-open')
  event.currentTarget.setAttribute('aria-expanded', 'true')

  root.cascaderController?.abort()
  const controller = new AbortController()
  root.cascaderController = controller
  requestAnimationFrame(() => {
    document.addEventListener('pointerdown', (pointerEvent) => {
      if (!root.contains(pointerEvent.target)) closePicker(root)
    }, { signal: controller.signal })
    document.addEventListener('keydown', (keyEvent) => {
      if (keyEvent.key === 'Escape') {
        closePicker(root)
        event.currentTarget.focus()
      }
    }, { signal: controller.signal })
  })
}

export <view>
  <div class="jui-cascader" class-has-error=${() => !!read(error)} class-is-disabled=${() => !!read(disabled)} data-cascader>
    #if read(label)
      <span class="jui-cascader__label">${() => read(label)}</span>
    #end

    <span class="jui-cascader__field">
      <button
        type="button"
        class="jui-cascader__trigger"
        data-cascader-trigger
        aria-haspopup="dialog"
        aria-expanded="false"
        disabled=${() => !!read(disabled)}
        on-click=${(event) => openPicker(event, value, options, separator, emit)}
      >
        <span class="jui-cascader__value" class-is-placeholder=${() => toPath(value, separator).length === 0}>${() => displayValue(value, options, separator, placeholder)}</span>
        <span class="jui-cascader__chevron" aria-hidden="true">⌄</span>
      </button>

      <div class="jui-cascader__backdrop" data-cascader-backdrop aria-hidden="true" on-click=${(event) => closePicker(event.currentTarget.closest('[data-cascader]'))}></div>

      <div class="jui-cascader__panel" data-cascader-panel role="dialog" aria-label="Choose option" hidden>
        <div class="jui-cascader__sheet-handle" aria-hidden="true"></div>
        <div class="jui-cascader__columns" data-cascader-columns></div>
        #if read(clearable)
          <div class="jui-cascader__footer">
            <button
              type="button"
              class="jui-cascader__text-btn"
              on-click=${(event) => {
                commitPath(value, [], emit)
                closePicker(event.currentTarget.closest('[data-cascader]'))
              }}
            >Clear</button>
          </div>
        #end
      </div>
    </span>

    #if read(error)
      <span class="jui-cascader__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-cascader__hint">${() => read(hint)}</span>
    #end
  </div>
</view>

export <style>
.jui-cascader {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-cascader__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-cascader.has-error .jui-cascader__label {
  color: var(--j-danger);
}

.jui-cascader.has-error .jui-cascader__trigger {
  border-color: var(--j-danger);
}

.jui-cascader.is-disabled {
  opacity: 0.65;
}

.jui-cascader__field {
  position: relative;
  display: block;
  min-width: 0;
}

.jui-cascader__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.7rem;
  width: 100%;
  min-height: 2.75rem;
  padding: 0.65rem 0.9rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  outline: 0;
  color: var(--j-text);
  background: var(--j-surface-2);
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color 120ms ease, box-shadow 120ms ease;
  touch-action: manipulation;
}

.jui-cascader__trigger:focus,
.jui-cascader__trigger[aria-expanded='true'] {
  border-color: var(--j-primary);
  box-shadow: var(--j-focus);
}

.jui-cascader__trigger:disabled {
  cursor: not-allowed;
}

.jui-cascader__value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.jui-cascader__value.is-placeholder {
  color: var(--j-muted);
}

.jui-cascader__chevron {
  flex: 0 0 auto;
  color: var(--j-muted);
  font-size: 1.1rem;
  transition: transform 120ms ease;
}

.jui-cascader__trigger[aria-expanded='true'] .jui-cascader__chevron {
  transform: rotate(180deg);
}

.jui-cascader__backdrop {
  display: none;
}

.jui-cascader__sheet-handle {
  display: none;
}

.jui-cascader__panel {
  position: absolute;
  z-index: 80;
  top: calc(100% + 0.4rem);
  left: 0;
  display: grid;
  gap: 0.5rem;
  max-width: min(100vw - 1.5rem, 36rem);
  padding: 0.55rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius);
  background: var(--j-surface-2);
  box-shadow: var(--j-shadow);
}

.jui-cascader__panel[hidden] {
  display: none;
}

.jui-cascader__columns {
  display: flex;
  gap: 0.4rem;
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
}

.jui-cascader__column {
  display: grid;
  align-content: start;
  gap: 0.15rem;
  flex: 0 0 11rem;
  width: 11rem;
  max-height: 16rem;
  margin: 0;
  padding: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  list-style: none;
}

.jui-cascader__column + .jui-cascader__column {
  border-left: 1px solid var(--j-border);
  padding-left: 0.4rem;
}

.jui-cascader__nav {
  display: none;
}

.jui-cascader__option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  width: 100%;
  min-height: 2.5rem;
  padding: 0.5rem 0.6rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-text);
  background: transparent;
  cursor: pointer;
  text-align: left;
  font-size: 0.88rem;
  touch-action: manipulation;
}

.jui-cascader__option:hover,
.jui-cascader__option.is-active {
  background: var(--j-mint);
}

.jui-cascader__option.is-active {
  color: var(--j-forest);
  font-weight: 700;
}

.jui-cascader__caret {
  flex: 0 0 auto;
  color: var(--j-muted);
}

.jui-cascader__footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 0.45rem;
  border-top: 1px solid var(--j-border);
}

.jui-cascader__text-btn {
  min-height: 2.25rem;
  padding: 0.45rem 0.75rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-primary);
  background: transparent;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 850;
  touch-action: manipulation;
}

.jui-cascader__text-btn:hover {
  background: var(--j-mint);
}

.jui-cascader__hint,
.jui-cascader__error {
  font-size: 0.8rem;
}

.jui-cascader__hint {
  color: var(--j-muted);
}

.jui-cascader__error {
  color: var(--j-danger);
  font-weight: 600;
}

@media (max-width: 640px) {
  .jui-cascader {
    touch-action: manipulation;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .jui-cascader__trigger {
    min-height: 3rem;
    font-size: 16px;
  }

  .jui-cascader.is-open.is-mobile .jui-cascader__backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--j-forest) 42%, transparent);
    touch-action: manipulation;
  }

  .jui-cascader.is-open.is-mobile .jui-cascader__panel {
    position: fixed;
    z-index: 95;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: none;
    max-height: min(78vh, 34rem);
    padding: 0.45rem 0.85rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    border-radius: calc(var(--j-radius) + 6px) calc(var(--j-radius) + 6px) 0 0;
    border-left: 0;
    border-right: 0;
    border-bottom: 0;
    box-shadow: 0 -16px 40px color-mix(in srgb, var(--j-forest) 22%, transparent);
    touch-action: manipulation;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  .jui-cascader.is-mobile .jui-cascader__sheet-handle {
    display: block;
    width: 2.5rem;
    height: 0.28rem;
    margin: 0.15rem auto 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--j-muted) 45%, transparent);
  }

  .jui-cascader.is-mobile .jui-cascader__columns {
    display: grid;
    gap: 0.45rem;
    overflow: visible;
    touch-action: manipulation;
  }

  .jui-cascader.is-mobile .jui-cascader__nav {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
  }

  .jui-cascader.is-mobile .jui-cascader__nav-back {
    min-height: 2.5rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--j-border);
    border-radius: var(--j-radius-pill);
    color: var(--j-text);
    background: var(--j-surface);
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    touch-action: manipulation;
  }

  .jui-cascader.is-mobile .jui-cascader__nav-back:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .jui-cascader.is-mobile .jui-cascader__nav-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 16px;
    font-weight: 800;
    color: var(--j-forest);
  }

  .jui-cascader.is-mobile .jui-cascader__column,
  .jui-cascader.is-mobile .jui-cascader__column + .jui-cascader__column {
    flex: none;
    width: 100%;
    max-height: min(52vh, 22rem);
    border-left: 0;
    padding-left: 0;
  }

  .jui-cascader.is-mobile .jui-cascader__option {
    min-height: 2.85rem;
    padding: 0.7rem 0.75rem;
    font-size: 16px;
  }

  .jui-cascader.is-mobile .jui-cascader__footer {
    justify-content: stretch;
  }

  .jui-cascader.is-mobile .jui-cascader__text-btn {
    width: 100%;
    min-height: 2.75rem;
    font-size: 16px;
  }
}

@media (pointer: coarse) {
  .jui-cascader__option {
    min-height: 2.75rem;
    font-size: 16px;
  }

  .jui-cascader__trigger {
    font-size: 16px;
  }
}
</style>
