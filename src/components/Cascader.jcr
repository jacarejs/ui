import { localeText, propText } from '../i18n/index.js'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'any', default: null, model: true }
    options: { type: 'any', required: true }
    placeholder: { type: 'string', default: 'Select' }
    clearable: { type: 'boolean', default: true }
    disabled: { type: 'boolean', default: false }
    loading: { type: 'boolean', default: false }
    size: { type: 'string', default: 'md' }
    fluid: { type: 'boolean', default: false }
    separator: { type: 'string', default: '/' }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
    filterable: { type: 'boolean', default: false }
    changeOnSelect: { type: 'boolean', default: false }
    multiple: { type: 'boolean', default: false }
    expandTrigger: { type: 'string', default: 'hover' }
    showAllLevels: { type: 'boolean', default: true }
    emitPath: { type: 'boolean', default: true }
  }
  emits: ['change']
</contract>

function sizeOf(value) {
  const next = String(read(value) || 'md')
  if (next === 'sm' || next === 'lg') return next
  return 'md'
}

function normalizedTree(source) {
  const list = read(source)
  return Array.isArray(list) ? list : []
}

function isMultiple(multipleProp) {
  return !!read(multipleProp)
}

function usesPath(emitPathProp) {
  return read(emitPathProp) !== false
}

function findPathByLeaf(nodes, leaf, trail = []) {
  for (const node of nodes) {
    const next = [...trail, node.value]
    if (String(node.value) === String(leaf)) return next
    const children = node.children || []
    if (children.length) {
      const found = findPathByLeaf(children, leaf, next)
      if (found) return found
    }
  }
  return null
}

function toPath(value, sep, source, emitPathProp) {
  const current = read(value)
  if (usesPath(emitPathProp)) {
    if (Array.isArray(current)) {
      if (current.length && Array.isArray(current[0])) return []
      return current.filter((item) => item !== undefined && item !== null && item !== '')
    }
    if (typeof current === 'string' && current) return current.split(read(sep) || '/').filter(Boolean)
    return []
  }
  if (current === undefined || current === null || current === '') return []
  return findPathByLeaf(normalizedTree(source), current) || []
}

function toPaths(value, sep, source, emitPathProp, multipleProp) {
  const current = read(value)
  if (!isMultiple(multipleProp)) {
    const path = toPath(value, sep, source, emitPathProp)
    return path.length ? [path] : []
  }
  if (!Array.isArray(current)) return []
  if (usesPath(emitPathProp)) {
    return current
      .map((item) => (Array.isArray(item) ? item.filter((step) => step !== undefined && step !== null && step !== '') : []))
      .filter((path) => path.length)
  }
  return current
    .map((leaf) => findPathByLeaf(normalizedTree(source), leaf))
    .filter((path) => Array.isArray(path) && path.length)
}

function findNode(nodes, value) {
  return nodes.find((node) => String(node.value) === String(value))
}

function pathLabels(tree, path) {
  const labels = []
  let level = tree
  for (const step of path) {
    const node = findNode(level, step)
    if (!node) break
    labels.push(node.label)
    level = node.children || []
  }
  return labels
}

function pathKey(path) {
  return path.map(String).join('\0')
}

function formatPath(tree, path, sep, showAll) {
  const labels = pathLabels(tree, path)
  if (!labels.length) return ''
  if (read(showAll) === false) return labels[labels.length - 1]
  return labels.join(` ${read(sep) || '/'} `)
}

function displayValue(value, source, sep, placeholderValue, emitPathProp, multipleProp, showAllProp) {
  const tree = normalizedTree(source)
  const paths = toPaths(value, sep, source, emitPathProp, multipleProp)
  const empty = propText(placeholderValue, 'j.cascader.placeholder', 'Select')
  if (!paths.length) return empty
  if (isMultiple(multipleProp)) {
    return paths.map((path) => formatPath(tree, path, sep, showAllProp)).filter(Boolean).join(', ')
  }
  return formatPath(tree, paths[0], sep, showAllProp) || empty
}

function modelPayload(paths, emitPathProp, multipleProp) {
  if (isMultiple(multipleProp)) {
    return usesPath(emitPathProp) ? paths.map((path) => [...path]) : paths.map((path) => path[path.length - 1])
  }
  if (!paths.length) return usesPath(emitPathProp) ? [] : null
  return usesPath(emitPathProp) ? [...paths[0]] : paths[0][paths[0].length - 1]
}

function commitPaths(model, paths, emitFn, emitPathProp, multipleProp) {
  const next = modelPayload(paths, emitPathProp, multipleProp)
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function commitPath(model, path, emitFn, emitPathProp, multipleProp) {
  commitPaths(model, path.length ? [path] : [], emitFn, emitPathProp, multipleProp)
}

function collectLeaves(nodes, trail = [], out = []) {
  nodes.forEach((node) => {
    const next = [...trail, node.value]
    const children = node.children || []
    if (children.length) collectLeaves(children, next, out)
    else out.push({ path: next, label: node.label, labels: null })
  })
  return out
}

function filterMatches(tree, query, sep, showAllProp) {
  const needle = String(query || '').trim().toLowerCase()
  if (!needle) return []
  return collectLeaves(tree).filter((item) => {
    const labels = pathLabels(tree, item.path)
    item.labels = labels
    item.text = formatPath(tree, item.path, sep, showAllProp)
    return labels.some((label) => String(label).toLowerCase().includes(needle))
  })
}

function isMobileLayout() {
  if (typeof window === 'undefined' || typeof matchMedia !== 'function') return false
  return matchMedia('(max-width: 640px)').matches
}

function nodesAtDepth(tree, path, depth) {
  let level = tree
  for (let index = 0; index < depth; index += 1) {
    const node = findNode(level, path[index])
    if (!node) return []
    level = node.children || []
  }
  return level
}

function clearHoverTimer(root) {
  const state = root?.cascaderState
  if (!state?.hoverTimer) return
  clearTimeout(state.hoverTimer)
  state.hoverTimer = 0
}

function expandBranch(root, level, node) {
  const state = root.cascaderState
  const nextPath = [...state.path.slice(0, level), node.value]
  const same =
    nextPath.length === state.path.length &&
    nextPath.every((step, index) => String(step) === String(state.path[index]))
  if (same) return
  state.path = nextPath
  renderColumns(root)
}

function pathSelected(paths, path) {
  const key = pathKey(path)
  return paths.some((item) => pathKey(item) === key)
}

function buildColumn(nodes, activeValue, level, root, committedPaths) {
  const list = document.createElement('ul')
  list.className = 'jui-cascader__column'
  list.setAttribute('role', 'listbox')
  list.dataset.cascaderLevel = String(level)
  const changeOnSelect = !!root.cascaderState?.changeOnSelect
  const multiple = !!root.cascaderState?.multiple
  const expandTrigger = root.cascaderState?.expandTrigger || 'hover'

  nodes.forEach((node) => {
    const item = document.createElement('li')
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'jui-cascader__option'
    button.setAttribute('role', 'option')
    const hasChildren = Array.isArray(node.children) && node.children.length > 0
    const branchPath = [...root.cascaderState.path.slice(0, level), node.value]
    const isActive = String(node.value) === String(activeValue)
    const isCommitted = pathSelected(committedPaths, branchPath) || (
      !multiple &&
      !changeOnSelect &&
      !hasChildren &&
      committedPaths.some((path) => (
        path.length === level + 1 &&
        String(path[path.length - 1]) === String(node.value)
      ))
    )
    button.classList.toggle('is-active', isActive)
    button.classList.toggle('is-selected', isCommitted)
    button.classList.toggle('has-children', hasChildren)
    button.setAttribute('aria-selected', isActive || isCommitted ? 'true' : 'false')

    if (multiple || changeOnSelect) {
      const mark = document.createElement('span')
      mark.className = 'jui-cascader__radio'
      mark.classList.toggle('is-on', isCommitted)
      mark.setAttribute('aria-hidden', 'true')
      button.appendChild(mark)
    }

    const text = document.createElement('span')
    text.className = 'jui-cascader__option-label'
    text.textContent = node.label
    button.appendChild(text)

    if (hasChildren) {
      const caret = document.createElement('span')
      caret.className = 'jui-cascader__caret'
      caret.setAttribute('aria-hidden', 'true')
      button.appendChild(caret)
    } else if (isCommitted && !multiple && !changeOnSelect) {
      const check = document.createElement('span')
      check.className = 'jui-cascader__check'
      check.setAttribute('aria-hidden', 'true')
      button.appendChild(check)
    }

    button.addEventListener('pointerdown', (event) => {
      if (!hasChildren || changeOnSelect || multiple) event.preventDefault()
    })
    button.addEventListener('click', (event) => {
      event.preventDefault()
      event.stopPropagation()
      selectNode(root, level, node)
    })
    button.addEventListener('pointerenter', () => {
      const state = root.cascaderState
      if (!state || state.mobile || expandTrigger !== 'hover') return
      clearHoverTimer(root)
      if (!hasChildren) return
      state.hoverTimer = setTimeout(() => expandBranch(root, level, node), 70)
    })
    item.appendChild(button)
    list.appendChild(item)
  })

  return list
}

function buildMobileNav(root) {
  const state = root.cascaderState
  const nav = document.createElement('div')
  nav.className = 'jui-cascader__nav'

  const back = document.createElement('button')
  back.type = 'button'
  back.className = 'jui-cascader__nav-back'
  back.textContent = localeText('j.cascader.back', 'Back')
  back.disabled = state.path.length === 0
  back.addEventListener('click', () => {
    if (!state.path.length) return
    state.path = state.path.slice(0, -1)
    renderColumns(root)
  })

  const title = document.createElement('span')
  title.className = 'jui-cascader__nav-title'
  const labels = pathLabels(state.tree, state.path)
  title.textContent = labels.length ? labels[labels.length - 1] : localeText('j.cascader.placeholder', 'Select')

  nav.appendChild(back)
  nav.appendChild(title)
  return nav
}

function renderFilterResults(root) {
  const state = root.cascaderState
  const container = root.querySelector('[data-cascader-columns]')
  container.replaceChildren()
  const matches = filterMatches(state.tree, state.query, state.separator, state.showAllLevels)
  const list = document.createElement('ul')
  list.className = 'jui-cascader__column jui-cascader__column--filter'
  list.setAttribute('role', 'listbox')
  if (!matches.length) {
    const empty = document.createElement('li')
    empty.className = 'jui-cascader__empty'
    empty.textContent = localeText('j.cascader.noMatches', 'No matches')
    list.appendChild(empty)
    container.appendChild(list)
    return
  }
  matches.forEach((match) => {
    const item = document.createElement('li')
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'jui-cascader__option'
    button.classList.toggle('is-selected', pathSelected(state.committedPaths, match.path))
    button.setAttribute('role', 'option')
    const text = document.createElement('span')
    text.className = 'jui-cascader__option-label'
    text.textContent = match.text
    button.appendChild(text)
    button.addEventListener('click', (event) => {
      event.preventDefault()
      event.stopPropagation()
      choosePath(root, match.path)
    })
    item.appendChild(button)
    list.appendChild(item)
  })
  container.appendChild(list)
}

function renderColumns(root) {
  const state = root.cascaderState
  const container = root.querySelector('[data-cascader-columns]')
  const mobile = !!state.mobile
  root.classList.toggle('is-mobile', mobile)
  if (state.filterable && String(state.query || '').trim()) {
    renderFilterResults(root)
    return
  }
  container.replaceChildren()
  const committedPaths = state.committedPaths || []

  if (mobile) {
    container.appendChild(buildMobileNav(root))
    const depth = state.path.length
    const nodes = nodesAtDepth(state.tree, state.path, depth)
    if (nodes.length) {
      container.appendChild(buildColumn(nodes, state.path[depth], depth, root, committedPaths))
    }
    return
  }

  let level = state.tree
  for (let index = 0; index <= state.path.length; index += 1) {
    if (!level.length) break
    container.appendChild(buildColumn(level, state.path[index], index, root, committedPaths))
    const activeNode = findNode(level, state.path[index])
    if (!activeNode) break
    level = activeNode.children || []
  }

  requestAnimationFrame(() => {
    positionPanel(root)
    const maxScroll = Math.max(0, container.scrollWidth - container.clientWidth)
    if (maxScroll > 0) container.scrollLeft = maxScroll
  })
}

function positionPanel(root) {
  const panel = root.querySelector('[data-cascader-panel]')
  const field = root.querySelector('.jui-cascader__field')
  if (!panel || !field || panel.hidden) return

  const margin = 12
  const fieldRect = field.getBoundingClientRect()
  const viewport = typeof window === 'undefined' ? 1280 : window.innerWidth
  const spaceRight = Math.max(fieldRect.width, viewport - fieldRect.left - margin)
  const spaceLeft = Math.max(fieldRect.width, fieldRect.right - margin)
  const alignEnd = spaceLeft > spaceRight
  const available = Math.min(alignEnd ? spaceLeft : spaceRight, viewport - margin * 2)

  panel.style.left = alignEnd ? 'auto' : '0'
  panel.style.right = alignEnd ? '0' : 'auto'
  panel.style.maxWidth = `${available}px`
}

function choosePath(root, nextPath, { close = true } = {}) {
  const state = root.cascaderState
  if (state.multiple) {
    const key = pathKey(nextPath)
    const exists = state.committedPaths.some((path) => pathKey(path) === key)
    state.committedPaths = exists
      ? state.committedPaths.filter((path) => pathKey(path) !== key)
      : [...state.committedPaths, [...nextPath]]
    state.path = nextPath
    state.commit(state.committedPaths)
    renderColumns(root)
    return
  }
  state.committedPaths = [[...nextPath]]
  state.path = nextPath
  state.commit(state.committedPaths)
  if (!close) {
    renderColumns(root)
    return
  }
  root.__juiCascaderSkipOpen = true
  closePicker(root)
  setTimeout(() => {
    root.__juiCascaderSkipOpen = false
  }, 0)
}

function selectNode(root, level, node) {
  const state = root.cascaderState
  const nextPath = [...state.path.slice(0, level), node.value]
  const hasChildren = Array.isArray(node.children) && node.children.length > 0

  clearHoverTimer(root)
  state.path = nextPath

  if (hasChildren) {
    if (state.changeOnSelect) {
      choosePath(root, nextPath, { close: false })
      return
    }
    renderColumns(root)
    return
  }

  choosePath(root, nextPath, { close: !state.multiple })
}

function closePicker(root) {
  if (!root) return
  clearHoverTimer(root)
  const panel = root.querySelector('[data-cascader-panel]')
  if (panel) {
    panel.hidden = true
    panel.style.left = ''
    panel.style.right = ''
    panel.style.maxWidth = ''
  }
  root.querySelector('[data-cascader-trigger]')?.setAttribute('aria-expanded', 'false')
  root.classList.remove('is-open', 'is-mobile')
  root.cascaderController?.abort()
}

function openPicker(event, model, source, sep, loadingProp, emitFn, config) {
  const root = event.currentTarget.closest('[data-cascader]')
  if (!root || event.currentTarget.disabled || read(loadingProp) || root.__juiCascaderSkipOpen) return

  document.querySelectorAll('[data-cascader-panel]:not([hidden])').forEach((panel) => {
    const otherRoot = panel.closest('[data-cascader]')
    if (otherRoot !== root) closePicker(otherRoot)
  })

  if (!root.querySelector('[data-cascader-panel]')?.hidden) {
    closePicker(root)
    return
  }

  const emitPathProp = config.emitPath
  const multipleProp = config.multiple
  const committedPaths = toPaths(model, sep, source, emitPathProp, multipleProp)
  const expandTrigger = String(read(config.expandTrigger) || 'hover') === 'click' ? 'click' : 'hover'
  root.cascaderState = {
    tree: normalizedTree(source),
    path: committedPaths[0] ? [...committedPaths[0]] : [],
    committedPaths: committedPaths.map((path) => [...path]),
    mobile: isMobileLayout(),
    hoverTimer: 0,
    query: '',
    filterable: !!read(config.filterable),
    changeOnSelect: !!read(config.changeOnSelect),
    multiple: !!read(multipleProp),
    expandTrigger,
    separator: sep,
    showAllLevels: config.showAllLevels,
    commit: (paths) => commitPaths(model, paths, emitFn, emitPathProp, multipleProp),
  }

  const search = root.querySelector('[data-cascader-search]')
  if (search) search.value = ''

  renderColumns(root)
  root.querySelector('[data-cascader-panel]').hidden = false
  root.classList.add('is-open')
  event.currentTarget.setAttribute('aria-expanded', 'true')
  positionPanel(root)

  root.cascaderController?.abort()
  const controller = new AbortController()
  root.cascaderController = controller
  requestAnimationFrame(() => {
    positionPanel(root)
    if (search && root.cascaderState.filterable) search.focus()
    document.addEventListener('pointerdown', (pointerEvent) => {
      if (!root.contains(pointerEvent.target)) closePicker(root)
    }, { signal: controller.signal })
    document.addEventListener('keydown', (keyEvent) => {
      if (keyEvent.key === 'Escape') {
        closePicker(root)
        event.currentTarget.focus()
      }
    }, { signal: controller.signal })
    window.addEventListener('resize', () => positionPanel(root), { signal: controller.signal })
  })
}

function onSearchInput(event) {
  const root = event.currentTarget.closest('[data-cascader]')
  if (!root?.cascaderState) return
  root.cascaderState.query = event.currentTarget.value
  renderColumns(root)
}

function hasSelection(valueProp, sep, source, emitPathProp, multipleProp) {
  return toPaths(valueProp, sep, source, emitPathProp, multipleProp).length > 0
}

function pickerConfig(filterableProp, changeOnSelectProp, multipleProp, expandTriggerProp, showAllLevelsProp, emitPathProp) {
  return {
    filterable: filterableProp,
    changeOnSelect: changeOnSelectProp,
    multiple: multipleProp,
    expandTrigger: expandTriggerProp,
    showAllLevels: showAllLevelsProp,
    emitPath: emitPathProp,
  }
}

export <view>
  <div
    class="jui-cascader"
    class-jui-cascader--sm=${() => sizeOf(size) === 'sm'}
    class-jui-cascader--lg=${() => sizeOf(size) === 'lg'}
    class-is-fluid=${() => !!read(fluid)}
    class-has-error=${() => !!read(error)}
    class-is-disabled=${() => !!(read(disabled) || read(loading))}
    class-is-loading=${() => !!read(loading)}
    class-is-multiple=${() => !!read(multiple)}
    data-cascader
  >
    #if read(label)
      <span class="jui-cascader__label">${() => read(label)}</span>
    #end

    <span class="jui-cascader__field">
      <span class="jui-cascader__control">
        <button
          type="button"
          class="jui-cascader__trigger"
          data-cascader-trigger
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-busy=${() => (read(loading) ? 'true' : 'false')}
          disabled=${() => !!(read(disabled) || read(loading))}
          on-click=${(event) => openPicker(
            event,
            value,
            options,
            separator,
            loading,
            emit,
            pickerConfig(filterable, changeOnSelect, multiple, expandTrigger, showAllLevels, emitPath),
          )}
        >
          <span class="jui-cascader__face">
            <span
              class="jui-cascader__value"
              class-is-placeholder=${() => !hasSelection(value, separator, options, emitPath, multiple) || !!read(loading)}
            >
              ${() => (read(loading)
                ? localeText('j.cascader.loading', 'Loading…')
                : displayValue(value, options, separator, placeholder, emitPath, multiple, showAllLevels))}
            </span>
            #if read(loading)
              <span class="jui-cascader__spinner" aria-hidden="true"></span>
            #else
              <span class="jui-cascader__chevron" aria-hidden="true"></span>
            #end
          </span>
        </button>
        #if read(clearable) && !read(loading) && !read(disabled) && hasSelection(value, separator, options, emitPath, multiple)
          <button
            type="button"
            class="jui-cascader__clear"
            aria-label=${() => localeText('j.cascader.clear', 'Clear')}
            on-click=${() => commitPaths(value, [], emit, emitPath, multiple)}
          >×</button>
        #end
      </span>

      <div class="jui-cascader__backdrop" data-cascader-backdrop aria-hidden="true" on-click=${(event) => closePicker(event.currentTarget.closest('[data-cascader]'))}></div>

      <div class="jui-cascader__panel" data-cascader-panel role="dialog" aria-label=${() => localeText('j.cascader.choose', 'Choose option')} hidden>
        <div class="jui-cascader__sheet-handle" aria-hidden="true"></div>
        #if read(filterable)
          <label class="jui-cascader__search">
            <span class="jui-cascader__search-label">${() => localeText('j.common.filter', 'Filter')}</span>
            <input
              type="search"
              class="jui-cascader__search-input"
              data-cascader-search
              placeholder=${() => localeText('j.cascader.search', 'Search…')}
              autocomplete="off"
              on-input=${onSearchInput}
            />
          </label>
        #end
        <div class="jui-cascader__columns" data-cascader-columns></div>
        #if read(clearable)
          <div class="jui-cascader__footer">
            <button
              type="button"
              class="jui-cascader__text-btn"
              on-click=${(event) => {
                commitPaths(value, [], emit, emitPath, multiple)
                closePicker(event.currentTarget.closest('[data-cascader]'))
              }}
            >${() => localeText('j.cascader.clear', 'Clear')}</button>
          </div>
        #end
      </div>
    </span>

    #if read(error)
      <span class="jui-cascader__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-cascader__hint">${() => read(hint)}</span>
    #end
  </div>
</view>

export <style>
.jui-cascader {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-cascader.is-fluid {
  width: 100%;
}

.jui-cascader__control {
  position: relative;
  display: block;
  min-width: 0;
}

.jui-cascader__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-cascader.has-error .jui-cascader__label {
  color: var(--j-danger);
}

.jui-cascader.has-error .jui-cascader__trigger {
  border-color: var(--j-danger);
}

.jui-cascader.is-disabled {
  opacity: 0.65;
}

.jui-cascader__field {
  position: relative;
  display: block;
  min-width: 0;
}

.jui-cascader__trigger {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.65rem;
  width: 100%;
  min-height: 2.75rem;
  padding: 0.65rem 2.4rem 0.65rem 0.9rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  outline: 0;
  color: var(--j-text);
  background: var(--j-surface-2);
  font: inherit;
  line-height: 1.2;
  text-align: left;
  cursor: pointer;
  transition: border-color 120ms ease, box-shadow 120ms ease;
  touch-action: manipulation;
}

.jui-cascader--sm .jui-cascader__trigger {
  min-height: 2.25rem;
  padding: 0.4rem 2.2rem 0.4rem 0.75rem;
  font-size: 0.85rem;
}

