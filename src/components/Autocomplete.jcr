import { read } from '../internal/utils.js'
import { propText } from '../i18n/index.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'string', default: '', model: true }
    suggestions: { type: 'any', required: true }
    placeholder: { type: 'string', default: 'Search...' }
    disabled: { type: 'boolean', default: false }
    clearable: { type: 'boolean', default: true }
    debounce: { type: 'number', default: 150 }
    loading: { type: 'boolean', default: false }
    remote: { type: 'boolean', default: false }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
  }
  emits: ['change', 'select', 'search']
</contract>

function normalizedSuggestions(source) {
  return (read(source) || []).map((item) => (item && typeof item === 'object')
    ? { value: item.value, label: item.label ?? String(item.value) }
    : { value: item, label: String(item) })
}

function commitValue(model, next, emitFn) {
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function applyFilter(input) {
  const root = input.closest('[data-autocomplete]')
  if (!root) return
  const query = String(input.value || '').trim().toLowerCase()
  let visible = 0
  root.querySelectorAll('[data-ac-option]').forEach((button) => {
    const haystack = String(button.getAttribute('data-search') || '')
    const matches = haystack.includes(query)
    const item = button.closest('li')
    if (item) item.hidden = !matches
    if (matches) visible += 1
  })
  const empty = root.querySelector('[data-ac-empty]')
  if (empty) empty.hidden = visible > 0
  const panel = root.querySelector('[data-ac-panel]')
  if (panel) panel.hidden = false
  input.setAttribute('aria-expanded', 'true')
}

function showAllOptions(root) {
  if (!root) return
  root.querySelectorAll('[data-ac-option]').forEach((button) => {
    const item = button.closest('li')
    if (item) item.hidden = false
  })
  const empty = root.querySelector('[data-ac-empty]')
  if (empty) {
    const count = root.querySelectorAll('[data-ac-option]').length
    empty.hidden = count > 0 || !!root.querySelector('[data-ac-loading]')
  }
}

function debouncedInput(event, delayValue, remoteProp, model, emitFn) {
  const input = event.currentTarget
  const query = String(input.value || '')
  commitValue(model, query, emitFn)
  openPanel(event)

  window.clearTimeout(input.__juiAcTimer)
  const delay = Number(read(delayValue)) || 0
  const remote = !!read(remoteProp)

  const run = () => {
    if (remote) {
      const root = input.closest('[data-autocomplete]')
      showAllOptions(root)
      emitFn('search', query.trim())
      return
    }
    applyFilter(input)
  }

  if (delay <= 0) {
    run()
    return
  }
  input.__juiAcTimer = window.setTimeout(run, delay)
}

function openPanel(event) {
  const root = event.currentTarget.closest('[data-autocomplete]')
  if (!root || event.currentTarget.disabled || root.__juiAcSkipOpen) return
  root.acController?.abort()
  const controller = new AbortController()
  root.acController = controller
  const panel = root.querySelector('[data-ac-panel]')
  if (panel) panel.hidden = false
  const input = root.querySelector('[data-ac-input]')
  if (input) input.setAttribute('aria-expanded', 'true')
  document.addEventListener('pointerdown', (pointerEvent) => {
    if (!root.contains(pointerEvent.target)) closePanel(root)
  }, { signal: controller.signal })
}

function closePanel(root) {
  if (!root) return
  const panel = root.querySelector('[data-ac-panel]')
  if (panel) panel.hidden = true
  const input = root.querySelector('[data-ac-input]')
  if (input) input.setAttribute('aria-expanded', 'false')
  root.acController?.abort()
}

function selectSuggestion(option, event, model, emitFn) {
  event.preventDefault()
  const root = event.currentTarget.closest('[data-autocomplete]')
  const input = root?.querySelector('[data-ac-input]')
  if (input) input.value = option.label
  commitValue(model, option.label, emitFn)
  emitFn('select', option)
  if (root) root.__juiAcSkipOpen = true
  closePanel(root)
  if (input) {
    input.focus({ preventScroll: true })
    queueMicrotask(() => {
      if (root) root.__juiAcSkipOpen = false
      closePanel(root)
    })
  }
}

function clearValue(event, model, remoteProp, emitFn) {
  const root = event.currentTarget.closest('[data-autocomplete]')
  const input = root?.querySelector('[data-ac-input]')
  if (input) input.value = ''
  commitValue(model, '', emitFn)
  if (read(remoteProp)) emitFn('search', '')
  input?.focus()
}

function hasSuggestions(source) {
  return normalizedSuggestions(source).length > 0
}

export <view>
  <div
    class="jui-autocomplete"
    data-autocomplete
    class-has-error=${() => !!read(error)}
    class-is-disabled=${() => !!read(disabled)}
    class-is-loading=${() => !!read(loading)}
  >
    #if read(label)
      <span class="jui-autocomplete__label">${() => read(label)}</span>
    #end

    <div class="jui-autocomplete__control">
      <div class="jui-autocomplete__field">
        <input
          class="jui-autocomplete__input"
          data-ac-input
          type="text"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-busy=${() => (read(loading) ? 'true' : 'false')}
          autocomplete="off"
          placeholder=${() => propText(placeholder, 'j.autocomplete.placeholder', 'Search...')}
          value=${() => read(value)}
          disabled=${() => !!read(disabled)}
          aria-invalid=${() => !!read(error)}
          on-focus=${openPanel}
          on-input=${(event) => debouncedInput(event, debounce, remote, value, emit)}
          on-keydown=${(event) => {
            if (event.key === 'Escape') closePanel(event.currentTarget.closest('[data-autocomplete]'))
          }}
        />
        #if read(loading)
          <span class="jui-autocomplete__spinner" aria-hidden="true"></span>
        #elif read(clearable) && read(value)
          <button
            type="button"
            class="jui-autocomplete__clear"
            aria-label="Clear"
            on-click=${(event) => clearValue(event, value, remote, emit)}
          >×</button>
        #end
      </div>

      <ul class="jui-autocomplete__panel" data-ac-panel role="listbox" hidden>
        #if read(loading)
          <li class="jui-autocomplete__loading" data-ac-loading aria-live="polite">
            <span class="jui-autocomplete__spinner" aria-hidden="true"></span>
            <span>Searching…</span>
          </li>
        #end

        #for normalizedSuggestions(suggestions) as option (option.value)
          <li>
            <button
              type="button"
              role="option"
              class="jui-autocomplete__option"
              data-ac-option
              data-search=${() => String(option.label).toLowerCase()}
              on-pointerdown=${(event) => event.preventDefault()}
              on-click=${(event) => selectSuggestion(option, event, value, emit)}
            >${option.label}</button>
          </li>
        #end

        #if !read(loading) && !hasSuggestions(suggestions)
          <li class="jui-autocomplete__empty" data-ac-empty>No matches</li>
        #elif !read(remote)
          <li class="jui-autocomplete__empty" data-ac-empty hidden>No matches</li>
        #end
      </ul>
    </div>

    #if read(error)
      <span class="jui-autocomplete__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-autocomplete__hint">${() => read(hint)}</span>
    #end
  </div>
</view>

export <style>
.jui-autocomplete {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-autocomplete__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-autocomplete__control {
  position: relative;
  min-width: 0;
}

.jui-autocomplete__field {
  position: relative;
  display: flex;
  align-items: center;
}

.jui-autocomplete__input {
  width: 100%;
  min-height: 2.75rem;
  padding: 0.65rem 2.6rem 0.65rem 0.9rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  outline: 0;
  color: var(--j-text);
  background: var(--j-surface-2);
  font: inherit;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

.jui-autocomplete__input:focus {
  border-color: var(--j-primary);
  box-shadow: var(--j-focus);
}

.jui-autocomplete__input:disabled {
  cursor: not-allowed;
}

.jui-autocomplete.has-error .jui-autocomplete__input {
  border-color: var(--j-danger);
}

.jui-autocomplete.has-error .jui-autocomplete__label {
  color: var(--j-danger);
}

.jui-autocomplete.is-disabled {
  opacity: 0.65;
}

.jui-autocomplete__clear,
.jui-autocomplete__field > .jui-autocomplete__spinner {
  position: absolute;
  right: 0.5rem;
  display: grid;
  place-items: center;
  width: 1.9rem;
  height: 1.9rem;
}

.jui-autocomplete__clear {
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-muted);
  background: transparent;
  font-size: 1.1rem;
  line-height: 1;
  cursor: pointer;
}

.jui-autocomplete__clear:hover {
  background: var(--j-mint);
  color: var(--j-text);
}

.jui-autocomplete__spinner {
  box-sizing: border-box;
  width: 1.05rem;
  height: 1.05rem;
  border: 2px solid color-mix(in srgb, var(--j-primary) 25%, var(--j-border));
  border-right-color: var(--j-primary);
  border-radius: 50%;
  animation: jui-ac-spin 0.7s linear infinite;
}

.jui-autocomplete__panel {
  position: absolute;
  z-index: 80;
  top: calc(100% + 0.4rem);
  left: 0;
  right: 0;
  display: grid;
  gap: 0.18rem;
  max-height: 14rem;
  margin: 0;
  padding: 0.45rem;
  overflow-y: auto;
  list-style: none;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius);
  background: var(--j-surface-2);
  box-shadow: var(--j-shadow);
}

.jui-autocomplete__panel[hidden] {
  display: none;
}

.jui-autocomplete__option {
  display: block;
  width: 100%;
  min-height: 2.5rem;
  padding: 0.5rem 0.7rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-text);
  background: transparent;
  cursor: pointer;
  text-align: left;
}

.jui-autocomplete__option:hover {
  background: var(--j-mint);
}

.jui-autocomplete__loading,
.jui-autocomplete__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.85rem 0.8rem;
  color: var(--j-muted);
  font-size: 0.82rem;
  text-align: center;
}

.jui-autocomplete__hint,
.jui-autocomplete__error {
  font-size: 0.8rem;
}

.jui-autocomplete__hint {
  color: var(--j-muted);
}

.jui-autocomplete__error {
  color: var(--j-danger);
  font-weight: 600;
}

@keyframes jui-ac-spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .jui-autocomplete__spinner {
    animation: none;
    border-right-color: currentColor;
    opacity: 0.55;
  }
}
</style>
