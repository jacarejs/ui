import { pulse } from '@jacare/core'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    text: { type: 'string', required: true }
    tone: { type: 'string', default: 'default' }
    variant: { type: 'string', default: '' }
    size: { type: 'string', default: 'md' }
    shape: { type: 'string', default: 'pill' }
    color: { type: 'string', default: '' }
    soft: { type: 'boolean', default: false }
    dot: { type: 'boolean', default: false }
    dismissible: { type: 'boolean', default: false }
    open: { type: 'boolean', default: true, model: true }
  }
  emits: ['dismiss']
</contract>

function variantOf(variantValue, softValue) {
  const explicit = read(variantValue)
  if (explicit === 'soft' || explicit === 'outline' || explicit === 'solid') return explicit
  return read(softValue) ? 'soft' : 'solid'
}

function openState(openProp, emitFn) {
  if (openProp && typeof openProp.set === 'function') return openProp
  if (!emitFn.__juiOpen) {
    emitFn.__juiOpen = pulse(read(openProp) !== false)
  }
  return emitFn.__juiOpen
}

function isOpen(openProp, emitFn) {
  return read(openState(openProp, emitFn)) !== false
}

function dismissBadge(openProp, emitFn) {
  openState(openProp, emitFn).set(false)
  emitFn('dismiss')
}

function customStyle(value) {
  const next = String(read(value) || '').trim()
  return next ? `--jui-badge-color:${next}` : ''
}

export <view>
  #if isOpen(open, emit)
    <span
      class="jui-badge"
      class-jui-badge--soft=${() => variantOf(variant, soft) === 'soft'}
      class-jui-badge--outline=${() => variantOf(variant, soft) === 'outline'}
      class-jui-badge--sm=${() => read(size) === 'sm'}
      class-jui-badge--lg=${() => read(size) === 'lg'}
      class-jui-badge--rounded=${() => read(shape) === 'rounded'}
      class-jui-badge--success=${() => read(tone) === 'success'}
      class-jui-badge--warn=${() => read(tone) === 'warn'}
      class-jui-badge--danger=${() => read(tone) === 'danger'}
      class-jui-badge--info=${() => read(tone) === 'info'}
      class-jui-badge--neutral=${() => read(tone) === 'neutral'}
      :style=${() => customStyle(color)}
    >
      #if read(dot)
        <span class="jui-badge__dot" aria-hidden="true"></span>
      #end
      <span class="jui-badge__label">${text}</span>
      #if read(dismissible)
        <button
          type="button"
          class="jui-badge__close"
          aria-label="Dismiss"
          on-click=${() => dismissBadge(open, emit)}
        >
          <span aria-hidden="true">×</span>
        </button>
      #end
    </span>
  #end
</view>

export <style>
.jui-badge {
  --jui-badge-color: var(--j-forest);
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  min-height: 1.5rem;
  padding: 0.15rem 0.55rem;
  border-radius: var(--j-radius-pill);
  border: 1px solid transparent;
  background: var(--jui-badge-color);
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.2;
  white-space: nowrap;
}

.jui-badge--success { --jui-badge-color: var(--j-primary); }
.jui-badge--warn { --jui-badge-color: var(--j-warn); }
.jui-badge--danger { --jui-badge-color: var(--j-danger); }
.jui-badge--info { --jui-badge-color: var(--j-info, #1f6feb); }
.jui-badge--neutral { --jui-badge-color: var(--j-muted); }

.jui-badge--sm {
  min-height: 1.2rem;
  padding: 0.05rem 0.4rem;
  font-size: 0.68rem;
}

.jui-badge--lg {
  min-height: 1.85rem;
  padding: 0.3rem 0.75rem;
  font-size: 0.85rem;
}

.jui-badge--rounded {
  border-radius: var(--j-radius-sm, 0.4rem);
}

.jui-badge--soft {
  background: color-mix(in srgb, var(--jui-badge-color) 14%, var(--j-surface));
  color: var(--jui-badge-color);
  border-color: color-mix(in srgb, var(--jui-badge-color) 26%, transparent);
}

.jui-badge--outline {
  background: transparent;
  color: var(--jui-badge-color);
  border-color: color-mix(in srgb, var(--jui-badge-color) 55%, transparent);
}

.jui-badge__dot {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

.jui-badge--soft .jui-badge__dot,
.jui-badge--outline .jui-badge__dot {
  background: var(--jui-badge-color);
}

.jui-badge__close {
  appearance: none;
  display: inline-grid;
  place-items: center;
  width: 1.05rem;
  height: 1.05rem;
  margin-right: -0.2rem;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: inherit;
  font-size: 0.95rem;
  line-height: 1;
  cursor: pointer;
  opacity: 0.72;
}

.jui-badge__close:hover {
  opacity: 1;
  background: color-mix(in srgb, currentColor 18%, transparent);
}

.jui-badge__close:focus-visible {
  outline: none;
  box-shadow: var(--j-focus);
  opacity: 1;
}
</style>
