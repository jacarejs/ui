import ChartFrame from './ChartFrame.jcr'
import ChartPlot from './ChartPlot.jcr'
import { read } from '../internal/utils.js'
import {
  chartLayoutWidth,
  escapeXml,
  extent,
  formatNumber,
  niceTicks,
  padOf,
  resolveChartWidth,
  scaleLinear,
  sizeOf,
  waterfallSteps,
} from '../internal/charts.js'

export <contract>
  props: {
    data: { type: 'any', required: true }
    title: { type: 'string', default: '' }
    caption: { type: 'string', default: '' }
    width: { type: 'number', default: 480 }
    height: { type: 'number', default: 280 }
    colors: { type: 'any', default: null }
  }
  emits: ['layout']
</contract>

function model(dataProp, colorsProp, widthProp, heightProp) {
  const { width, height } = sizeOf(widthProp, heightProp, 480, 280)
  const pad = padOf(null)
  const steps = waterfallSteps(dataProp, colorsProp)
  const values = steps.flatMap((step) => [step.y0, step.y1])
  const yDomain = extent(values, 0.08)
  if (yDomain.min > 0) yDomain.min = 0
  const ticks = niceTicks(yDomain.min, yDomain.max, 4)
  const plotW = width - pad.left - pad.right
  const slot = plotW / Math.max(steps.length, 1)
  const barW = slot * 0.5
  const yScale = scaleLinear(yDomain.min, yDomain.max, height - pad.bottom, pad.top)
  return {
    width,
    height,
    pad,
    ticks: ticks.map((tick) => ({ value: tick, y: yScale(tick), label: formatNumber(tick) })),
    bars: steps.map((step, index) => {
      const y0 = yScale(step.y0)
      const y1 = yScale(step.y1)
      return {
        ...step,
        x: pad.left + index * slot + (slot - barW) / 2,
        y: Math.min(y0, y1),
        width: barW,
        height: Math.max(1, Math.abs(y0 - y1)),
        labelX: pad.left + index * slot + slot / 2,
        title: `${step.label}: ${formatNumber(step.value)}`,
      }
    }),
  }
}

function plotContent(dataProp, colorsProp, widthProp, heightProp) {
  const next = model(dataProp, colorsProp, widthProp, heightProp)
  const parts = []
  for (const tick of next.ticks) {
    parts.push(
      `<line x1="${next.pad.left}" x2="${next.width - next.pad.right}" y1="${tick.y}" y2="${tick.y}" stroke="color-mix(in srgb, var(--j-border) 70%, transparent)" stroke-width="1" />`,
    )
    parts.push(
      `<text x="${next.pad.left - 8}" y="${tick.y}" text-anchor="end" dominant-baseline="middle" fill="var(--j-muted)" font-size="11">${escapeXml(tick.label)}</text>`,
    )
  }
  for (const bar of next.bars) {
    parts.push(
      `<rect x="${bar.x}" y="${bar.y}" width="${bar.width}" height="${bar.height}" rx="4" fill="${escapeXml(bar.color)}" data-jui-tip="${escapeXml(bar.title)}" />`,
    )
    parts.push(
      `<text x="${bar.labelX}" y="${next.height - 12}" text-anchor="middle" fill="var(--j-muted)" font-size="11">${escapeXml(bar.label)}</text>`,
    )
  }
  return parts.join('')
}

export <view>
  <ChartFrame
    :title=${title}
    :caption=${caption}
    :width=${() => resolveChartWidth(width, emit)}
    :height=${height}
  >
    <ChartPlot
      bind-layoutWidth=${chartLayoutWidth(emit)}
      :width=${() => resolveChartWidth(width, emit)}
      :height=${() => model(data, colors, resolveChartWidth(width, emit), height).height}
      :label=${() => read(title) || 'Waterfall chart'}
      :content=${() => plotContent(data, colors, resolveChartWidth(width, emit), height)}
    />
  </ChartFrame>
</view>
