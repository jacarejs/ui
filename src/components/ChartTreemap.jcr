import ChartFrame from './ChartFrame.jcr'
import ChartPlot from './ChartPlot.jcr'
import { read } from '../internal/utils.js'
import {
  asArray,
  chartLayoutWidth,
  colorAt,
  escapeXml,
  formatNumber,
  resolveChartWidth,
  sizeOf,
  treemapLayout,
} from '../internal/charts.js'

export <contract>
  props: {
    data: { type: 'any', required: true }
    title: { type: 'string', default: '' }
    caption: { type: 'string', default: '' }
    width: { type: 'number', default: 480 }
    height: { type: 'number', default: 280 }
    colors: { type: 'any', default: null }
  }
  emits: ['layout']
</contract>

function model(dataProp, colorsProp, widthProp, heightProp) {
  const { width, height } = sizeOf(widthProp, heightProp, 480, 280)
  const pad = 8
  const nodes = asArray(dataProp)
  const rects = treemapLayout(nodes, pad, pad, width - pad * 2, height - pad * 2).map((rect, index) => ({
    ...rect,
    color: rect.color || colorAt(index, colorsProp),
    showLabel: rect.width > 48 && rect.height > 28,
  }))
  return { width, height, rects }
}

function plotContent(dataProp, colorsProp, widthProp, heightProp) {
  const next = model(dataProp, colorsProp, widthProp, heightProp)
  const parts = []
  for (const rect of next.rects) {
    parts.push(
      `<rect x="${rect.x}" y="${rect.y}" width="${rect.width}" height="${rect.height}" rx="6" fill="${escapeXml(rect.color)}" stroke="var(--j-surface)" stroke-width="2" data-jui-tip="${escapeXml(rect.label)}: ${escapeXml(formatNumber(rect.value))}" />`,
    )
    if (rect.showLabel) {
      parts.push(
        `<text x="${rect.x + 10}" y="${rect.y + 20}" fill="#fff" font-size="12" font-weight="700">${escapeXml(rect.label)}</text>`,
      )
      parts.push(
        `<text x="${rect.x + 10}" y="${rect.y + 38}" fill="#fff" font-size="11" opacity="0.9">${escapeXml(formatNumber(rect.value))}</text>`,
      )
    }
  }
  return parts.join('')
}

export <view>
  <ChartFrame
    :title=${title}
    :caption=${caption}
    :width=${() => resolveChartWidth(width, emit)}
    :height=${height}
  >
    <ChartPlot
      bind-layoutWidth=${chartLayoutWidth(emit)}
      :width=${() => resolveChartWidth(width, emit)}
      :height=${() => model(data, colors, resolveChartWidth(width, emit), height).height}
      :label=${() => read(title) || 'Treemap chart'}
      :content=${() => plotContent(data, colors, resolveChartWidth(width, emit), height)}
    />
  </ChartFrame>
</view>
