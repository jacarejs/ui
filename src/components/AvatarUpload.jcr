import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'string', default: '', model: true }
    name: { type: 'string', default: '' }
    size: { type: 'number', default: 96 }
    disabled: { type: 'boolean', default: false }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
    accept: { type: 'string', default: 'image/*' }
  }
  emits: ['change', 'clear']
</contract>

function pixelSize(value) {
  const next = Number(read(value))
  return Number.isFinite(next) && next >= 48 ? Math.round(next) : 96
}

function styleOf(sizeValue) {
  return `--jui-avatar-upload-size:${pixelSize(sizeValue)}px`
}

function initialsOf(nameValue) {
  const raw = String(read(nameValue) ?? '').trim()
  if (!raw) return ''
  const parts = raw.split(/\s+/).filter(Boolean)
  const first = parts[0]?.[0] ?? ''
  const last = parts.length > 1 ? parts[parts.length - 1]?.[0] ?? '' : ''
  return `${first}${last}`.toUpperCase()
}

function hasInitials(nameValue) {
  return !!initialsOf(nameValue)
}

function previewLabel(nameValue, hasPhoto) {
  if (hasPhoto) return 'Replace profile photo'
  if (hasInitials(nameValue)) return `Upload photo for ${String(read(nameValue) || '').trim()}`
  return 'Choose profile photo'
}

function actionLabel(hasPhoto) {
  return hasPhoto ? 'Replace' : 'Upload'
}

function cropToCircle(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader()
    reader.onerror = () => reject(new Error('Could not read file'))
    reader.onload = () => {
      const image = new Image()
      image.onerror = () => reject(new Error('Could not load image'))
      image.onload = () => {
        const edge = Math.min(image.width, image.height)
        const sx = Math.floor((image.width - edge) / 2)
        const sy = Math.floor((image.height - edge) / 2)
        const canvas = document.createElement('canvas')
        const output = 256
        canvas.width = output
        canvas.height = output
        const ctx = canvas.getContext('2d')
        ctx.beginPath()
        ctx.arc(output / 2, output / 2, output / 2, 0, Math.PI * 2)
        ctx.closePath()
        ctx.clip()
        ctx.drawImage(image, sx, sy, edge, edge, 0, 0, output, output)
        resolve(canvas.toDataURL('image/png'))
      }
      image.src = String(reader.result || '')
    }
    reader.readAsDataURL(file)
  })
}

function onFile(event, model, disabledValue, emitFn) {
  if (read(disabledValue)) return
  const file = event.target.files?.[0]
  event.target.value = ''
  if (!file) return
  cropToCircle(file)
    .then((dataUrl) => {
      if (model && typeof model.set === 'function') model.set(dataUrl)
      emitFn('change', dataUrl)
    })
    .catch(() => {
      emitFn('change', '')
    })
}

function clearValue(model, disabledValue, emitFn) {
  if (read(disabledValue)) return
  if (model && typeof model.set === 'function') model.set('')
  emitFn('clear')
  emitFn('change', '')
}

function openPicker(event) {
  event.currentTarget.closest('[data-jui-avatar-upload]')?.querySelector('input[type="file"]')?.click()
}

export <view>
  <div
    class="jui-avatar-upload"
    class-has-error=${() => !!read(error)}
    class-is-disabled=${() => !!read(disabled)}
    class-has-photo=${() => !!read(value)}
    class-has-initials=${() => !read(value) && hasInitials(name)}
    data-jui-avatar-upload
    style=${() => styleOf(size)}
  >
    #if read(label)
      <span class="jui-avatar-upload__label">${() => read(label)}</span>
    #end

    <div class="jui-avatar-upload__row">
      <button
        type="button"
        class="jui-avatar-upload__preview"
        disabled=${() => !!read(disabled)}
        aria-label=${() => previewLabel(name, !!read(value))}
        on-click=${openPicker}
      >
        #if read(value)
          <img class="jui-avatar-upload__img" src=${() => read(value)} alt="" />
        #elif hasInitials(name)
          <span class="jui-avatar-upload__initials" aria-hidden="true">${() => initialsOf(name)}</span>
        #else
          <span class="jui-avatar-upload__placeholder" aria-hidden="true">+</span>
        #end
      </button>

      <div class="jui-avatar-upload__actions">
        <button type="button" class="jui-avatar-upload__btn" disabled=${() => !!read(disabled)} on-click=${openPicker}>
          ${() => actionLabel(!!read(value))}
        </button>
        #if read(value)
          <button type="button" class="jui-avatar-upload__btn jui-avatar-upload__btn--ghost" disabled=${() => !!read(disabled)} on-click=${() => clearValue(value, disabled, emit)}>
            Remove
          </button>
        #end
      </div>
    </div>

    <input
      class="jui-avatar-upload__file"
      type="file"
      accept=${() => read(accept) || 'image/*'}
      disabled=${() => !!read(disabled)}
      on-change=${(event) => onFile(event, value, disabled, emit)}
    />

    #if read(error)
      <span class="jui-avatar-upload__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-avatar-upload__hint">${() => read(hint)}</span>
    #end
  </div>
</view>

export <style>
.jui-avatar-upload {
  position: relative;
  display: grid;
  gap: 0.5rem;
  min-width: 0;
}

.jui-avatar-upload__label {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-avatar-upload__row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.jui-avatar-upload__preview {
  width: var(--jui-avatar-upload-size, 96px);
  height: var(--jui-avatar-upload-size, 96px);
  padding: 0;
  overflow: hidden;
  border: 2px dashed var(--j-border);
  border-radius: 999px;
  background: var(--j-surface-2);
  cursor: pointer;
}

.jui-avatar-upload.has-initials .jui-avatar-upload__preview,
.jui-avatar-upload.has-photo .jui-avatar-upload__preview {
  border-style: solid;
  border-color: color-mix(in srgb, var(--j-primary) 35%, var(--j-border));
}

.jui-avatar-upload__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.jui-avatar-upload__placeholder,
.jui-avatar-upload__initials {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  font-weight: 800;
  line-height: 1;
}

.jui-avatar-upload__placeholder {
  color: var(--j-muted);
  font-size: 1.6rem;
}

.jui-avatar-upload__initials {
  color: #fff;
  background: linear-gradient(135deg, var(--j-primary), var(--j-leaf));
  font-size: calc(var(--jui-avatar-upload-size, 96px) * 0.32);
  letter-spacing: -0.02em;
}

.jui-avatar-upload__actions {
  display: inline-flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.jui-avatar-upload__btn {
  min-height: 2.35rem;
  padding: 0 0.9rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  background: var(--j-primary);
  color: #fff;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.jui-avatar-upload__btn--ghost {
  background: var(--j-surface);
  color: var(--j-muted);
}

.jui-avatar-upload__file {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.jui-avatar-upload.is-disabled {
  opacity: 0.65;
}

.jui-avatar-upload.has-error .jui-avatar-upload__preview {
  border-color: var(--j-danger);
}

.jui-avatar-upload__hint,
.jui-avatar-upload__error {
  font-size: 0.8rem;
}

.jui-avatar-upload__hint {
  color: var(--j-muted);
}

.jui-avatar-upload__error {
  color: var(--j-danger);
  font-weight: 600;
}
</style>
