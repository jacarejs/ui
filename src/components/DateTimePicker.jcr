import { effect, pulse, untrack } from '@jacare/core'
import DatePicker from './DatePicker.jcr'
import TimePicker from './TimePicker.jcr'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    value: { type: 'string', default: '', model: true }
    min: { type: 'string', default: '' }
    max: { type: 'string', default: '' }
    clearable: { type: 'boolean', default: true }
    disabled: { type: 'boolean', default: false }
    required: { type: 'boolean', default: false }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
  }
  emits: ['change']
</contract>

function read(value) {
  return typeof value === 'function' ? value() : value
}

function splitValue(value) {
  const raw = String(read(value) || '')
  const [datePart = '', timePart = ''] = raw.split('T')
  return {
    date: datePart,
    time: timePart ? timePart.slice(0, 8) : '',
  }
}

function composeValue(datePart, timePart) {
  if (!datePart) return ''
  return `${datePart}T${timePart || '00:00'}`
}

function commitValue(model, next, emitFn) {
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function dateBound(value) {
  return splitValue(value).date
}

function ensureParts(model, emitFn) {
  if (emitFn.__juiDateTime) return emitFn.__juiDateTime

  const initial = splitValue(model)
  const datePulse = pulse(initial.date)
  const timePulse = pulse(initial.time || '00:00')
  let syncing = false

  effect(() => {
    const next = splitValue(model)
    if (syncing) return
    syncing = true
    if (untrack(() => datePulse()) !== next.date) datePulse.set(next.date)
    if (next.time && untrack(() => timePulse()) !== next.time) timePulse.set(next.time)
    if (!next.date && !next.time && untrack(() => timePulse()) !== '00:00') timePulse.set('00:00')
    syncing = false
  })

  effect(() => {
    const datePart = datePulse()
    const timePart = timePulse()
    if (syncing) return
    const composed = composeValue(datePart, timePart)
    if (composed === untrack(() => read(model))) return
    syncing = true
    commitValue(model, composed, emitFn)
    syncing = false
  })

  emitFn.__juiDateTime = { datePulse, timePulse }
  return emitFn.__juiDateTime
}

function dateModel(model, emitFn) {
  return ensureParts(model, emitFn).datePulse
}

function timeModel(model, emitFn) {
  return ensureParts(model, emitFn).timePulse
}

function timeDisabled(model, disabledProp) {
  return !!read(disabledProp) || !dateBound(model)
}

export <view>
  <div class="jui-datetime" data-datetime class-has-error=${() => !!read(error)} class-is-disabled=${() => !!read(disabled)}>
    #if read(label)
      <span class="jui-datetime__label">
        ${() => read(label)}
        #if read(required)
          <span class="jui-datetime__req" aria-hidden="true">*</span>
        #end
      </span>
    #end

    <div class="jui-datetime__row">
      <div class="jui-datetime__date">
        <DatePicker
          :placeholder=${'Select date'}
          :min=${() => dateBound(min)}
          :max=${() => dateBound(max)}
          :clearable=${clearable}
          :required=${required}
          :disabled=${disabled}
          bind-value=${dateModel(value, emit)}
        />
      </div>
      <div class="jui-datetime__time">
        <TimePicker
          :placeholder=${'Select time'}
          :clearable=${clearable}
          :disabled=${() => timeDisabled(value, disabled)}
          bind-value=${timeModel(value, emit)}
        />
      </div>
    </div>

    #if read(error)
      <span class="jui-datetime__error" role="alert">${() => read(error)}</span>
    #elif read(hint)
      <span class="jui-datetime__hint">${() => read(hint)}</span>
    #end
  </div>
</view>

export <style>
.jui-datetime {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-datetime__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-datetime__req {
  color: var(--j-danger);
}

.jui-datetime.has-error .jui-datetime__label {
  color: var(--j-danger);
}

.jui-datetime.is-disabled {
  opacity: 0.65;
}

.jui-datetime__row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 0.65rem;
  min-width: 0;
}

.jui-datetime__date {
  flex: 1 1 14rem;
  min-width: min(100%, 12rem);
}

.jui-datetime__time {
  flex: 1 1 10rem;
  min-width: min(100%, 9rem);
}

.jui-datetime__date .jui-date,
.jui-datetime__time .jui-time-picker {
  width: 100%;
}

.jui-datetime__hint,
.jui-datetime__error {
  font-size: 0.8rem;
}

.jui-datetime__hint {
  color: var(--j-muted);
}

.jui-datetime__error {
  color: var(--j-danger);
  font-weight: 600;
}
</style>
