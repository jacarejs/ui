import { pulse } from '@jacare/core'
import Icon from './Icon.jcr'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', default: '' }
    icon: { type: 'string', default: '' }
    items: { type: 'any', default: [] }
    model: { type: 'any', default: null }
    variant: { type: 'string', default: '' }
    severity: { type: 'string', default: 'primary' }
    size: { type: 'string', default: 'md' }
    disabled: { type: 'boolean', default: false }
    fluid: { type: 'boolean', default: false }
    raised: { type: 'boolean', default: false }
    rounded: { type: 'boolean', default: false }
    outlined: { type: 'boolean', default: false }
    text: { type: 'boolean', default: false }
    menuButtonAriaLabel: { type: 'string', default: 'More options' }
  }
  slots: ['default']
  emits: ['click', 'press', 'select', 'show', 'hide']
</contract>

const BOOT_SRC = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'
const KNOWN_ICONS = new Set([
  'check', 'close', 'chevron-down', 'chevron-right', 'search', 'calendar',
  'alert', 'info', 'user', 'external-link', 'plus', 'minus', 'menu',
])

function openState(emitFn) {
  if (!emitFn.__juiSplitOpen) emitFn.__juiSplitOpen = pulse(false)
  return emitFn.__juiSplitOpen
}

function isOpen(emitFn) {
  return !!read(openState(emitFn))
}

function menuId(emitFn) {
  if (!emitFn.__juiSplitMenuId) {
    emitFn.__juiSplitMenuId = `jui-split-button-${Math.random().toString(36).slice(2, 9)}`
  }
  return emitFn.__juiSplitMenuId
}

function sizeOf(value) {
  const next = String(read(value) || 'md')
  if (next === 'sm' || next === 'small') return 'sm'
  if (next === 'lg' || next === 'large') return 'lg'
  return 'md'
}

function variantOf(variantProp, severityProp, outlinedProp, textProp) {
  if (read(outlinedProp)) return 'outline'
  if (read(textProp)) return 'ghost'
  const explicit = String(read(variantProp) || '').trim().toLowerCase()
  if (explicit) return explicit
  const severity = String(read(severityProp) || 'primary').trim().toLowerCase()
  if (severity === 'warning') return 'warn'
  if (severity === 'help') return 'info'
  if (severity === 'contrast') return 'secondary'
  if (['primary', 'secondary', 'success', 'info', 'warn', 'danger', 'ghost', 'outline'].includes(severity)) {
    return severity
  }
  return 'primary'
}

function sourceItems(itemsProp, modelProp) {
  const model = read(modelProp)
  if (Array.isArray(model)) return model
  const items = read(itemsProp)
  return Array.isArray(items) ? items : []
}

function normalizeItems(itemsProp, modelProp) {
  return sourceItems(itemsProp, modelProp)
    .map((item, index) => normalizeItem(item, index))
    .filter((item) => item.visible)
}

function normalizeItem(item, index) {
  if (item == null || typeof item !== 'object') {
    return {
      key: String(index),
      label: String(item ?? index),
      icon: '',
      disabled: false,
      visible: true,
      separator: false,
      command: null,
      items: [],
      raw: item,
    }
  }
  if (item.separator) {
    return {
      key: `sep-${index}`,
      label: '',
      icon: '',
      disabled: true,
      visible: true,
      separator: true,
      command: null,
      items: [],
      raw: item,
    }
  }
  const visible = typeof item.visible === 'function' ? !!item.visible() : item.visible !== false
  const children = Array.isArray(item.items)
    ? item.items.map((child, childIndex) => normalizeItem(child, `${index}-${childIndex}`)).filter((child) => child.visible)
    : []
  return {
    key: String(item.key ?? item.id ?? item.label ?? index),
    label: String(item.label ?? item.name ?? index),
    icon: String(item.icon || ''),
    disabled: !!item.disabled,
    visible,
    separator: false,
    command: typeof item.command === 'function' ? item.command : null,
    items: children,
    raw: item,
  }
}

function hasKnownIcon(icon) {
  return KNOWN_ICONS.has(String(icon || '').trim())
}

function setOpen(emitFn, next) {
  const open = !!next
  openState(emitFn).set(open)
  emitFn(open ? 'show' : 'hide')
}

function toggleMenu(event, emitFn, disabledProp) {
  event.preventDefault()
  event.stopPropagation()
  if (read(disabledProp)) return
  setOpen(emitFn, !isOpen(emitFn))
}

function closeMenu(emitFn) {
  if (!isOpen(emitFn)) return
  setOpen(emitFn, false)
}

function onDefaultClick(event, emitFn, disabledProp) {
  if (read(disabledProp)) {
    event.preventDefault()
    return
  }
  closeMenu(emitFn)
  emitFn('click', event)
  emitFn('press', event)
}

function onItemSelect(event, item, emitFn, disabledProp) {
  event.preventDefault()
  event.stopPropagation()
  if (read(disabledProp) || item.disabled || item.separator) return
  if (item.items.length) return
  if (item.command) item.command({ originalEvent: event, item: item.raw })
  emitFn('select', item.raw)
  closeMenu(emitFn)
}

function onMenuKeydown(event, root, emitFn) {
  const actions = [...root.querySelectorAll('[data-jui-split-action]:not(:disabled)')]
  const current = actions.indexOf(document.activeElement)
  switch (event.code) {
    case 'ArrowDown':
      event.preventDefault()
      focusAction(actions, current + 1)
      break
    case 'ArrowUp':
      event.preventDefault()
      focusAction(actions, current <= 0 ? actions.length - 1 : current - 1)
      break
    case 'Home':
      event.preventDefault()
      focusAction(actions, 0)
      break
    case 'End':
      event.preventDefault()
      focusAction(actions, actions.length - 1)
      break
    case 'Escape':
      event.preventDefault()
      closeMenu(emitFn)
      root.querySelector('.jui-split-button__dropdown')?.focus()
      break
    default:
      break
  }
}

function focusAction(actions, index) {
  if (!actions.length) return
  const next = ((index % actions.length) + actions.length) % actions.length
  actions[next]?.focus()
}

function onDropdownKeydown(event, emitFn, disabledProp) {
  if (read(disabledProp)) return
  if (event.code === 'ArrowDown' || event.code === 'ArrowUp' || event.code === 'Enter' || event.code === 'Space') {
    event.preventDefault()
    setOpen(emitFn, true)
    requestAnimationFrame(() => {
      const root = event.currentTarget.closest('[data-jui-split-button]')
      const first = root?.querySelector('[data-jui-split-action]:not(:disabled)')
      first?.focus()
    })
  }
  if (event.code === 'Escape') {
    event.preventDefault()
    closeMenu(emitFn)
  }
}

function armOutside(root, emitFn) {
  if (!root || root.__juiSplitArmed) return
  root.__juiSplitArmed = true
  const onDoc = (event) => {
    if (!isOpen(emitFn)) return
    if (root.contains(event.target)) return
    closeMenu(emitFn)
  }
  document.addEventListener('pointerdown', onDoc)
  root.__juiSplitDispose = () => document.removeEventListener('pointerdown', onDoc)
}

export <view>
  <div
    class="jui-split-button"
    class-jui-split-button--primary=${() => variantOf(variant, severity, outlined, text) === 'primary'}
    class-jui-split-button--secondary=${() => variantOf(variant, severity, outlined, text) === 'secondary'}
    class-jui-split-button--success=${() => variantOf(variant, severity, outlined, text) === 'success'}
    class-jui-split-button--info=${() => variantOf(variant, severity, outlined, text) === 'info'}
    class-jui-split-button--warn=${() => variantOf(variant, severity, outlined, text) === 'warn'}
    class-jui-split-button--danger=${() => variantOf(variant, severity, outlined, text) === 'danger'}
    class-jui-split-button--ghost=${() => variantOf(variant, severity, outlined, text) === 'ghost'}
    class-jui-split-button--outline=${() => variantOf(variant, severity, outlined, text) === 'outline'}
    class-jui-split-button--sm=${() => sizeOf(size) === 'sm'}
    class-jui-split-button--lg=${() => sizeOf(size) === 'lg'}
    class-is-fluid=${() => !!read(fluid)}
    class-is-raised=${() => !!read(raised)}
    class-is-rounded=${() => !!read(rounded)}
    class-is-open=${() => isOpen(emit)}
    class-is-disabled=${() => !!read(disabled)}
    data-jui-split-button
  >
    <img
      class="jui-split-button__boot"
      alt=""
      aria-hidden="true"
      src=${BOOT_SRC}
      on-load=${(event) => armOutside(event.currentTarget.closest('[data-jui-split-button]'), emit)}
    />

    <button
      type="button"
      class="jui-split-button__action"
      disabled=${() => !!read(disabled)}
      aria-label=${() => read(label) || undefined}
      on-click=${(event) => onDefaultClick(event, emit, disabled)}
    >
      #if hasKnownIcon(read(icon))
        <Icon :name=${() => read(icon)} :size=${() => (sizeOf(size) === 'sm' ? 'sm' : 'md')} :label=${''} />
      #end
      #if read(label)
        <span class="jui-split-button__label">${() => read(label)}</span>
      #else
        <span class="jui-split-button__label"><slot /></span>
      #end
    </button>

    <button
      type="button"
      class="jui-split-button__dropdown"
      disabled=${() => !!read(disabled)}
      aria-haspopup="menu"
      aria-expanded=${() => (isOpen(emit) ? 'true' : 'false')}
      aria-controls=${() => menuId(emit)}
      aria-label=${() => read(menuButtonAriaLabel) || 'More options'}
      on-click=${(event) => toggleMenu(event, emit, disabled)}
      on-keydown=${(event) => onDropdownKeydown(event, emit, disabled)}
    >
      <Icon :name=${'chevron-down'} :size=${'sm'} :label=${''} />
    </button>

    #if isOpen(emit)
      <ul
        class="jui-split-button__menu"
        id=${() => menuId(emit)}
        role="menu"
        tabindex="-1"
        on-keydown=${(event) => onMenuKeydown(event, event.currentTarget.closest('[data-jui-split-button]'), emit)}
      >
        #for normalizeItems(items, model) as item (item.key)
          #if item.separator
            <li class="jui-split-button__separator" role="separator"></li>
          #elif item.items.length
            <li class="jui-split-button__item jui-split-button__item--group" role="none">
              <div class="jui-split-button__group-label">
                #if hasKnownIcon(item.icon)
                  <Icon :name=${item.icon} :size=${'sm'} :label=${''} />
                #end
                <span>${item.label}</span>
              </div>
              <ul class="jui-split-button__submenu" role="group">
                #for item.items as child (child.key)
                  <li class="jui-split-button__item" role="none">
                    <button
                      type="button"
                      class="jui-split-button__menuitem"
                      data-jui-split-action
                      role="menuitem"
                      disabled=${() => !!(read(disabled) || child.disabled)}
                      on-click=${(event) => onItemSelect(event, child, emit, disabled)}
                    >
                      #if hasKnownIcon(child.icon)
                        <Icon :name=${child.icon} :size=${'sm'} :label=${''} />
                      #end
                      <span>${child.label}</span>
                    </button>
                  </li>
                #end
              </ul>
            </li>
          #else
            <li class="jui-split-button__item" role="none">
              <button
                type="button"
                class="jui-split-button__menuitem"
                data-jui-split-action
                role="menuitem"
                disabled=${() => !!(read(disabled) || item.disabled)}
                on-click=${(event) => onItemSelect(event, item, emit, disabled)}
              >
                #if hasKnownIcon(item.icon)
                  <Icon :name=${item.icon} :size=${'sm'} :label=${''} />
                #end
                <span>${item.label}</span>
              </button>
            </li>
          #end
        #end
      </ul>
    #end
  </div>
</view>

export <style>
.jui-split-button {
  --jui-split-bg: var(--j-primary);
  --jui-split-fg: #ffffff;
  --jui-split-border: transparent;
  --jui-split-hover: var(--j-leaf);
  --jui-split-shadow: 0 8px 24px rgba(24, 144, 48, 0.22);
  --jui-split-radius: var(--j-radius-pill);
  position: relative;
  display: inline-flex;
  align-items: stretch;
  min-width: 0;
  border-radius: var(--jui-split-radius);
}

.jui-split-button__boot {
  position: absolute;
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
}

.jui-split-button.is-fluid {
  display: flex;
  width: 100%;
}

.jui-split-button.is-fluid .jui-split-button__action {
  flex: 1 1 auto;
}

.jui-split-button.is-rounded {
  --jui-split-radius: var(--j-radius, 0.65rem);
}

.jui-split-button.is-raised {
  box-shadow: var(--jui-split-shadow);
}

.jui-split-button--secondary {
  --jui-split-bg: var(--j-surface);
  --jui-split-fg: var(--j-forest);
  --jui-split-border: var(--j-border);
  --jui-split-hover: var(--j-mint);
  --jui-split-shadow: none;
}

.jui-split-button--success {
  --jui-split-bg: var(--j-success, var(--j-primary));
  --jui-split-hover: color-mix(in srgb, var(--j-success, var(--j-primary)) 82%, #000);
}

.jui-split-button--info {
  --jui-split-bg: var(--j-info, #1f6feb);
  --jui-split-hover: color-mix(in srgb, var(--j-info, #1f6feb) 82%, #000);
  --jui-split-shadow: 0 8px 24px rgba(31, 111, 235, 0.22);
}

.jui-split-button--warn {
  --jui-split-bg: var(--j-warn);
  --jui-split-fg: #1c1200;
  --jui-split-hover: color-mix(in srgb, var(--j-warn) 84%, #000);
  --jui-split-shadow: 0 8px 24px rgba(196, 122, 0, 0.22);
}

.jui-split-button--danger {
  --jui-split-bg: var(--j-danger);
  --jui-split-hover: color-mix(in srgb, var(--j-danger) 82%, #000);
  --jui-split-shadow: 0 8px 24px rgba(198, 40, 40, 0.22);
}

.jui-split-button--ghost {
  --jui-split-bg: transparent;
  --jui-split-fg: var(--j-forest);
  --jui-split-border: transparent;
  --jui-split-hover: rgba(24, 144, 48, 0.08);
  --jui-split-shadow: none;
}

.jui-split-button--outline {
  --jui-split-bg: transparent;
  --jui-split-fg: var(--j-primary);
  --jui-split-border: color-mix(in srgb, var(--j-primary) 55%, transparent);
  --jui-split-hover: color-mix(in srgb, var(--j-primary) 10%, transparent);
  --jui-split-shadow: none;
}

.jui-split-button__action,
.jui-split-button__dropdown {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  min-height: var(--j-control-height, 2.5rem);
  margin: 0;
  border: 1px solid var(--jui-split-border);
  background: var(--jui-split-bg);
  color: var(--jui-split-fg);
  font: inherit;
  font-weight: 700;
  line-height: 1.2;
  cursor: pointer;
  transition:
    background var(--j-duration-fast, 120ms) ease,
    box-shadow var(--j-duration-fast, 120ms) ease,
    transform var(--j-duration-fast, 120ms) ease;
}

.jui-split-button__action {
  padding: 0.65rem 1.1rem;
  border-radius: var(--jui-split-radius) 0 0 var(--jui-split-radius);
  border-inline-end: 0;
}

.jui-split-button__dropdown {
  width: 2.6rem;
  padding: 0;
  border-radius: 0 var(--jui-split-radius) var(--jui-split-radius) 0;
  border-inline-start: 1px solid color-mix(in srgb, var(--jui-split-fg) 22%, transparent);
}

.jui-split-button--sm .jui-split-button__action,
.jui-split-button--sm .jui-split-button__dropdown {
  min-height: 2rem;
  font-size: 0.875rem;
}

.jui-split-button--sm .jui-split-button__action {
  padding: 0.4rem 0.85rem;
}

.jui-split-button--sm .jui-split-button__dropdown {
  width: 2.1rem;
}

.jui-split-button--lg .jui-split-button__action,
.jui-split-button--lg .jui-split-button__dropdown {
  min-height: 3rem;
  font-size: 1.05rem;
}

.jui-split-button--lg .jui-split-button__action {
  padding: 0.85rem 1.35rem;
}

.jui-split-button--lg .jui-split-button__dropdown {
  width: 3rem;
}

.jui-split-button__action:hover:not(:disabled),
.jui-split-button__dropdown:hover:not(:disabled) {
  background: var(--jui-split-hover);
}

.jui-split-button__action:focus-visible,
.jui-split-button__dropdown:focus-visible {
  outline: none;
  z-index: 1;
  box-shadow: var(--j-focus);
}

.jui-split-button.is-disabled,
.jui-split-button__action:disabled,
.jui-split-button__dropdown:disabled {
  opacity: 0.62;
  cursor: not-allowed;
  box-shadow: none;
}

.jui-split-button__label {
  white-space: nowrap;
}

.jui-split-button__menu {
  position: absolute;
  top: calc(100% + 0.35rem);
  left: 0;
  z-index: 40;
  min-width: 100%;
  margin: 0;
  padding: 0.35rem;
  list-style: none;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius);
  background: var(--j-surface-2, var(--j-surface));
  box-shadow: var(--j-shadow-sm);
}

.jui-split-button__item {
  margin: 0;
  padding: 0;
  list-style: none;
}

.jui-split-button__separator {
  height: 0;
  margin: 0.35rem 0;
  border: 0;
  border-top: 1px solid var(--j-border);
}

.jui-split-button__menuitem {
  appearance: none;
  display: flex;
  align-items: center;
  gap: 0.45rem;
  width: 100%;
  min-height: 2.1rem;
  padding: 0.4rem 0.7rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  background: transparent;
  color: var(--j-text);
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.jui-split-button__menuitem:hover:not(:disabled),
.jui-split-button__menuitem:focus-visible {
  background: color-mix(in srgb, var(--j-primary) 10%, transparent);
  color: var(--j-primary);
  outline: none;
}

.jui-split-button__menuitem:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.jui-split-button__group-label {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 0.7rem 0.2rem;
  color: var(--j-muted);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.jui-split-button__submenu {
  margin: 0;
  padding: 0 0 0.2rem;
  list-style: none;
}

.jui-split-button__submenu .jui-split-button__menuitem {
  padding-left: 1.35rem;
}
</style>
