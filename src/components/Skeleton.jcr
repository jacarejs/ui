import { read } from '../internal/utils.js'
import SkeletonItem from './SkeletonItem.jcr'

export <contract>
  props: {
    animated: { type: 'boolean', default: false }
    loading: { type: 'boolean', default: true }
    rows: { type: 'number', default: 3 }
    count: { type: 'number', default: 1 }
    avatar: { type: 'boolean', default: false }
    size: { type: 'string', default: 'md' }
  }
  slots: ['default']
</contract>

function countOf(value) {
  const next = Number(read(value))
  return Number.isFinite(next) && next > 0 ? Math.round(next) : 1
}

function rowsOf(value) {
  const next = Number(read(value))
  return Number.isFinite(next) && next > 0 ? Math.round(next) : 3
}

function sizeOf(value) {
  const next = String(read(value) || 'md')
  if (next === 'sm' || next === 'lg') return next
  return 'md'
}

function blockIndices(countProp) {
  return Array.from({ length: countOf(countProp) }, (item, index) => index)
}

function rowIndices(rowsProp) {
  return Array.from({ length: rowsOf(rowsProp) }, (item, index) => index)
}

function rowWidth(index, rowsProp) {
  const total = rowsOf(rowsProp)
  if (index === total - 1) return '62%'
  if (index % 3 === 1) return '88%'
  return '100%'
}

function rowStyle(index, rowsProp) {
  return `width:${rowWidth(index, rowsProp)}`
}

export <view>
  #if read(loading)
    <div
      class="jui-skeleton"
      class-jui-skeleton--animated=${() => !!read(animated)}
      class-jui-skeleton--avatar=${() => !!read(avatar)}
      class-jui-skeleton--sm=${() => sizeOf(size) === 'sm'}
      class-jui-skeleton--lg=${() => sizeOf(size) === 'lg'}
      aria-busy="true"
      aria-live="polite"
    >
      #for blockIndices(count) as block (block)
        <div class="jui-skeleton__block">
          #if read(avatar)
            <SkeletonItem variant="circle" :size=${size} :animated=${animated} />
            <div class="jui-skeleton__lines">
              #for rowIndices(rows) as row (row)
                <div class="jui-skeleton__row" :style=${() => rowStyle(row, rows)}>
                  <SkeletonItem variant="text" :size=${size} :animated=${animated} />
                </div>
              #end
            </div>
          #else
            #for rowIndices(rows) as row (row)
              <div class="jui-skeleton__row" :style=${() => rowStyle(row, rows)}>
                <SkeletonItem variant="text" :size=${size} :animated=${animated} />
              </div>
            #end
          #end
        </div>
      #end
    </div>
  #else
    <slot />
  #end
</view>

export <style>
.jui-skeleton {
  display: grid;
  gap: 1.25rem;
}

.jui-skeleton--sm {
  gap: 0.9rem;
}

.jui-skeleton--lg {
  gap: 1.5rem;
}

.jui-skeleton__block {
  display: grid;
  gap: 0.65rem;
  min-width: 0;
}

.jui-skeleton--avatar .jui-skeleton__block {
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
  gap: 0.85rem;
}

.jui-skeleton--sm.jui-skeleton--avatar .jui-skeleton__block {
  gap: 0.65rem;
}

.jui-skeleton--lg.jui-skeleton--avatar .jui-skeleton__block {
  gap: 1rem;
}

.jui-skeleton__lines {
  display: grid;
  gap: 0.55rem;
  min-width: 0;
  padding-top: 0.15rem;
}

.jui-skeleton--sm .jui-skeleton__lines {
  gap: 0.4rem;
}

.jui-skeleton--lg .jui-skeleton__lines {
  gap: 0.7rem;
}

.jui-skeleton__row {
  min-width: 0;
}
</style>
