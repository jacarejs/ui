import ChartFrame from './ChartFrame.jcr'
import ChartPlot from './ChartPlot.jcr'
import { read } from '../internal/utils.js'
import {
  cartesianModel,
  chartLayoutWidth,
  colorAt,
  escapeXml,
  extent,
  formatNumber,
  niceTicks,
  resolveChartWidth,
  scaleLinear,
  sizeOf,
} from '../internal/charts.js'

export <contract>
  props: {
    data: { type: 'any', required: true }
    title: { type: 'string', default: '' }
    caption: { type: 'string', default: '' }
    width: { type: 'number', default: 480 }
    height: { type: 'number', default: 300 }
    colors: { type: 'any', default: null }
    showLegend: { type: 'boolean', default: true }
  }
  emits: ['layout']
</contract>

function model(dataProp, colorsProp, widthProp, heightProp) {
  const { width, height } = sizeOf(widthProp, heightProp, 480, 300)
  const pad = { top: 20, right: 20, bottom: 28, left: 88 }
  const base = cartesianModel(dataProp)
  const serie = base.series[0] || { name: 'Series', data: [], color: '' }
  const color = serie.color || colorAt(0, colorsProp)
  const values = serie.data
  const xDomain = extent(values, 0.05)
  if (xDomain.min > 0) xDomain.min = 0
  const ticks = niceTicks(xDomain.min, xDomain.max, 4)
  const plotH = height - pad.top - pad.bottom
  const rowH = plotH / Math.max(base.categories.length, 1)
  const barH = rowH * 0.55
  const xScale = scaleLinear(xDomain.min, xDomain.max, pad.left, width - pad.right)
  const zero = xScale(0)
  const bars = base.categories.map((label, index) => {
    const value = values[index] ?? 0
    const x1 = xScale(value)
    return {
      key: `${label}-${index}`,
      label,
      y: pad.top + index * rowH + (rowH - barH) / 2,
      x: Math.min(zero, x1),
      width: Math.max(1, Math.abs(x1 - zero)),
      height: barH,
      title: `${label}: ${formatNumber(value)}`,
      labelY: pad.top + index * rowH + rowH / 2,
    }
  })
  return {
    width,
    height,
    pad,
    bars,
    color,
    ticks: ticks.map((tick) => ({ value: tick, x: xScale(tick), label: formatNumber(tick) })),
    legend: [{ key: serie.name, name: serie.name, color }],
  }
}

function plotContent(dataProp, colorsProp, widthProp, heightProp) {
  const next = model(dataProp, colorsProp, widthProp, heightProp)
  const parts = []
  for (const tick of next.ticks) {
    parts.push(
      `<line x1="${tick.x}" x2="${tick.x}" y1="${next.pad.top}" y2="${next.height - next.pad.bottom}" stroke="color-mix(in srgb, var(--j-border) 70%, transparent)" stroke-width="1" />`,
    )
    parts.push(
      `<text x="${tick.x}" y="${next.height - 10}" text-anchor="middle" fill="var(--j-muted)" font-size="11">${escapeXml(tick.label)}</text>`,
    )
  }
  for (const bar of next.bars) {
    parts.push(
      `<text x="${next.pad.left - 8}" y="${bar.labelY}" text-anchor="end" dominant-baseline="middle" fill="var(--j-muted)" font-size="11">${escapeXml(bar.label)}</text>`,
    )
    parts.push(
      `<rect x="${bar.x}" y="${bar.y}" width="${bar.width}" height="${bar.height}" rx="4" fill="${escapeXml(next.color)}" data-jui-tip="${escapeXml(bar.title)}" />`,
    )
  }
  return parts.join('')
}

export <view>
  <ChartFrame
    :title=${title}
    :caption=${caption}
    :width=${() => resolveChartWidth(width, emit)}
    :height=${height}
    :legend=${() =>
      read(showLegend) ? model(data, colors, resolveChartWidth(width, emit), height).legend : []}
  >
    <ChartPlot
      bind-layoutWidth=${chartLayoutWidth(emit)}
      :width=${() => resolveChartWidth(width, emit)}
      :height=${() => model(data, colors, resolveChartWidth(width, emit), height).height}
      :label=${() => read(title) || 'Bar chart'}
      :content=${() => plotContent(data, colors, resolveChartWidth(width, emit), height)}
    />
  </ChartFrame>
</view>
