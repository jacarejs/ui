import { effect, pulse } from '@jacare/core'
import Select from './Select.jcr'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    value: { type: 'any', default: '', model: true }
    min: { type: 'string', default: '' }
    max: { type: 'string', default: '' }
    disabled: { type: 'boolean', default: false }
    border: { type: 'boolean', default: true }
    range: { type: 'boolean', default: false }
    multiple: { type: 'boolean', default: false }
  }
  emits: ['change']
</contract>

const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
const monthOptions = months.map((label, index) => ({ label, value: String(index) }))
const BOOT_SRC = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'

function parseDate(value) {
  const parts = String(value || '').split('-').map(Number)
  if (parts.length !== 3 || parts.some((part) => !Number.isFinite(part))) return null
  const date = new Date(parts[0], parts[1] - 1, parts[2])
  return Number.isNaN(date.getTime()) ? null : date
}

function formatValue(date) {
  const pad = (value) => String(value).padStart(2, '0')
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`
}

function isAllowed(value, minimum, maximum) {
  return (!minimum || value >= minimum) && (!maximum || value <= maximum)
}

function isRangeMode(root) {
  return !!read(root.panelRange)
}

function isMultipleMode(root) {
  return !isRangeMode(root) && !!read(root.panelMultiple)
}

function normalizeSelection(raw, root) {
  if (isRangeMode(root) || isMultipleMode(root)) {
    if (Array.isArray(raw)) return raw.map((item) => String(item || '')).filter(Boolean)
    const single = String(raw || '')
    return single ? [single] : []
  }
  return String(raw || '')
}

function selectionList(root) {
  const current = normalizeSelection(read(root.panelModel), root)
  return Array.isArray(current) ? current : current ? [current] : []
}

function commitValue(model, next, emitFn) {
  if (model && typeof model.set === 'function') model.set(next)
  emitFn('change', next)
}

function viewControls(emitFn) {
  if (!emitFn.__juiPanelView) {
    const now = new Date()
    emitFn.__juiPanelView = {
      month: pulse(String(now.getMonth())),
      year: pulse(String(now.getFullYear())),
    }
  }
  return emitFn.__juiPanelView
}

function yearOptionsFor(minimum, maximum, currentYear) {
  const year = Number(currentYear) || new Date().getFullYear()
  const minimumYear = parseDate(read(minimum))?.getFullYear() ?? year - 100
  const maximumYear = parseDate(read(maximum))?.getFullYear() ?? year + 20
  const years = []
  for (let optionYear = maximumYear; optionYear >= minimumYear; optionYear -= 1) {
    years.push({ label: String(optionYear), value: String(optionYear) })
  }
  return years
}

function viewState(root) {
  if (!root.panelView) {
    const initial = parseDate(root.dataset.initial) || new Date()
    root.panelView = new Date(initial.getFullYear(), initial.getMonth(), 1)
  }
  return root.panelView
}

function syncViewControls(root) {
  const emitFn = root?.panelEmit
  if (!emitFn) return
  const view = viewState(root)
  const controls = viewControls(emitFn)
  controls.month.set(String(view.getMonth()))
  controls.year.set(String(view.getFullYear()))
}

function setView(root, year, month) {
  root.panelView = new Date(year, month, 1)
  syncViewControls(root)
  renderPanel(root)
}

function changeMonth(root, amount) {
  const view = viewState(root)
  setView(root, view.getFullYear(), view.getMonth() + amount)
}

function handleMonthChange(next, emitFn) {
  const root = emitFn.__juiPanelRoot
  if (next === '' || next == null) {
    syncViewControls(root)
    return
  }
  if (!root) return
  setView(root, viewState(root).getFullYear(), Number(next))
}

function handleYearChange(next, emitFn) {
  const root = emitFn.__juiPanelRoot
  if (next === '' || next == null) {
    syncViewControls(root)
    return
  }
  if (!root) return
  setView(root, Number(next), viewState(root).getMonth())
}

function selectDate(root, model, minimum, maximum, emitFn, value) {
  if (read(root.panelDisabled) || !isAllowed(value, minimum, maximum)) return

  if (isRangeMode(root)) {
    const draft = root.panelDraft || []
    if (!draft.length || draft.length === 2) {
      root.panelDraft = [value]
    } else {
      root.panelDraft = value < draft[0] ? [value, draft[0]] : [draft[0], value]
    }
    if (root.panelDraft.length === 2) {
      commitValue(model, [...root.panelDraft], emitFn)
    }
    renderPanel(root)
    return
  }

  if (isMultipleMode(root)) {
    const current = selectionList(root)
    const next = current.includes(value)
      ? current.filter((item) => item !== value)
      : [...current, value].sort()
    commitValue(model, next, emitFn)
    renderPanel(root)
    return
  }

  commitValue(model, value, emitFn)
  renderPanel(root)
}

function selectToday(root, model, minimum, maximum, emitFn) {
  const today = formatValue(new Date())
  selectDate(root, model, minimum, maximum, emitFn, today)
}

function clearSelection(root, model, emitFn) {
  if (read(root.panelDisabled)) return
  root.panelDraft = []
  if (isRangeMode(root) || isMultipleMode(root)) commitValue(model, [], emitFn)
  else commitValue(model, '', emitFn)
  renderPanel(root)
}

function selectedForRender(root) {
  if (isRangeMode(root)) {
    if (root.panelDraft?.length) return root.panelDraft
    return selectionList(root)
  }
  return selectionList(root)
}

function renderPanel(root) {
  if (!root?.isConnected) return
  const model = root.panelModel
  const minimum = read(root.panelMin)
  const maximum = read(root.panelMax)
  const locked = !!read(root.panelDisabled)
  const view = viewState(root)
  const year = view.getFullYear()
  const month = view.getMonth()
  const grid = root.querySelector('[data-panel-days]')
  if (!grid) return

  const firstDay = new Date(year, month, 1)
  const offset = (firstDay.getDay() + 6) % 7
  const start = new Date(year, month, 1 - offset)
  const today = formatValue(new Date())
  const selected = selectedForRender(root)
  const rangeMode = isRangeMode(root)
  const buttons = []

  for (let index = 0; index < 42; index += 1) {
    const date = new Date(start)
    date.setDate(start.getDate() + index)
    const dateValue = formatValue(date)
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'jui-date-panel__day'
    button.textContent = String(date.getDate())
    button.classList.toggle('is-outside', date.getMonth() !== month)
    button.classList.toggle('is-today', dateValue === today)
    button.classList.toggle('is-selected', selected.includes(dateValue))
    button.classList.toggle('is-range-start', rangeMode && selected[0] === dateValue)
    button.classList.toggle('is-range-end', rangeMode && selected[1] === dateValue)
    button.classList.toggle(
      'is-in-range',
      rangeMode && selected.length === 2 && dateValue > selected[0] && dateValue < selected[1],
    )
    button.disabled = locked || !isAllowed(dateValue, minimum, maximum)
    button.setAttribute('aria-label', new Intl.DateTimeFormat('en-US', { dateStyle: 'full' }).format(date))
    button.addEventListener('click', () => selectDate(root, model, minimum, maximum, root.panelEmit, dateValue))
    buttons.push(button)
  }

  grid.replaceChildren(...buttons)

  const hint = root.querySelector('[data-panel-hint]')
  if (hint) {
    if (rangeMode) {
      hint.hidden = false
      hint.textContent = selected.length === 1 ? 'Select an end date.' : 'Select a start and end date.'
    } else if (isMultipleMode(root)) {
      hint.hidden = false
      hint.textContent = selected.length
        ? `${selected.length} date${selected.length === 1 ? '' : 's'} selected.`
        : 'Tap days to select multiple dates.'
    } else {
      hint.hidden = true
    }
  }

  const clearBtn = root.querySelector('[data-panel-clear]')
  if (clearBtn) {
    clearBtn.hidden = !(rangeMode || isMultipleMode(root)) || selected.length === 0
  }
}

function initialIso(model, rangeProp, multipleProp) {
  const raw = read(model)
  if (read(rangeProp) || read(multipleProp)) {
    if (Array.isArray(raw) && raw[0]) return String(raw[0])
    return ''
  }
  return String(raw || '')
}

function armPanel(root, model, minimum, maximum, disabledProp, rangeProp, multipleProp, emitFn) {
  if (!root || root.panelArmed) return
  root.panelArmed = true
  root.panelModel = model
  root.panelMin = minimum
  root.panelMax = maximum
  root.panelDisabled = disabledProp
  root.panelRange = rangeProp
  root.panelMultiple = multipleProp
  root.panelEmit = emitFn
  emitFn.__juiPanelRoot = root
  root.dataset.initial = initialIso(model, rangeProp, multipleProp)
  const current = normalizeSelection(read(model), root)
  root.panelDraft = Array.isArray(current) ? [...current] : []
  syncViewControls(root)
  root.panelDispose = effect(() => {
    read(model)
    read(minimum)
    read(maximum)
    read(disabledProp)
    read(rangeProp)
    read(multipleProp)
    const next = normalizeSelection(read(model), root)
    if (isRangeMode(root)) {
      if (Array.isArray(next) && next.length === 2) root.panelDraft = [...next]
      else if (Array.isArray(next) && next.length === 0) root.panelDraft = []
    }
    renderPanel(root)
  })
}

export <view>
  <div
    class="jui-date-panel"
    class-jui-date-panel--bordered=${() => !!read(border)}
    class-jui-date-panel--range=${() => !!read(range)}
    class-jui-date-panel--multiple=${() => !!read(multiple) && !read(range)}
    class-is-disabled=${() => !!read(disabled)}
  >
    <img
      class="jui-date-panel__boot"
      alt=""
      width="0"
      height="0"
      aria-hidden="true"
      src=${BOOT_SRC}
      on-load=${(event) =>
        armPanel(event.currentTarget.closest('.jui-date-panel'), value, min, max, disabled, range, multiple, emit)}
    />

    <div class="jui-date-panel__head">
      <button type="button" class="jui-date-panel__nav" aria-label="Previous month" disabled=${() => !!read(disabled)} on-click=${(event) => changeMonth(event.currentTarget.closest('.jui-date-panel'), -1)}>‹</button>
      <Select
        :options=${monthOptions}
        :searchable=${false}
        :placeholder=${'Month'}
        :disabled=${disabled}
        bind-value=${viewControls(emit).month}
        on-change=${(next) => handleMonthChange(next, emit)}
      />
      <Select
        :options=${() => yearOptionsFor(min, max, viewControls(emit).year())}
        :searchable=${true}
        :placeholder=${'Year'}
        :disabled=${disabled}
        bind-value=${viewControls(emit).year}
        on-change=${(next) => handleYearChange(next, emit)}
      />
      <button type="button" class="jui-date-panel__nav" aria-label="Next month" disabled=${() => !!read(disabled)} on-click=${(event) => changeMonth(event.currentTarget.closest('.jui-date-panel'), 1)}>›</button>
    </div>

    <div class="jui-date-panel__weekdays" aria-hidden="true">
      #for weekdays as weekday (weekday)
        <span>${weekday}</span>
      #end
    </div>

    <div class="jui-date-panel__days" data-panel-days></div>

    <p class="jui-date-panel__hint" data-panel-hint hidden></p>

    <div class="jui-date-panel__actions">
      <button
        type="button"
        class="jui-date-panel__text-btn"
        data-panel-clear
        hidden
        disabled=${() => !!read(disabled)}
        on-click=${(event) => clearSelection(event.currentTarget.closest('.jui-date-panel'), value, emit)}
      >Clear</button>
      <button type="button" class="jui-date-panel__text-btn" disabled=${() => !!read(disabled)} on-click=${(event) => selectToday(event.currentTarget.closest('.jui-date-panel'), value, read(min), read(max), emit)}>Today</button>
    </div>
  </div>
</view>

export <style>
.jui-date-panel {
  position: relative;
  display: grid;
  gap: 0.7rem;
  width: min(22rem, 100%);
  padding: 0.8rem;
  border-radius: var(--j-radius);
  color: var(--j-text);
  background: var(--j-surface-2);
}

.jui-date-panel__boot {
  position: absolute;
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
}

.jui-date-panel--bordered {
  border: 1px solid var(--j-border);
  box-shadow: var(--j-shadow-sm);
}

.jui-date-panel.is-disabled {
  opacity: 0.65;
}

.jui-date-panel__head {
  display: grid;
  grid-template-columns: 2.2rem minmax(0, 1.4fr) minmax(0, 1fr) 2.2rem;
  align-items: center;
  gap: 0.35rem;
}

.jui-date-panel__head .jui-select {
  min-width: 0;
}

.jui-date-panel__head .jui-select__trigger {
  min-height: 2.2rem;
  padding: 0.35rem 0.65rem;
  font-size: 0.78rem;
  font-weight: 800;
  line-height: 1.2;
}

.jui-date-panel__head .jui-select__chevron {
  width: 0.75rem;
  height: 0.75rem;
}

.jui-date-panel__head .jui-select__panel {
  z-index: 90;
}

.jui-date-panel__head .jui-select__list {
  max-height: 12rem;
}

.jui-date-panel__nav {
  width: 2.2rem;
  height: 2.2rem;
  padding: 0;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-primary);
  background: var(--j-mint);
  cursor: pointer;
  font-size: 1.4rem;
}

.jui-date-panel__nav:hover:not(:disabled) {
  background: var(--j-lime);
}

.jui-date-panel__nav:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.jui-date-panel__weekdays,
.jui-date-panel__days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.jui-date-panel__weekdays {
  color: var(--j-muted);
  font-size: 0.65rem;
  font-weight: 850;
  text-align: center;
  text-transform: uppercase;
}

.jui-date-panel__weekdays span {
  padding: 0.3rem 0;
}

.jui-date-panel__day {
  position: relative;
  aspect-ratio: 1;
  padding: 0;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-text);
  background: transparent;
  cursor: pointer;
  font-size: 0.78rem;
  font-weight: 700;
}

.jui-date-panel__day:hover:not(:disabled) {
  background: var(--j-surface);
}

.jui-date-panel__day.is-outside {
  color: var(--j-muted);
  opacity: 0.6;
}

.jui-date-panel__day.is-today:not(.is-selected) {
  color: var(--j-primary);
  box-shadow: inset 0 0 0 1.5px var(--j-primary);
  background: color-mix(in srgb, var(--j-primary) 10%, transparent);
}

.jui-date-panel__day.is-today.is-outside:not(.is-selected) {
  color: var(--j-primary);
  opacity: 0.85;
}

.jui-date-panel__day.is-in-range {
  border-radius: 0;
  color: var(--j-forest);
  background: var(--j-mint);
}

.jui-date-panel__day.is-selected,
.jui-date-panel__day.is-selected:hover:not(:disabled) {
  color: var(--j-on-primary, #ffffff);
  background: var(--j-primary);
  box-shadow: none;
}

.jui-date-panel__day.is-selected.is-in-range,
.jui-date-panel__day.is-selected.is-in-range:hover:not(:disabled) {
  color: var(--j-on-primary, #ffffff);
  background: var(--j-primary);
}

.jui-date-panel__day.is-range-start {
  border-radius: var(--j-radius-sm) 0 0 var(--j-radius-sm);
}

.jui-date-panel__day.is-range-end {
  border-radius: 0 var(--j-radius-sm) var(--j-radius-sm) 0;
}

.jui-date-panel__day:disabled {
  color: var(--j-border);
  cursor: not-allowed;
  text-decoration: line-through;
}

.jui-date-panel__hint {
  margin: 0;
  color: var(--j-muted);
  font-size: 0.75rem;
  font-weight: 650;
}

.jui-date-panel__hint[hidden] {
  display: none;
}

.jui-date-panel__actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.35rem;
  padding-top: 0.55rem;
  border-top: 1px solid var(--j-border);
}

.jui-date-panel__text-btn {
  min-height: 2.1rem;
  padding: 0.45rem 0.7rem;
  border: 0;
  border-radius: var(--j-radius-sm);
  color: var(--j-primary);
  background: transparent;
  cursor: pointer;
  font-size: 0.72rem;
  font-weight: 850;
}

.jui-date-panel__text-btn[hidden] {
  display: none;
}

.jui-date-panel__text-btn:hover:not(:disabled) {
  background: var(--j-mint);
}

.jui-date-panel__text-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (pointer: coarse) {
  .jui-date-panel__day {
    min-height: var(--j-touch-target, 2.75rem);
  }

  .jui-date-panel__nav,
  .jui-date-panel__text-btn {
    min-width: var(--j-touch-target, 2.75rem);
    min-height: var(--j-touch-target, 2.75rem);
  }
}
</style>
