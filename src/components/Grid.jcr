import { read } from '../internal/utils.js'

export <contract>
  props: {
    columns: { type: 'string', default: '2' }
    gap: { type: 'string', default: 'md' }
    align: { type: 'string', default: 'stretch' }
    justify: { type: 'string', default: 'stretch' }
    dense: { type: 'boolean', default: false }
  }
  slots: ['default']
</contract>

function columnsOf(value) {
  const next = String(read(value) || '2')
  if (
    next === '1' ||
    next === '2' ||
    next === '3' ||
    next === '4' ||
    next === '6' ||
    next === '12' ||
    next === 'auto'
  ) {
    return next
  }
  return '2'
}

function gapOf(value) {
  const next = read(value)
  if (next === 'none' || next === 'sm' || next === 'lg' || next === 'xl') return next
  return 'md'
}

function alignOf(value) {
  const next = read(value)
  if (next === 'start' || next === 'center' || next === 'end') return next
  return 'stretch'
}

function justifyOf(value) {
  const next = read(value)
  if (next === 'start' || next === 'center' || next === 'end' || next === 'between') return next
  return 'stretch'
}

export <view>
  <div
    class="jui-grid"
    class-jui-grid--cols-1=${() => columnsOf(columns) === '1'}
    class-jui-grid--cols-2=${() => columnsOf(columns) === '2'}
    class-jui-grid--cols-3=${() => columnsOf(columns) === '3'}
    class-jui-grid--cols-4=${() => columnsOf(columns) === '4'}
    class-jui-grid--cols-6=${() => columnsOf(columns) === '6'}
    class-jui-grid--cols-12=${() => columnsOf(columns) === '12'}
    class-jui-grid--cols-auto=${() => columnsOf(columns) === 'auto'}
    class-jui-grid--gap-none=${() => gapOf(gap) === 'none'}
    class-jui-grid--gap-sm=${() => gapOf(gap) === 'sm'}
    class-jui-grid--gap-lg=${() => gapOf(gap) === 'lg'}
    class-jui-grid--gap-xl=${() => gapOf(gap) === 'xl'}
    class-jui-grid--align-start=${() => alignOf(align) === 'start'}
    class-jui-grid--align-center=${() => alignOf(align) === 'center'}
    class-jui-grid--align-end=${() => alignOf(align) === 'end'}
    class-jui-grid--justify-start=${() => justifyOf(justify) === 'start'}
    class-jui-grid--justify-center=${() => justifyOf(justify) === 'center'}
    class-jui-grid--justify-end=${() => justifyOf(justify) === 'end'}
    class-jui-grid--justify-between=${() => justifyOf(justify) === 'between'}
    class-jui-grid--dense=${() => !!read(dense)}
  >
    <slot />
  </div>
</view>

export <style>
.jui-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--j-space-4);
  align-items: stretch;
  justify-items: stretch;
  min-width: 0;
  min-height: 0;
}

.jui-grid > span {
  display: contents;
}

.jui-grid--cols-1 { grid-template-columns: minmax(0, 1fr); }
.jui-grid--cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.jui-grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.jui-grid--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.jui-grid--cols-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.jui-grid--cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }
.jui-grid--cols-auto {
  grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
}

.jui-grid--gap-none { gap: 0; }
.jui-grid--gap-sm { gap: var(--j-space-2); }
.jui-grid--gap-lg { gap: var(--j-space-5); }
.jui-grid--gap-xl { gap: var(--j-space-6); }

.jui-grid--align-start { align-items: start; }
.jui-grid--align-center { align-items: center; }
.jui-grid--align-end { align-items: end; }

.jui-grid--justify-start { justify-items: start; }
.jui-grid--justify-center { justify-items: center; }
.jui-grid--justify-end { justify-items: end; }
.jui-grid--justify-between { justify-content: space-between; }

.jui-grid--dense { grid-auto-flow: dense; }
</style>
