import { effect } from '@jacare/core'
import { read } from '../internal/utils.js'

export <contract>
  props: {
    label: { type: 'string', required: true }
    value: { type: 'string', model: true }
    placeholder: { type: 'string', default: '' }
    hint: { type: 'string', default: '' }
    error: { type: 'string', default: '' }
    disabled: { type: 'boolean', default: false }
    required: { type: 'boolean', default: false }
    rows: { type: 'number', default: 4 }
    maxRows: { type: 'number', default: 0 }
    maxLength: { type: 'number', default: 0 }
    showCount: { type: 'boolean', default: false }
    autosize: { type: 'boolean', default: false }
    resize: { type: 'string', default: 'vertical' }
    name: { type: 'string', default: '' }
  }
</contract>

const BOOT_SRC = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'

function rowCount(value) {
  const next = Number(read(value))
  if (!Number.isFinite(next) || next < 2) return 4
  return Math.min(24, Math.round(next))
}

function maxRowCount(value, minRows) {
  const next = Number(read(value))
  if (!Number.isFinite(next) || next <= 0) return 0
  return Math.max(minRows, Math.min(48, Math.round(next)))
}

function maxChars(value) {
  const next = Number(read(value))
  if (!Number.isFinite(next) || next <= 0) return 0
  return Math.round(next)
}

function resizeMode(value) {
  const next = read(value)
  if (next === 'none' || next === 'both' || next === 'horizontal' || next === 'vertical') return next
  return 'vertical'
}

function resolvedResize(resize, autosizeProp) {
  if (read(autosizeProp)) return 'none'
  return resizeMode(resize)
}

function currentLength(model) {
  return String(read(model) ?? '').length
}

function countLabel(model, maxValue) {
  const length = currentLength(model)
  const max = maxChars(maxValue)
  return max > 0 ? `${length} / ${max}` : String(length)
}

function lineMetrics(textarea) {
  const style = getComputedStyle(textarea)
  let lineHeight = parseFloat(style.lineHeight)
  if (!Number.isFinite(lineHeight)) {
    const fontSize = parseFloat(style.fontSize) || 16
    lineHeight = fontSize * 1.45
  }
  const padding =
    (parseFloat(style.paddingTop) || 0) + (parseFloat(style.paddingBottom) || 0)
  const border =
    (parseFloat(style.borderTopWidth) || 0) + (parseFloat(style.borderBottomWidth) || 0)
  return { lineHeight, padding, border }
}

function applyAutosize(textarea, rowsProp, maxRowsProp) {
  if (!textarea) return
  const minRows = rowCount(rowsProp)
  const max = maxRowCount(maxRowsProp, minRows)
  const { lineHeight, padding, border } = lineMetrics(textarea)
  const minH = minRows * lineHeight + padding + border

  textarea.style.height = '0px'
  const scrollH = textarea.scrollHeight
  let next = Math.max(minH, scrollH)

  if (max > 0) {
    const maxH = max * lineHeight + padding + border
    if (scrollH > maxH) {
      next = maxH
      textarea.style.overflowY = 'auto'
    } else {
      textarea.style.overflowY = 'hidden'
    }
  } else {
    textarea.style.overflowY = 'hidden'
  }

  textarea.style.height = `${next}px`
}

function clearAutosize(textarea) {
  if (!textarea) return
  textarea.style.height = ''
  textarea.style.overflowY = ''
}

function armAutosize(root, value, rowsProp, maxRowsProp, autosizeProp) {
  if (!root || root.juiTextareaAutosizeDispose) return
  root.juiTextareaAutosizeDispose = effect(() => {
    const enabled = !!read(autosizeProp)
    const textarea = root.querySelector('textarea.jui-textarea__control')
    read(value)
    read(rowsProp)
    read(maxRowsProp)
    requestAnimationFrame(() => {
      if (!enabled) {
        clearAutosize(textarea)
        return
      }
      applyAutosize(textarea, rowsProp, maxRowsProp)
    })
  })
}

function onTextareaInput(event, rowsProp, maxRowsProp, autosizeProp) {
  if (!read(autosizeProp)) return
  applyAutosize(event.currentTarget, rowsProp, maxRowsProp)
}

export <view>
  <label
    class="jui-textarea"
    class-has-error=${() => !!read(error)}
    class-is-disabled=${() => !!read(disabled)}
    class-is-autosize=${() => !!read(autosize)}
    data-jui-textarea
  >
    <img
      class="jui-textarea__boot"
      alt=""
      width="0"
      height="0"
      aria-hidden="true"
      src=${BOOT_SRC}
      on-load=${(event) =>
        armAutosize(
          event.currentTarget.closest('[data-jui-textarea]'),
          value,
          rows,
          maxRows,
          autosize,
        )}
    />
    <span class="jui-textarea__label">
      ${() => read(label)}
      #if read(required)
        <span class="jui-textarea__req" aria-hidden="true">*</span>
      #end
    </span>
    <textarea
      class="jui-textarea__control"
      class-jui-textarea__control--autosize=${() => !!read(autosize)}
      class-jui-textarea__control--resize-none=${() => resolvedResize(resize, autosize) === 'none'}
      class-jui-textarea__control--resize-both=${() => resolvedResize(resize, autosize) === 'both'}
      class-jui-textarea__control--resize-horizontal=${() => resolvedResize(resize, autosize) === 'horizontal'}
      class-jui-textarea__control--resize-vertical=${() => resolvedResize(resize, autosize) === 'vertical'}
      name=${() => read(name) || ''}
      rows=${() => rowCount(rows)}
      placeholder=${() => read(placeholder) || ''}
      disabled=${() => !!read(disabled)}
      required=${() => !!read(required)}
      maxlength=${() => {
        const max = maxChars(maxLength)
        return max > 0 ? max : undefined
      }}
      aria-invalid=${() => !!read(error)}
      bind-value=${value}
      on-input=${(event) => onTextareaInput(event, rows, maxRows, autosize)}
    ></textarea>
    <span class="jui-textarea__meta">
      #if read(error)
        <span class="jui-textarea__error" role="alert">${() => read(error)}</span>
      #elif read(hint)
        <span class="jui-textarea__hint">${() => read(hint)}</span>
      #else
        <span class="jui-textarea__hint"></span>
      #end
      #if read(showCount)
        <span class="jui-textarea__count">${() => countLabel(value, maxLength)}</span>
      #end
    </span>
  </label>
</view>

export <style>
.jui-textarea {
  display: grid;
  gap: 0.4rem;
  min-width: 0;
}

.jui-textarea__boot {
  position: absolute;
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
}

.jui-textarea__label {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--j-forest);
}

.jui-textarea__req {
  color: var(--j-danger);
}

.jui-textarea__control {
  width: 100%;
  min-height: 6.5rem;
  padding: 0.75rem 0.9rem;
  border: 1px solid var(--j-border);
  border-radius: var(--j-radius-sm);
  background: var(--j-surface-2);
  color: var(--j-text);
  font: inherit;
  line-height: 1.45;
  transition: border-color 120ms ease, box-shadow 120ms ease;
}

.jui-textarea__control--autosize {
  min-height: 0;
  overflow-x: hidden;
  resize: none;
  field-sizing: content;
}

.jui-textarea__control::placeholder {
  color: color-mix(in srgb, var(--j-muted) 75%, white);
}

.jui-textarea__control:focus {
  border-color: var(--j-primary);
  box-shadow: var(--j-focus);
  outline: none;
}

.jui-textarea__control--resize-none {
  resize: none;
}

.jui-textarea__control--resize-both {
  resize: both;
}

.jui-textarea__control--resize-horizontal {
  resize: horizontal;
}

.jui-textarea__control--resize-vertical {
  resize: vertical;
}

.jui-textarea.has-error .jui-textarea__control {
  border-color: var(--j-danger);
}

.jui-textarea.is-disabled {
  opacity: 0.65;
}

.jui-textarea__meta {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 0.75rem;
  min-height: 1.1rem;
}

.jui-textarea__hint,
.jui-textarea__error,
.jui-textarea__count {
  font-size: 0.8rem;
}

.jui-textarea__hint {
  color: var(--j-muted);
}

.jui-textarea__error {
  color: var(--j-danger);
  font-weight: 600;
}

.jui-textarea__count {
  flex: 0 0 auto;
  color: var(--j-muted);
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}
</style>
