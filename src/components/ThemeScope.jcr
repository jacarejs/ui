import { read } from '../internal/utils.js'

export <contract>
  props: {
    mode: { type: 'string', default: 'system' }
  }
  slots: ['default']
</contract>

function scopeAttr(value) {
  const next = read(value)
  if (next === 'light' || next === 'dark') return next
  return undefined
}

export <view>
  <div class="jui-theme-scope" data-j-theme=${scopeAttr(mode)}>
    <slot />
  </div>
</view>

export <style>
.jui-theme-scope {
  color: var(--j-fg, var(--j-text));
  background: var(--j-bg, var(--j-surface));
}
</style>
