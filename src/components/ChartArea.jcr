import ChartFrame from './ChartFrame.jcr'
import ChartPlot from './ChartPlot.jcr'
import { read } from '../internal/utils.js'
import {
  areaPath,
  cartesianModel,
  chartLayoutWidth,
  colorAt,
  escapeXml,
  extent,
  formatNumber,
  linePath,
  niceTicks,
  padOf,
  resolveChartWidth,
  scaleLinear,
  sizeOf,
  stackedSeries,
} from '../internal/charts.js'

export <contract>
  props: {
    data: { type: 'any', required: true }
    title: { type: 'string', default: '' }
    caption: { type: 'string', default: '' }
    width: { type: 'number', default: 480 }
    height: { type: 'number', default: 280 }
    colors: { type: 'any', default: null }
    stacked: { type: 'boolean', default: false }
    showLegend: { type: 'boolean', default: true }
  }
  emits: ['layout']
</contract>

function model(dataProp, colorsProp, widthProp, heightProp, stackedProp) {
  const { width, height } = sizeOf(widthProp, heightProp, 480, 280)
  const pad = padOf(null)
  const base = cartesianModel(dataProp)
  const isStacked = !!read(stackedProp)
  const series = isStacked
    ? stackedSeries(base, colorsProp)
    : base.series.map((serie, index) => ({
      ...serie,
      color: serie.color || colorAt(index, colorsProp),
      points: base.categories.map((_, pointIndex) => ({
        xIndex: pointIndex,
        y0: 0,
        y1: serie.data[pointIndex] ?? 0,
        value: serie.data[pointIndex] ?? 0,
      })),
    }))
  const values = series.flatMap((serie) => serie.points.map((point) => point.y1))
  const yDomain = extent(values, 0.05)
  if (yDomain.min > 0) yDomain.min = 0
  const ticks = niceTicks(yDomain.min, yDomain.max, 4)
  const xScale = scaleLinear(0, Math.max(base.categories.length - 1, 1), pad.left, width - pad.right)
  const yScale = scaleLinear(yDomain.min, yDomain.max, height - pad.bottom, pad.top)
  const areas = series.map((serie) => {
    const top = serie.points.map((point) => ({ x: xScale(point.xIndex), y: yScale(point.y1) }))
    const bottom = [...serie.points]
      .reverse()
      .map((point) => ({ x: xScale(point.xIndex), y: yScale(point.y0) }))
    return {
      ...serie,
      path: `${linePath(top)} ${bottom.length ? `L ${bottom.map((point) => `${point.x} ${point.y}`).join(' L ')} Z` : areaPath(top, yScale(0))}`,
      strokePath: linePath(top),
    }
  })
  return {
    width,
    height,
    pad,
    areas,
    ticks: ticks.map((tick) => ({ value: tick, y: yScale(tick), label: formatNumber(tick) })),
    xLabels: base.categories.map((label, index) => ({ label, x: xScale(index) })),
    legend: areas,
  }
}

function plotContent(dataProp, colorsProp, widthProp, heightProp, stackedProp) {
  const next = model(dataProp, colorsProp, widthProp, heightProp, stackedProp)
  const parts = []
  for (const tick of next.ticks) {
    parts.push(
      `<line x1="${next.pad.left}" x2="${next.width - next.pad.right}" y1="${tick.y}" y2="${tick.y}" stroke="color-mix(in srgb, var(--j-border) 70%, transparent)" stroke-width="1" />`,
    )
    parts.push(
      `<text x="${next.pad.left - 8}" y="${tick.y}" text-anchor="end" dominant-baseline="middle" fill="var(--j-muted)" font-size="11">${escapeXml(tick.label)}</text>`,
    )
  }
  for (const area of next.areas) {
    parts.push(
      `<path d="${escapeXml(area.path)}" fill="${escapeXml(area.color)}" opacity="0.28" />`,
    )
    parts.push(
      `<path d="${escapeXml(area.strokePath)}" fill="none" stroke="${escapeXml(area.color)}" stroke-width="2" />`,
    )
  }
  for (const item of next.xLabels) {
    parts.push(
      `<text x="${item.x}" y="${next.height - 12}" text-anchor="middle" fill="var(--j-muted)" font-size="11">${escapeXml(item.label)}</text>`,
    )
  }
  return parts.join('')
}

export <view>
  <ChartFrame
    :title=${title}
    :caption=${caption}
    :width=${() => resolveChartWidth(width, emit)}
    :height=${height}
    :legend=${() =>
      read(showLegend) ? model(data, colors, resolveChartWidth(width, emit), height, stacked).legend : []}
  >
    <ChartPlot
      bind-layoutWidth=${chartLayoutWidth(emit)}
      :width=${() => resolveChartWidth(width, emit)}
      :height=${() => model(data, colors, resolveChartWidth(width, emit), height, stacked).height}
      :label=${() => read(title) || 'Area chart'}
      :content=${() => plotContent(data, colors, resolveChartWidth(width, emit), height, stacked)}
    />
  </ChartFrame>
</view>
