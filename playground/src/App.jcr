import { pulse, derive } from '@jacare/core'
import Alert from '@jacare/ui/components/Alert.jcr'
import Avatar from '@jacare/ui/components/Avatar.jcr'
import Badge from '@jacare/ui/components/Badge.jcr'
import Button from '@jacare/ui/components/Button.jcr'
import Card from '@jacare/ui/components/Card.jcr'
import Checkbox from '@jacare/ui/components/Checkbox.jcr'
import Divider from '@jacare/ui/components/Divider.jcr'
import Field from '@jacare/ui/components/Field.jcr'
import Progress from '@jacare/ui/components/Progress.jcr'
import Spinner from '@jacare/ui/components/Spinner.jcr'
import Stack from '@jacare/ui/components/Stack.jcr'
import Switch from '@jacare/ui/components/Switch.jcr'
import Text from '@jacare/ui/components/Text.jcr'

const name = pulse('')
const email = pulse('')
const newsletter = pulse(true)
const darkMode = pulse(false)
const loading = pulse(false)
const progress = pulse(42)
const clicks = pulse(0)

const emailError = derive(() => {
  const value = email().trim()
  if (!value) return ''
  return value.includes('@') ? '' : 'Enter a valid email'
})

const greeting = derive(() => {
  const value = name().trim()
  return value ? `Welcome, ${value}` : 'Official UI kit for Jacaré'
})

function bump() {
  clicks.update((n) => n + 1)
  progress.update((n) => Math.min(100, n + 8))
}

function toggleLoading() {
  loading.update((v) => !v)
}

function resetForm() {
  name.set('')
  email.set('')
  newsletter.set(true)
  progress.set(42)
  clicks.set(0)
  loading.set(false)
}

export <view>
  <main class="page">
    <header class="hero">
      <div class="hero-copy">
        <Badge :text=${'@jacare/ui'} :tone=${'success'} :soft=${true} />
        <Text :as=${'h1'}>Build faster with Jacaré UI</Text>
        <Text :tone=${'muted'}>${greeting}</Text>
      </div>
      <Avatar :name=${'Jacaré UI'} :size=${'lg'} />
    </header>

    <Stack :gap=${'lg'}>
      <Card :title=${'Actions'} :subtitle=${'Buttons, badges, and feedback'}>
        <Stack :direction=${'row'} :gap=${'sm'} :wrap=${true} :align=${'center'}>
          <Button :variant=${'primary'} on-press=${bump}>Primary</Button>
          <Button :variant=${'secondary'} on-press=${bump}>Secondary</Button>
          <Button :variant=${'ghost'} on-press=${bump}>Ghost</Button>
          <Button :variant=${'danger'} on-press=${resetForm}>Reset</Button>
          <Button :loading=${loading} on-press=${toggleLoading}>Toggle loading</Button>
          <Badge :text=${() => `${clicks()} clicks`} :tone=${'info'} :soft=${true} />
          <Spinner :size=${'sm'} />
        </Stack>
      </Card>

      <Card :title=${'Form controls'} :subtitle=${'Two-way model props with pulses'}>
        <Stack :gap=${'md'}>
          <Field
            :label=${'Name'}
            bind-value=${name}
            :placeholder=${'Heber Almeida'}
            :hint=${'Shown in the hero greeting'}
          />
          <Field
            :label=${'Email'}
            :type=${'email'}
            bind-value=${email}
            :placeholder=${'you@jacare.dev'}
            :error=${emailError}
            :required=${true}
          />
          <Stack :direction=${'row'} :gap=${'lg'} :wrap=${true} :align=${'center'}>
            <Checkbox :label=${'Subscribe to release notes'} bind-checked=${newsletter} />
            <Switch :label=${'Compact density'} bind-checked=${darkMode} />
          </Stack>
        </Stack>
      </Card>

      <Card :title=${'Progress'} :subtitle=${'Signal-driven meters'}>
        <Stack :gap=${'md'}>
          <Progress :label=${'Upload'} :value=${progress} :max=${100} />
          <Alert :tone=${'success'} :title=${'Ready for apps'}>
            Import any component with <code>import Button from '@jacare/ui/Button'</code>.
          </Alert>
        </Stack>
      </Card>

      <Divider :label=${'Layout primitives'} />

      <Card>
        <Stack :direction=${'row'} :gap=${'sm'} :wrap=${true} :align=${'center'}>
          <Text :as=${'h3'}>Stack · Divider · Text</Text>
          <Badge :text=${'layout'} :soft=${true} />
        </Stack>
        <Text :tone=${'muted'} :size=${'sm'}>
          Compose screens with signal-aware primitives — no virtual DOM, no runtime PropTypes.
        </Text>
      </Card>
    </Stack>
  </main>
</view>

export <style>
.page {
  width: min(52rem, 100%);
  margin: 0 auto;
  padding: clamp(1rem, 4vw, 2.5rem) clamp(0.85rem, 3vw, 1.25rem) clamp(2.5rem, 8vw, 4rem);
  display: grid;
  gap: clamp(1rem, 3vw, 1.5rem);
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: clamp(1rem, 3vw, 1.35rem) clamp(1rem, 3vw, 1.4rem);
  border: 1px solid var(--j-border);
  border-radius: calc(var(--j-radius) + 6px);
  background: color-mix(in srgb, var(--j-surface-2, #fff) 92%, transparent);
  box-shadow: var(--j-shadow);
}

.hero-copy {
  display: grid;
  gap: 0.55rem;
  min-width: 0;
}

code {
  font-family: var(--j-font-mono);
  font-size: 0.86em;
  word-break: break-word;
}

@media (max-width: 640px) {
  .hero {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero .jui-avatar {
    align-self: flex-end;
  }
}
</style>
